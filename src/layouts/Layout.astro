---
import { getLangFromUrl, alternatePath, type Lang } from "../i18n/content";
import HumanChallenge from "../components/HumanChallenge.astro";
import GlobalTrustCaptcha from "../components/GlobalTrustCaptcha.tsx";
import "../styles/global.css";

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Absolute URL or site-relative path (e.g. /og-image.png). Defaults to /og-image.png */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** If true, page is excluded from indexing */
  noindex?: boolean;
  type?: "website" | "article";
  breadcrumbs?: Breadcrumb[];
  /** Extra JSON-LD graph nodes to merge */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og-image.png",
  imageAlt: rawImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  type = "website",
  breadcrumbs,
  jsonLd,
} = Astro.props;

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const imageAlt = rawImageAlt ?? (lang === "it" ? "Ventic — LLM privati su GPU dedicate" : "Ventic — Private LLMs on dedicated GPUs");
const turnstileSitekey = (import.meta.env.PUBLIC_TURNSTILE_SITEKEY as string | undefined) || undefined;
const trustSitekey = (import.meta.env.PUBLIC_TRUSTCAPTCHA_SITEKEY as string | undefined) || undefined;

const site = (Astro.site ?? new URL("https://ventic.it")).toString().replace(/\/$/, "");
// Normalize pathname to ensure canonical consistency: directory URLs end with /
const rawPath = Astro.url.pathname;
// If path looks like a file (contains .), keep as-is; otherwise ensure trailing slash
const path = rawPath.endsWith("/") || rawPath.includes(".") ? rawPath : `${rawPath}/`;
const canonical = `${site}${path}`;

// Build absolute alternates (normalized with trailing slash)
function absAlt(target: Lang) {
  const p = alternatePath(rawPath, target);
  const normalized = p.endsWith("/") || p.includes(".") ? p : `${p}/`;
  return `${site}${normalized}`;
}
const itHref = absAlt("it");
const enHref = absAlt("en");

// Absolute image URL
const imageUrl = image.startsWith("http") ? image : `${site}${image.startsWith("/") ? image : `/${image}`}`;
const ogLocale = lang === "it" ? "it_IT" : "en_GB";
const ogLocaleAlt = lang === "it" ? "en_GB" : "it_IT";

// Auto breadcrumbs if not provided
function autoBreadcrumbs(): Breadcrumb[] {
  if (breadcrumbs) return breadcrumbs;
  const isEn = lang === "en";
  const base = isEn ? "/en/" : "/";
  if (path === "/" || path === "/en/") return [{ name: "Home", href: base }];
  if (path.includes("/pricing")) {
    return [
      { name: "Home", href: base },
      { name: isEn ? "Pricing" : "Prezzi", href: isEn ? "/en/pricing/" : "/pricing/" },
    ];
  }
  if (path.includes("/admin-panel")) {
    return [
      { name: "Home", href: base },
      { name: isEn ? "Admin Panel" : "Pannello", href: isEn ? "/en/admin-panel/" : "/admin-panel/" },
    ];
  }
  // generic: split path
  const parts = path.replace(/^\/en\//, "/").split("/").filter(Boolean);
  const crumbs: Breadcrumb[] = [{ name: "Home", href: base }];
  let acc = isEn ? "/en" : "";
  for (const p of parts) {
    acc += `/${p}`;
    crumbs.push({ name: p.replace(/-/g, " "), href: `${acc}/` });
  }
  return crumbs;
}

const crumbs = autoBreadcrumbs();

// JSON-LD @graph
const organization = {
  "@type": "Organization",
  "@id": `${site}/#organization`,
  name: "Ventic",
  legalName: "Netter srl",
  url: site,
  logo: {
    "@type": "ImageObject",
    url: `${site}/ventic-logo-outlined.svg`,
    width: 600,
    height: 120,
  },
  image: imageUrl,
  description:
    lang === "it"
      ? "LLM privati su GPU dedicate — endpoint OpenAI/Anthropic compatibile, dati in UE o US, vLLM ottimizzato."
      : "Private LLMs on dedicated GPUs — OpenAI/Anthropic-compatible endpoint, data in EU or US, tuned vLLM.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Indipendenza",
    addressLocality: "Assisi",
    addressRegion: "PG",
    postalCode: "06081",
    addressCountry: "IT",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    availableLanguage: ["it", "en"],
    url: `${site}/#contatto`,
  },
  sameAs: ["https://ventic.it"],
};

const website = {
  "@type": "WebSite",
  "@id": `${site}/#website`,
  url: site,
  name: "Ventic",
  alternateName: "Ventic — LLM privati",
  description,
  publisher: { "@id": `${site}/#organization` },
  inLanguage: ogLocale,
};

const webpage = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": `${site}/#website` },
  about: { "@id": `${site}/#organization` },
  inLanguage: ogLocale,
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: imageUrl,
  },
  breadcrumb: { "@id": `${canonical}#breadcrumb` },
};

const breadcrumbList = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.href.startsWith("http") ? c.href : `${site}${c.href}`,
  })),
};

const graph: Record<string, unknown>[] = [organization, website, webpage, breadcrumbList];

if (jsonLd) {
  if (Array.isArray(jsonLd)) graph.push(...jsonLd);
  else graph.push(jsonLd);
}

const jsonLdString = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Netter srl" />
    <meta name="publisher" content="Ventic" />
    <meta name="format-detection" content="telephone=no" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
      <meta name="googlebot" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    {/* Canonical & hreflang */}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={itHref} />

    {/* Sitemap discovery */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Icons & manifest */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e0f11" />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Ventic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Preconnect for performance */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />

    {/* JSON-LD */}
    <script type="application/ld+json" set:html={jsonLdString} />
  </head>
  <body>
    <slot />
    {/* Global Human Challenge — TrustCaptcha (preferito) o fallback — visibile solo su click mailto */}
    {trustSitekey ? (
      <div id="ventic-trust-layer" style="position:fixed;right:16px;bottom:16px;z-index:9999;display:none;">
        <GlobalTrustCaptcha sitekey={trustSitekey} lang={lang} client:only="react" />
      </div>
    ) : (
      <div id="ventic-human-layer" style="position:fixed;right:16px;bottom:16px;z-index:9999;display:none;">
        <HumanChallenge lang={lang} sitekey={turnstileSitekey} />
      </div>
    )}
    <script is:inline define:vars={{ trustSitekey }}>
      (() => {
        // Email protetta — decodificata solo dopo verifica TrustCaptcha
        const ENCODED = "=QXauMWa05WZ2B0bm5Wa";
        const useTrustCaptcha = Boolean(trustSitekey);
        const decode = (s) => {
          try { const rev = s.split("").reverse().join(""); return atob(rev); }
          catch { try { return atob(s); } catch { return ""; } }
        };
        const getEmail = () => decode(ENCODED);
        let humanVerified = false;
        let pendingTarget = null;
        const isBotSignal = () => {
          try {
            if (navigator.webdriver) return true;
            if (/HeadlessChrome|PhantomJS|bot|crawler|spider/i.test(navigator.userAgent)) return true;
            return false;
          } catch { return false; }
        };

        const markVerified = (provider = "js-challenge") => {
          if (humanVerified) return;
          if (isBotSignal()) return;
          humanVerified = true;
          window.__venticHumanVerified = true;
          const email = getEmail();
          if (!email) return;
          const layer = document.getElementById("ventic-human-layer");
          const trustLayer = document.getElementById("ventic-trust-layer");
          const widget = document.querySelector("[data-cf-widget]");
          if (widget) {
            widget.dataset.verified = "1";
            const msg = widget.querySelector(".cf-msg");
            if (msg) msg.textContent = document.documentElement.lang === "en" ? "Verified ✓ — email unlocked" : "Verifica completata ✓ — email sbloccata";
          }
          // sblocca tutte le email — solo ora la mail appare nel DOM
          document.querySelectorAll("a.obf-email").forEach((el) => {
            if (el.dataset.decoded === "1") return;
            const prefix = el.getAttribute("data-prefix") || "";
            const label = el.getAttribute("data-label");
            el.setAttribute("href", "mailto:" + email);
            if (!label) el.textContent = prefix + email;
            // per i bottoni con label manteniamo il testo label, ma href diventa mailto
            el.dataset.decoded = "1";
            el.classList.add("is-verified");
          });
          window.dispatchEvent(new CustomEvent("ventic:humanVerified", {detail:{provider, email}}));
          if (pendingTarget) {
            // pendingTarget è già stato sbloccato sopra, apri mailto
            const targetHref = pendingTarget.getAttribute("href");
            if (targetHref && targetHref.startsWith("mailto:")) {
              setTimeout(() => { window.location.href = targetHref; }, 300);
            } else if (pendingTarget.getAttribute("data-label")) {
              // bottone con label: href ora è mailto
              setTimeout(() => { window.location.href = "mailto:" + email; }, 300);
            }
            pendingTarget = null;
          }
          if (layer) setTimeout(() => { layer.style.display = "none"; }, 1800);
          if (trustLayer && useTrustCaptcha) setTimeout(() => { trustLayer.style.opacity = "0.9"; }, 800);
        };

        const scrollToTrust = () => {
          const trustLayer = document.getElementById("ventic-trust-layer");
          if (trustLayer) {
            trustLayer.style.display = "block";
            trustLayer.scrollIntoView({behavior:"smooth", block:"center"});
            trustLayer.style.outline = "2px solid #f5a83f";
            setTimeout(() => { trustLayer.style.outline = "none"; }, 1500);
          }
        };

        const onEmailActivate = (e) => {
          const el = e.currentTarget;
          if (el.dataset.decoded === "1") return; // già sbloccata → mailto normale
          e.preventDefault();
          if (humanVerified) {
            // già verificato ma el non ancora sbloccata (caso race)
            const email = getEmail();
            const prefix = el.getAttribute("data-prefix") || "";
            const label = el.getAttribute("data-label");
            el.setAttribute("href", "mailto:" + email);
            if (!label) el.textContent = prefix + email;
            el.dataset.decoded = "1";
            window.location.href = "mailto:" + email;
            return;
          }
          // verifica parte SOLO su click del bottone mailto
          pendingTarget = el;
          if (useTrustCaptcha) {
            scrollToTrust();
            const gate = document.querySelector("[data-trustcaptcha-gate]");
            if (gate) {
              gate.style.transform = "scale(1.02)";
              setTimeout(() => gate.style.transform = "", 300);
            }
            return; // attende solve TrustCaptcha → evento ventic:humanVerified → markVerified
          }
          // fallback mock: mostra widget e verifica dopo breve challenge
          const layer = document.getElementById("ventic-human-layer");
          if (layer) layer.style.display = "block";
          const widget = document.querySelector("[data-cf-widget]");
          if (widget) {
            const msg = widget.querySelector(".cf-msg");
            if (msg) msg.textContent = document.documentElement.lang === "en" ? "Verifying you are human…" : "Verifica che sei umano…";
          }
          setTimeout(() => markVerified("click-challenge"), 700);
        };

        const initEmails = () => {
          document.querySelectorAll("a.obf-email").forEach((el) => {
            el.addEventListener("click", onEmailActivate);
            el.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") onEmailActivate(e);
            });
          });
        };

        const boot = () => {
          initEmails();
          // TrustCaptcha / Turnstile dispatchano ventic:humanVerified → sblocca
          window.addEventListener("ventic:humanVerified", (e) => {
            if (!humanVerified) markVerified(e.detail?.provider || "trustcaptcha");
          });
          // nessun invisible challenge: verifica solo su click mailto
        };

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
        else boot();
        window.__venticVerifyHuman = markVerified;
      })();
    </script>
  </body>
</html>
