---
import { getLangFromUrl, alternatePath, type Lang } from "../i18n/content";
import LocaleRedirect from "../components/LocaleRedirect.astro";
import ChatLauncher from "../components/ChatLauncher.astro";
import "../styles/global.css";

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Absolute URL or site-relative path (e.g. /og-image.png). Defaults to /og-image.png */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** If true, page is excluded from indexing */
  noindex?: boolean;
  /** If true, skip browser-language auto-redirect (e.g. 404 page) */
  noLocaleRedirect?: boolean;
  type?: "website" | "article";
  breadcrumbs?: Breadcrumb[];
  /** Extra JSON-LD graph nodes to merge */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/og-image.png",
  imageAlt: rawImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  noLocaleRedirect = false,
  type = "website",
  breadcrumbs,
  jsonLd,
} = Astro.props;

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const imageAlt = rawImageAlt ?? (lang === "it" ? "Ventic — piattaforma AI multi-tenant on premise" : "Ventic — on-premise multi-tenant AI platform");

const site = (Astro.site ?? new URL("https://ventic.it")).toString().replace(/\/$/, "");
// Normalize pathname to ensure canonical consistency: directory URLs end with /
const rawPath = Astro.url.pathname;
// If path looks like a file (contains .), keep as-is; otherwise ensure trailing slash
const path = rawPath.endsWith("/") || rawPath.includes(".") ? rawPath : `${rawPath}/`;
const canonical = `${site}${path}`;

// Build absolute alternates (normalized with trailing slash)
function absAlt(target: Lang) {
  const p = alternatePath(rawPath, target);
  const normalized = p.endsWith("/") || p.includes(".") ? p : `${p}/`;
  return `${site}${normalized}`;
}
const itHref = absAlt("it");
const enHref = absAlt("en");

// Absolute image URL
const imageUrl = image.startsWith("http") ? image : `${site}${image.startsWith("/") ? image : `/${image}`}`;
const ogLocale = lang === "it" ? "it_IT" : "en_GB";
const ogLocaleAlt = lang === "it" ? "en_GB" : "it_IT";

// Auto breadcrumbs if not provided
function autoBreadcrumbs(): Breadcrumb[] {
  if (breadcrumbs) return breadcrumbs;
  const isEn = lang === "en";
  const base = isEn ? "/en/" : "/";
  if (path === "/" || path === "/en/") return [{ name: "Home", href: base }];
  if (path.includes("/pricing")) {
    return [
      { name: "Home", href: base },
      { name: isEn ? "Pricing" : "Prezzi", href: isEn ? "/en/pricing/" : "/pricing/" },
    ];
  }
  if (path.includes("/admin-panel")) {
    return [
      { name: "Home", href: base },
      { name: isEn ? "Admin Panel" : "Pannello", href: isEn ? "/en/admin-panel/" : "/admin-panel/" },
    ];
  }
  const sub = [
    ["why-ventic", "Why Ventic", "Perché Ventic"],
    ["how-it-works", "How it works", "Come funziona"],
    ["platform", "Platform", "Piattaforma"],
    ["on-premise", "On-premise", "On-premise"],
  ].find(([slug]) => path.includes(`/${slug}/`));
  if (sub) {
    return [
      { name: "Home", href: base },
      { name: isEn ? sub[1] : sub[2], href: `${base}${sub[0]}/` },
    ];
  }
  if (path.includes("/privacy")) {
    return [
      { name: "Home", href: base },
      { name: "Privacy", href: isEn ? "/en/privacy/" : "/privacy/" },
    ];
  }
  if (path.includes("/termini") || path.includes("/terms")) {
    return [
      { name: "Home", href: base },
      { name: isEn ? "Terms" : "Termini", href: isEn ? "/en/termini/" : "/termini/" },
    ];
  }
  // generic: split path
  const parts = path.replace(/^\/en\//, "/").split("/").filter(Boolean);
  const crumbs: Breadcrumb[] = [{ name: "Home", href: base }];
  let acc = isEn ? "/en" : "";
  for (const p of parts) {
    acc += `/${p}`;
    crumbs.push({ name: p.replace(/-/g, " "), href: `${acc}/` });
  }
  return crumbs;
}

const crumbs = autoBreadcrumbs();

// JSON-LD @graph
const organization = {
  "@type": "Organization",
  "@id": `${site}/#organization`,
  name: "Ventic",
  legalName: "Netter srl",
  url: site,
  logo: {
    "@type": "ImageObject",
    url: `${site}/ventic-logo-outlined.svg`,
    width: 600,
    height: 120,
  },
  image: imageUrl,
  description:
    lang === "it"
      ? "Piattaforma AI multi-tenant per Kubernetes — gateway compatibile OpenAI/Anthropic, credito prepagato, quote, filtro PII reversibile, runtime locali."
      : "Multi-tenant AI platform for Kubernetes — OpenAI/Anthropic-compatible gateway, prepaid credit, quotas, reversible PII filtering, local runtimes.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Indipendenza",
    addressLocality: "Assisi",
    addressRegion: "PG",
    postalCode: "06081",
    addressCountry: "IT",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    availableLanguage: ["it", "en"],
    url: `${site}/#contatto`,
  },
  sameAs: ["https://ventic.it"],
};

const website = {
  "@type": "WebSite",
  "@id": `${site}/#website`,
  url: site,
  name: "Ventic",
  alternateName: "Ventic — LLM privati",
  description,
  publisher: { "@id": `${site}/#organization` },
  inLanguage: ogLocale,
};

const webpage = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": `${site}/#website` },
  about: { "@id": `${site}/#organization` },
  inLanguage: ogLocale,
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: imageUrl,
  },
  breadcrumb: { "@id": `${canonical}#breadcrumb` },
};

const breadcrumbList = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.href.startsWith("http") ? c.href : `${site}${c.href}`,
  })),
};

const graph: Record<string, unknown>[] = [organization, website, webpage, breadcrumbList];

if (jsonLd) {
  if (Array.isArray(jsonLd)) graph.push(...jsonLd);
  else graph.push(jsonLd);
}

const jsonLdString = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Netter srl" />
    <meta name="publisher" content="Ventic" />
    <meta name="format-detection" content="telephone=no" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
      <meta name="googlebot" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    {/* Canonical & hreflang */}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={itHref} />

    {/* Sitemap discovery */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Browser-language auto-redirect (static hosting: client-side) */}
    {!noLocaleRedirect && <LocaleRedirect />}

    {/* Icons & manifest */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Ventic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Preconnect for performance */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
    />

    {/* JSON-LD */}
    <script type="application/ld+json" set:html={jsonLdString} />
  </head>
  <body>
    <script is:inline>
      document.documentElement.classList.add("js");
      addEventListener("DOMContentLoaded", () => {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { threshold: 0.15 });
        document.querySelectorAll("[data-stagger]").forEach((g) => { [...g.children].forEach((c, i) => c.style.setProperty("--i", i)); io.observe(g); });
      });
    </script>
    <slot />
    <script>import "../scripts/motion.ts";</script>
    <ChatLauncher lang={lang} />
  </body>
</html>
