---
import Icon from "./Icon.astro";
import type { Lang } from "../i18n/content";
import { pagePath } from "../i18n/pages";
import { venticode } from "../i18n/venticode";

interface Props { lang: Lang; num?: string; standalone?: boolean; }
const { lang, num, standalone = false } = Astro.props;
const c = venticode(lang);
const uid = `vc-${lang}`;
const installHref = pagePath(lang, "installVenticode");
---
<section id={c.id} class:list={["sec", "sec--dark", "vc", { "vc--page": standalone }]}>
  <div class="wrap vt-reveal">
    {standalone ? (
      <div class="topbar">
        <span class="plate">{c.shotsLabel}</span>
        <a class="arrowlink repo-link" href={c.repoUrl} target="_blank" rel="noopener noreferrer">
          {c.repoLink} <span class="arr" aria-hidden="true">↗</span>
        </a>
      </div>
    ) : (
      <div class="shead">
        <div>
          <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
          <h2 class="h2">{c.title[0]}<br /><span class="h-accent">{c.title[1]}</span></h2>
        </div>
        <div class="shead-lead">
          <p>{c.lead}</p>
          <a class="arrowlink repo-link" href={c.repoUrl} target="_blank" rel="noopener noreferrer">
            {c.repoLink} <span class="arr" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    )}

    <!-- Real software screenshots viewer -->
    <div class="viewer" data-vc-shots style="--vc-dur:6.5s">
      <div class="tabs" role="tablist" aria-label={c.shotsLabel}>
        {c.shots.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`${uid}-tab-${s.id}`}
            aria-controls={`${uid}-shot-${s.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-i={i}
          >
            <span class="tab-n mono">0{i + 1}</span>
            <span class="tab-c">
              <span class="tab-t">{s.tab}</span>
              <span class="tab-b">{s.title}</span>
            </span>
            <span class="bar" aria-hidden="true"><span></span></span>
          </button>
        ))}
      </div>

      <figure class="win">
        <div class="chrome" aria-hidden="true">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="url mono">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
              <rect x="5" y="11" width="14" height="10" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            <span class="url-text" data-vc-url>{c.shots[0].url}</span>
          </span>
          <span class="badge mono">AGPL-3.0</span>
        </div>

        <div class="stage">
          {c.shots.map((s, i) => (
            <img
              class="shot"
              id={`${uid}-shot-${s.id}`}
              role="tabpanel"
              aria-labelledby={`${uid}-tab-${s.id}`}
              data-on={i === 0 ? "" : undefined}
              data-url={s.url}
              src={s.src}
              alt={s.alt}
              width={s.w}
              height={s.h}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          ))}
        </div>

        <figcaption class="cap">
          {c.shots.map((s, i) => (
            <div class="cap-item" data-on={i === 0 ? "" : undefined}>
              <strong class="cap-t">{s.title}</strong>
              <p class="cap-b">{s.body}</p>
            </div>
          ))}
        </figcaption>
      </figure>
    </div>

    <!-- Compact centralized topology -->
    <div class="block-head">
      <h3 class="sub">{c.archLabel}</h3>
    </div>
    <div class="arch" data-stagger role="img" aria-label={`${c.arch.surfaces.label} → ${c.arch.server.label} ← ${c.arch.harness.label}`}>
      <div class="acol">
        <span class="mono albl">{c.arch.surfaces.label}</span>
        {c.arch.surfaces.items.map((it) => <div class="abox">{it}</div>)}
      </div>

      <div class="alink alink--in" aria-hidden="true">
        <span class="mono alink-lbl">{c.arch.inLink}</span>
        <span class="atrack"><span class="vt-dash"></span><span class="vt-run"></span></span>
      </div>

      <div class="acol acol--server">
        <div class="aserver-top">
          <span class="mono albl albl--accent">{c.arch.server.label}</span>
          <span class="mono abdg">{c.arch.server.badge}</span>
        </div>
        {c.arch.server.items.map((it) => <div class="abox abox--srv">{it}</div>)}
      </div>

      <div class="alink alink--out" aria-hidden="true">
        <span class="mono alink-lbl">{c.arch.outLink}</span>
        <span class="atrack"><span class="vt-dash vt-dash--back"></span><span class="vt-run vt-run--back" style="animation-delay:1.1s"></span></span>
      </div>

      <div class="acol">
        <span class="mono albl">{c.arch.harness.label}</span>
        {c.arch.harness.items.map((it) => <div class="abox">{it}</div>)}
      </div>
    </div>

    <!-- Advantages grid -->
    <div class="block-head">
      <h3 class="sub">{c.advLabel}</h3>
    </div>
    <ol class="adv hairgrid" data-stagger>
      {c.advantages.map((a, i) => (
        <li class="adv-card vt-card">
          <div class="adv-top">
            <span class:list={["vtile", a.tone && `vtile--${a.tone}`]}>
              <Icon name={a.icon} size={20} stroke="currentColor" width={1.6} />
            </span>
            <span class="mono adv-k">0{i + 1} · {a.tag}</span>
          </div>
          <h4 class="card-title">{a.title}</h4>
          <p class="cell-b">{a.body}</p>
        </li>
      ))}
    </ol>

    <!-- VM-free sandboxed browser (gVisor systrap + live viewer + human takeover) -->
    <div class="block-head">
      <h3 class="sub">{c.browser.label}</h3>
    </div>
    <div class="browser-box">
      <div class="bhead">
        <div>
          <h4 class="btitle">{c.browser.title}</h4>
          <p class="cell-b blead">{c.browser.lead}</p>
        </div>
        <div class="bflow" aria-hidden="true">
          <span class="bnode">{c.browser.flow[0]}</span>
          <span class="barr">→</span>
          <span class="bnode bnode--cdp">{c.browser.flow[1]}</span>
          <span class="barr">→</span>
          <span class="bnode bnode--gvisor">{c.browser.flow[2]}</span>
        </div>
      </div>
      <div class="bgrid hairgrid">
        {c.browser.points.map((pt, i) => (
          <div class="bcard">
            <span class="mono bk">0{i + 1} · {pt.k}</span>
            <strong class="bct">{pt.title}</strong>
            <p class="cell-b">{pt.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Open-source AGPL-3.0 standalone vs Ventic-integrated -->
    <div id="deploy" class="deploy">
      <article class="dcard dcard--oss">
        <span class="mono dtag dtag--jade">{c.deploy.standalone.tag}</span>
        <h3 class="dtitle">{c.deploy.standalone.title}</h3>
        <p class="cell-b">{c.deploy.standalone.body}</p>
        <div class="dfoot">
          <pre class="dcmd"><code>$ {c.deploy.standalone.cmd}</code></pre>
          <div class="dactions">
            <a class="btn btn--a btn--sm" href={installHref}>
              {c.deploy.standalone.guide} <span class="arr" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost btn--sm" href={c.repoUrl} target="_blank" rel="noopener noreferrer">
              {c.deploy.standalone.cta} <span class="arr" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>

      <article class="dcard dcard--ventic">
        <span class="mono dtag dtag--amber">{c.deploy.ventic.tag}</span>
        <h3 class="dtitle">{c.deploy.ventic.title}</h3>
        <p class="cell-b">{c.deploy.ventic.body}</p>
        <div class="dfoot">
          <pre class="dcmd"><code>{c.deploy.ventic.cmd}</code></pre>
          <a class="btn btn--b btn--sm" href="#contatto">{c.deploy.cta} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-vc-shots]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const imgs = Array.from(root.querySelectorAll<HTMLImageElement>(".shot"));
    const caps = Array.from(root.querySelectorAll<HTMLElement>(".cap-item"));
    const urlEl = root.querySelector<HTMLElement>("[data-vc-url]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = 0;

    const go = (i: number, focus = false) => {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === cur));
        t.tabIndex = k === cur ? 0 : -1;
      });
      imgs.forEach((el, k) => el.toggleAttribute("data-on", k === cur));
      caps.forEach((el, k) => el.toggleAttribute("data-on", k === cur));
      if (urlEl && imgs[cur]?.dataset.url) urlEl.textContent = imgs[cur].dataset.url;
      if (focus) tabs[cur].focus();
    };

    root.addEventListener("animationend", (e) => {
      if ((e.target as HTMLElement).closest(".bar")) go(cur + 1);
    });
    tabs.forEach((t, k) => t.addEventListener("click", () => { root.classList.add("manual"); go(k); }));
    root.querySelector(".tabs")?.addEventListener("keydown", (e) => {
      const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[(e as KeyboardEvent).key];
      if (d) { e.preventDefault(); root.classList.add("manual"); go(cur + d, true); }
    });

    if (reduce) root.classList.add("manual");
    new IntersectionObserver(([en]) => root.classList.toggle("off", !en.isIntersecting), { threshold: 0.2 }).observe(root);
  });
</script>

<style>
  .vc--page :global(.px-edge) { display: none; }
  .shead-lead p { margin: 0 0 12px; }
  .repo-link { font-weight: 500; }
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 28px;
  }

  /* ── screenshot showcase ─────────────────────────────────── */
  .viewer {
    display: grid;
    grid-template-columns: minmax(240px, 296px) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  .tabs { display: flex; flex-direction: column; border-top: 1px solid var(--line-soft); }
  .tab {
    position: relative;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    text-align: left;
    padding: 18px 4px 20px;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line-soft);
    cursor: pointer;
    color: var(--fg-mid);
    font: inherit;
    transition: color .25s ease;
  }
  .tab:hover { color: var(--fg-strong); }
  .tab:focus-visible { outline: 2px solid var(--amber); outline-offset: -2px; }
  .tab-n { font-size: 11px; padding-top: 4px; color: var(--fg-faint); transition: color .25s ease; }
  .tab-c { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .tab-t { font-size: 17px; font-weight: 500; }
  .tab-b {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--fg-mid);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height .4s var(--ease), opacity .3s ease;
  }
  .tab[aria-selected="true"] { color: var(--fg-strong); }
  .tab[aria-selected="true"] .tab-n { color: var(--amber); }
  .tab[aria-selected="true"] .tab-b { max-height: 80px; opacity: 1; }
  .bar { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--amber); }
  .tab[aria-selected="true"] .bar span { animation: vc-fill var(--vc-dur) linear both; }
  .manual .tab[aria-selected="true"] .bar span { animation: none; width: 100%; }
  .off .bar span, .viewer:hover .bar span { animation-play-state: paused !important; }
  @keyframes vc-fill { to { width: 100%; } }

  .win {
    position: relative;
    margin: 0;
    background: #161616;
    border: 1px solid var(--line-soft);
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, .65), 0 0 0 1px rgba(255, 255, 255, .04);
  }
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 38px;
    padding: 0 14px;
    border-bottom: 1px solid #262626;
    color: #a8a8a8;
  }
  .lights { display: flex; gap: 6px; flex: none; }
  .lights i { width: 9px; height: 9px; background: #393939; }
  .lights i:first-child { background: var(--amber); }
  .url {
    flex: 0 1 420px;
    min-width: 0;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 24px;
    padding: 0 12px;
    background: #0b0c0e;
    border: 1px solid #262626;
    font-family: var(--code);
    font-size: 11px;
    color: #c6c6c6;
    white-space: nowrap;
    overflow: hidden;
  }
  .url svg { color: var(--jade); flex: none; }
  .url-text { overflow: hidden; text-overflow: ellipsis; }
  .badge {
    flex: none;
    font-family: var(--code);
    font-size: 10px;
    letter-spacing: .08em;
    padding: 3px 7px;
    border: 1px solid rgba(14, 159, 142, .45);
    color: #5eead4;
    background: rgba(14, 159, 142, .12);
  }

  .stage {
    position: relative;
    aspect-ratio: 1440 / 860;
    overflow: hidden;
    background: #0b0c0e;
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity .5s ease, transform .9s var(--ease);
  }
  .shot[data-on] { opacity: 1; transform: none; }

  .cap {
    position: relative;
    background: #111317;
    border-top: 1px solid var(--line-soft);
    padding: 18px 22px;
  }
  .cap-item { display: none; flex-direction: column; gap: 4px; }
  .cap-item[data-on] { display: flex; }
  .cap-t { font-size: 15px; font-weight: 500; color: var(--fg-strong); }
  .cap-b { font-size: 14px; line-height: 1.55; color: var(--fg-mid); }

  /* ── section subheadings ─────────────────────────────────── */
  .block-head { margin: 64px 0 24px; }
  .sub {
    padding-bottom: 12px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--fg-dim);
    border-bottom: 1px solid var(--line-soft);
  }

  /* ── compact architecture strip ──────────────────────────── */
  .arch { display: flex; flex-wrap: wrap; align-items: stretch; }
  .acol {
    flex: 1 1 240px;
    border: 1px solid var(--line-soft);
    background: rgba(22, 22, 22, .75);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .acol--server {
    flex: 1.25 1 280px;
    border-color: var(--accent);
    background: #10162e;
  }
  .aserver-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .albl { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); }
  .albl--accent { color: var(--accent-mid); }
  .abdg {
    font-family: var(--code);
    font-size: 10px;
    padding: 2px 6px;
    color: #5eead4;
    border: 1px solid rgba(14, 159, 142, .45);
    background: rgba(14, 159, 142, .12);
  }
  .abox {
    background: #161616;
    border: 1px solid var(--line-soft);
    padding: 11px 14px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--fg);
  }
  .abox--srv { background: rgba(11, 12, 14, .65); border-color: rgba(142, 162, 243, .3); }
  .alink {
    flex: 0 1 112px;
    min-width: 68px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 12px 8px;
  }
  .alink--in { color: var(--accent-mid); }
  .alink--in .vt-run { background: var(--amber); }
  .alink--out { color: var(--amber); }
  .alink--out .vt-run { background: var(--accent-mid); }
  .alink-lbl { font-size: 10px; text-align: center; line-height: 1.3; }
  .atrack { position: relative; height: 12px; display: block; }
  .atrack .vt-dash { position: absolute; left: 0; right: 0; top: 5px; }

  /* ── advantages hairline grid ────────────────────────────── */
  .adv {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .adv-card {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #121419;
  }
  .adv-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .adv-k { font-size: 11px; letter-spacing: .07em; text-transform: uppercase; color: var(--fg-mute); }
  .vtile {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: rgba(35, 71, 232, .22);
    color: var(--accent-mid);
  }
  .vtile--amber { background: rgba(245, 168, 63, .16); color: var(--amber); }
  .vtile--jade { background: rgba(14, 159, 142, .18); color: #5eead4; }

  /* ── sandboxed browser feature block ─────────────────────── */
  .browser-box {
    border: 1px solid var(--line-soft);
    background: #121419;
  }
  .bhead {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-bottom: 1px solid var(--line-soft);
  }
  .btitle {
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--fg-strong);
    margin-bottom: 10px;
  }
  .blead { max-width: 78ch; }
  .bflow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .bnode {
    font-family: var(--code);
    font-size: 12px;
    padding: 8px 12px;
    background: #161616;
    border: 1px solid var(--line-soft);
    color: var(--fg);
  }
  .bnode--cdp {
    border-color: var(--accent);
    background: #10162e;
    color: var(--accent-mid);
  }
  .bnode--gvisor {
    border-color: rgba(14, 159, 142, .55);
    background: rgba(14, 159, 142, .12);
    color: #5eead4;
  }
  .barr { color: var(--amber); font-family: var(--code); font-size: 14px; }
  .bgrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 0;
  }
  .bcard {
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #121419;
  }
  .bk { font-size: 11px; letter-spacing: .07em; text-transform: uppercase; color: var(--amber); }
  .bct { font-size: 17px; font-weight: 500; line-height: 1.3; color: var(--fg-strong); }

  /* ── deployment & AGPL-3.0 strip ─────────────────────────── */
  .deploy {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
  }
  .dcard {
    min-width: 0;
    background: #161616;
    border: 1px solid var(--line-soft);
    border-top: 3px solid var(--jade);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .dcard--ventic { border-top-color: var(--amber); }
  .dtag { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .dtag--jade { color: #5eead4; }
  .dtag--amber { color: var(--amber); }
  .dtitle { font-size: clamp(20px, 1.8vw, 24px); font-weight: 400; line-height: 1.2; color: var(--fg-strong); }
  .dcmd {
    margin: 0;
    padding: 12px 14px;
    background: #0b0c0e;
    border: 1px solid #262626;
    border-left: 2px solid var(--jade);
    font-family: var(--code);
    font-size: 12.5px;
    line-height: 1.5;
    color: #e0e0e0;
    overflow-x: auto;
    max-width: 100%;
  }
  .dcard--ventic .dcmd { border-left-color: var(--amber); }
  .dfoot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .dfoot .dcmd { width: 100%; }
  .dactions { display: flex; flex-wrap: wrap; gap: 10px; }

  /* ── responsive ──────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .adv { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .alink { flex-basis: 100%; min-height: 44px; padding: 6px 0; }
    .alink .atrack { width: 2px; height: 28px; margin: 0 auto; background: currentColor; }
    .alink .vt-dash, .alink .vt-run { display: none; }
  }
  @media (max-width: 960px) {
    .viewer { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .tabs { flex-direction: row; overflow-x: auto; border-top: 0; border-bottom: 1px solid var(--line-soft); scrollbar-width: none; }
    .tab { flex: none; padding: 12px 14px; border-bottom: 0; }
    .tab-n, .tab-b { display: none; }
    .tab-t { font-size: 14px; }
    .deploy { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .adv, .bgrid { grid-template-columns: 1fr; }
    .bhead, .bcard { padding: 20px 18px; }
    .barr { display: none; }
    .bnode { width: 100%; }
