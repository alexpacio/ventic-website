---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = content[lang].stackDiagram;
const SLOTS = 4;
---
<figure class="fig">
  <div class="annot">
    <span class="plate plate--accent"><Icon name="overlay" size={12} width={1.6} />{d.label}</span>
    <span class="mono locnote">Nodi chiusi · Nessun IP pubblico · mTLS</span>
  </div>

  <div class="diagram">
    <!-- where the requests come from -->
    <div class="panel col">
      <span class="mono coltag">{d.clients.label}</span>
      <span class="mono subtag">{lang === "it" ? "SDK invariato" : "SDK unchanged"}</span>
      <div class="items">
        {d.clients.items.map((it) => <span class="sunk item">{it}</span>)}
      </div>
    </div>

    <div class="flow">
      <span class="mono flab">{d.flowA}</span>
      <span class="wire"><span class="pip"></span></span>
      <span class="mono flab subflab">{lang === "it" ? "→ unico endpoint" : "→ single endpoint"}</span>
    </div>

    <!-- what you run -->
    <div class="panel col">
      <span class="mono coltag">{d.infra.label}</span>
      <span class="mono subtag">Docker · on-prem / cloud</span>
      <div class="items">
        {d.infra.items.map((it) => <span class="sunk item">{it}</span>)}
      </div>
    </div>

    <div class="flow">
      <span class="mono flab">{d.flowB}</span>
      <span class="wire wire--accent"><span class="pip pip--b"></span></span>
      <span class="mono flab subflab">{lang === "it" ? "senza porte esposte" : "no open ports"}</span>
    </div>

    <!-- the GPUs -->
    <div class="panel col col--nodes">
      <span class="mono coltag">{d.nodesLabel}</span>
      <span class="mono subtag">{lang === "it" ? "Tue GPU o dal catalogo" : "Yours or from catalogue"}</span>
      <div class="items">
        {d.nodes.map((n) => (
          <div class="sunk node">
            <div class="nrow">
              <span class="nname mono">{n.name}</span>
              <span class="nmeta mono">{n.meta}</span>
            </div>
            <div class="slots" aria-hidden="true">
              {Array.from({ length: SLOTS }).map((_, i) => (
                <span class={`slot ${i < n.filled ? "slot--on" : ""}`}></span>
              ))}
            </div>
          </div>
        ))}

        <div class="sunk node node--auto">
          <div class="nrow">
            <span class="nname mono">{d.autoNode.name}</span>
            <span class="plate plate--sm atag">{d.autoNode.tag}</span>
          </div>
          <div class="slots" aria-hidden="true">
            <span class="slot slot--wake"></span>
            <span class="slot"></span>
            <span class="slot"></span>
            <span class="slot"></span>
          </div>
          <span class="nmeta mono">{d.autoNode.meta}</span>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="scale">
    <div class="shead">
      <Icon name="power" size={18} />
      <span class="mono slabel">{d.scale.label}</span>
    </div>
    <ul class="policy">
      {d.scale.rules.map((r) => <li class="pol">{r}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .fig { margin: 0 0 46px; }
  .annot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
  .locnote { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-ghost); }

  .diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px minmax(0, 1fr) 150px minmax(0, 1.05fr);
    align-items: stretch;
  }

  .col { display: flex; flex-direction: column; gap: 8px; padding: 18px 18px 20px; }
  .coltag {
    font-size: 10px; font-weight: 600; letter-spacing: .18em;
    text-transform: uppercase; color: var(--fg-faint);
  }
  .subtag { font-size: 10px; letter-spacing: .06em; color: var(--fg-ghost); margin-top: -2px; }
  .items { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
  .item { padding: 11px 13px; font-size: 13px; line-height: 1.35; color: var(--fg-dim); }

  .flow { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 0 12px; }
  .flab {
    font-size: 10px; line-height: 1.5; letter-spacing: .1em; text-transform: uppercase;
    color: var(--fg-mute); text-align: center;
  }
  .subflab { font-size: 9px; color: var(--fg-ghost); letter-spacing: .08em; }
  .wire { position: relative; width: 100%; height: 1px; background: var(--line); }
  .wire--accent { background: #3a3125; }
  .wire::after {
    content: ""; position: absolute; right: -1px; top: -3px;
    border-left: 6px solid var(--line); border-top: 3.5px solid transparent; border-bottom: 3.5px solid transparent;
  }
  .wire--accent::after { border-left-color: #5a4631; }
  .pip {
    position: absolute; top: -2px; left: 0;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 8px var(--accent);
    animation: travel 3.2s cubic-bezier(.5, 0, .5, 1) infinite;
  }
  .pip--b { animation-delay: .9s; }

  .node { display: flex; flex-direction: column; gap: 10px; padding: 12px 13px 13px; }
  .nrow { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .nname { font-size: 12px; font-weight: 600; color: var(--fg-strong); }
  .nmeta { font-size: 10px; letter-spacing: .06em; color: var(--fg-ghost); }

  .slots { display: flex; gap: 4px; }
  .slot { width: 100%; height: 9px; border-radius: 1px; background: #22262b; box-shadow: inset 0 1px 2px #00000073; }
  .slot--on { background: var(--accent); box-shadow: 0 0 10px -2px var(--accent); }

  .node--auto {
    border-style: dashed; border-color: var(--warm-border); background: transparent; box-shadow: none;
    animation: wake 7s ease-in-out infinite;
  }
  .atag { color: var(--accent); border-color: #3a3125; }
  .slot--wake { background: var(--accent); animation: fill 7s ease-in-out infinite; }

  @keyframes travel {
    0%        { left: 0; opacity: 0; }
    12%       { opacity: 1; }
    82%       { opacity: 1; }
    100%      { left: 100%; opacity: 0; }
  }
  @keyframes wake {
    0%, 14%   { opacity: .3; }
    30%, 72%  { opacity: 1; }
    88%, 100% { opacity: .3; }
  }
  @keyframes fill {
    0%, 18%   { background: #22262b; box-shadow: inset 0 1px 2px #00000073; }
    32%, 70%  { background: var(--accent); box-shadow: 0 0 10px -2px var(--accent); }
    84%, 100% { background: #22262b; box-shadow: inset 0 1px 2px #00000073; }
  }

  .scale {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 26px; align-items: start;
    padding: 22px 22px 24px;
    background: var(--warm-head);
    border: 1px solid var(--warm-border); border-top: 0;
    border-radius: 0 0 3px 3px;
  }
  .shead { display: flex; align-items: center; gap: 10px; }
  .slabel {
    font-size: 11px; font-weight: 600; letter-spacing: .18em;
    text-transform: uppercase; color: var(--accent);
  }
  .policy { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pol {
    position: relative; padding-left: 16px;
    font-size: 13px; line-height: 1.5; color: var(--fg-dim);
  }
  .pol::before {
    content: ""; position: absolute; left: 0; top: 8px;
    width: 6px; height: 6px; background: var(--accent);
  }

  @media (max-width: 1080px) {
    .diagram { grid-template-columns: minmax(0, 1fr) 112px minmax(0, 1fr); }
    .diagram > .flow:nth-of-type(2) { grid-column: 1 / -1; flex-direction: row; padding: 16px 0; }
    .diagram > .flow:nth-of-type(2) .wire { width: 100%; }
    .col--nodes { grid-column: 1 / -1; }
    .scale { grid-template-columns: 1fr; gap: 16px; }
    .policy { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .diagram { grid-template-columns: 1fr; }
    .flow, .diagram > .flow:nth-of-type(2) { grid-column: 1; flex-direction: column; padding: 14px 0; }
    .col, .col--nodes { grid-column: 1; }
    .wire { width: 100%; }
    .policy { grid-template-columns: 1fr; gap: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire .pip, .node--auto, .slots .slot--wake { animation: none !important; }
    .node--auto { opacity: 1 !important; }
    .wire .pip { opacity: 0 !important; }
  }
</style>
