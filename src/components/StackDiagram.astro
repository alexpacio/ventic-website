---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = content[lang].stackDiagram;
const n = d.net;
const SLOTS = 4;

/* ── palette (mirrors the tokens in global.css) ───────────────── */
const C = {
  zoneFill: "#0d0f12", zoneLine: "#2b3036",
  tabFill: "#15181b", tabText: "#8a8d92", zoneSub: "#5c5f63",
  box: "#181b1f", boxKey: "#1d2126", boxCtrl: "#161a1b",
  boxLine: "#32373d", boxLineKey: "#3f464e",
  bar: "#3d444b", title: "#f2f0eb", titleDim: "#b7b5ae", sub: "#6f7276",
  dash: "#3a4046", wire: "#3d444b",
  amber: "#f5a83f", amberDim: "#7c5c2c", jade: "#35cfa4", jadeDim: "#2c5a4d",
  slotOff: "#22262b",
};

/* ── zone frames ─────────────────────────────────────────────── */
const zones = [
  { x: 16,  y: 104, w: 232, h: 252, ...n.zones.clients },
  { x: 300, y: 56,  w: 330, h: 400, ...n.zones.infra },
  { x: 676, y: 104, w: 140, h: 252, ...n.zones.overlay },
  { x: 856, y: 56,  w: 364, h: 400, ...n.zones.nodes },
  { x: 300, y: 536, w: 920, h: 164, ...n.zones.control },
];
const tabW = (s: string) => Math.round(s.length * 8.8 + 24);
const badgeW = (s: string) => Math.round(s.length * 5.2 + 16);

/* ── device boxes ────────────────────────────────────────────── */
type Kind = "std" | "key" | "opt" | "ctrl" | "net";
interface Box {
  x: number; y: number; w: number; h: number;
  t: string; s: string; s2?: string;
  kind: Kind; badge?: string; tone?: "opt" | "on" | "soon";
}
const boxes: Box[] = [
  /* 01 — workstations */
  { x: 34, y: 148, w: 196, h: 52, ...n.boxes.wsA, kind: "std" },
  { x: 34, y: 212, w: 196, h: 52, ...n.boxes.wsB, kind: "std" },
  { x: 34, y: 276, w: 196, h: 52, ...n.boxes.wsC, kind: "std" },
  /* 02 — your docker infrastructure */
  { x: 324, y: 108, w: 282, h: 64, ...n.boxes.proxy, kind: "key" },
  { x: 324, y: 186, w: 282, h: 52, ...n.boxes.panel, kind: "std" },
  { x: 324, y: 252, w: 282, h: 52, ...n.boxes.obs, kind: "std" },
  { x: 324, y: 318, w: 282, h: 68, ...n.boxes.inpOn, kind: "opt", badge: n.badges.opt, tone: "opt" },
  { x: 324, y: 400, w: 282, h: 44, ...n.boxes.extras, kind: "opt" },
  /* 03 — overlay */
  { x: 692, y: 200, w: 108, h: 68, ...n.boxes.relay, kind: "net" },
  /* 05 — ventic control plane */
  { x: 324, y: 582, w: 300, h: 96, ...n.boxes.inpPaas, kind: "ctrl", badge: n.badges.on, tone: "on" },
  { x: 950, y: 582, w: 240, h: 96, ...n.boxes.billing, kind: "opt", badge: n.badges.soon, tone: "soon" },
];
const fillOf = (k: Kind) => (k === "opt" ? "none" : k === "key" || k === "net" ? C.boxKey : k === "ctrl" ? C.boxCtrl : C.box);
const lineOf = (k: Kind) => (k === "opt" ? C.dash : k === "key" ? C.boxLineKey : k === "net" ? C.amberDim : k === "ctrl" ? C.jadeDim : C.boxLine);
const barOf  = (k: Kind) => (k === "key" || k === "net" ? C.amber : k === "ctrl" ? C.jade : k === "opt" ? null : C.bar);
const toneOf = (t?: string) => (t === "on" ? C.jade : t === "soon" ? C.amber : C.sub);

/* ── 04 — gpu nodes ──────────────────────────────────────────── */
const gpu = [
  { y: 104, name: d.nodes[0].name, meta: d.nodes[0].meta, filled: d.nodes[0].filled, auto: false },
  { y: 208, name: d.nodes[1].name, meta: d.nodes[1].meta, filled: d.nodes[1].filled, auto: false },
  { y: 312, name: d.autoNode.name, meta: d.autoNode.meta, filled: 0, auto: true },
];
---
<figure class="fig">
  <div class="annot">
    <span class="plate plate--accent"><Icon name="overlay" size={12} width={1.6} />{d.label}</span>
    <span class="mono locnote">{n.edges.overlay}</span>
  </div>

  <div class="netwrap">
    <div class="netscroll">
      <svg class="net" viewBox="0 0 1240 720" role="img" aria-label={d.label}>
        <defs>
          <marker id="ar-d" markerWidth="7" markerHeight="7" refX="6.2" refY="3.5" orient="auto">
            <path d="M0 0 L7 3.5 L0 7 z" fill={C.wire} />
          </marker>
          <marker id="ar-a" markerWidth="7" markerHeight="7" refX="6.2" refY="3.5" orient="auto">
            <path d="M0 0 L7 3.5 L0 7 z" fill={C.amber} />
          </marker>
          <marker id="ar-c" markerWidth="7" markerHeight="7" refX="6.2" refY="3.5" orient="auto">
            <path d="M0 0 L7 3.5 L0 7 z" fill={C.jade} />
          </marker>
        </defs>

        <!-- ── zone frames ──────────────────────────────────── -->
        {zones.map((z) => (
          <g>
            <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="4"
              fill={C.zoneFill} stroke={C.zoneLine} stroke-dasharray="3 4" />
            <rect x={z.x + 12} y={z.y - 12} width={tabW(z.t)} height="24" rx="2"
              fill={C.tabFill} stroke={C.zoneLine} />
            <text x={z.x + 25} y={z.y + 4} font-size="9.5" font-weight="600"
              letter-spacing="0.14em" fill={C.tabText}>{z.t.toUpperCase()}</text>
            <text x={z.x + 14} y={z.y + 34} font-size="8.5" letter-spacing="0.05em" fill={C.zoneSub}>{z.s}</text>
          </g>
        ))}

        <!-- ── data path: workstations → proxy ──────────────── -->
        <g fill="none" stroke={C.wire} stroke-width="1.2">
          <path d="M230 174 H264" /><path d="M230 238 H264" /><path d="M230 302 H264" />
          <path d="M264 302 V140 H320" marker-end="url(#ar-d)" />
        </g>
        <circle cx="264" cy="238" r="2.4" fill={C.wire} />
        <circle cx="264" cy="302" r="2.4" fill={C.wire} />
        <text x="286" y="225" transform="rotate(-90 286 225)" text-anchor="middle"
          font-size="8.5" letter-spacing="0.06em" fill={C.sub}>{n.edges.api}</text>

        <!-- ── data path: proxy → relay → gpu nodes (mTLS) ──── -->
        <g fill="none" stroke={C.amber} stroke-width="1.3" opacity="0.85">
          <path d="M606 140 H652 V234 H688" marker-end="url(#ar-a)" />
          <path d="M800 234 H836" />
          <path d="M836 138 V346" />
          <path d="M836 138 H876" marker-end="url(#ar-a)" />
          <path d="M836 242 H876" marker-end="url(#ar-a)" />
          <path d="M836 346 H876" marker-end="url(#ar-a)" />
        </g>
        <circle cx="836" cy="234" r="2.6" fill={C.amber} />

        <!-- traffic pips -->
        <circle r="2.4" fill={C.wire} class="pip">
          <animateMotion dur="3.4s" repeatCount="indefinite" path="M264 302 V140 H320" />
        </circle>
        <circle r="2.6" fill={C.amber} class="pip">
          <animateMotion dur="3.4s" begin="0.7s" repeatCount="indefinite" path="M606 140 H652 V234 H688" />
        </circle>
        <circle r="2.6" fill={C.amber} class="pip">
          <animateMotion dur="3.4s" begin="1.5s" repeatCount="indefinite" path="M800 234 H836 V138 H876" />
        </circle>
        <text x="636" y="200" transform="rotate(-90 636 200)" text-anchor="middle"
          font-size="8.5" letter-spacing="0.06em" fill={C.amber} opacity="0.8">{n.edges.overlayShort}</text>

        <!-- ── control path: provisioning ───────────────────── -->
        <g fill="none" stroke={C.jade} stroke-width="1.2" stroke-dasharray="5 4" opacity="0.8">
          <path d="M606 352 H658 V480 H1120 V460" marker-end="url(#ar-c)" />
          <path d="M540 456 V578" marker-end="url(#ar-c)" />
          <path d="M808 582 V504 H1202 V346 H1184" marker-end="url(#ar-c)" />
          <path d="M624 630 H684" marker-end="url(#ar-c)" />
        </g>
        <g font-size="8.5" letter-spacing="0.06em" fill={C.sub}>
          <text x="880" y="472" text-anchor="middle">{n.edges.manage}</text>
          <text x="550" y="520">{n.edges.intent}</text>
          <text x="1010" y="496" text-anchor="middle">{n.edges.attach}</text>
          <text x="657" y="622" text-anchor="middle">{n.edges.acquire}</text>
        </g>

        <!-- ── device boxes ─────────────────────────────────── -->
        {boxes.map((b) => (
          <g>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="2"
              fill={fillOf(b.kind)} stroke={lineOf(b.kind)}
              stroke-dasharray={b.kind === "opt" ? "5 4" : undefined} />
            {barOf(b.kind) && <rect x={b.x} y={b.y} width="3" height={b.h} fill={barOf(b.kind)} />}
            <text x={b.x + 15} y={b.y + (b.h > 56 ? 25 : 22)} font-size="10.5" font-weight="600"
              letter-spacing="0.09em" fill={b.kind === "opt" ? C.titleDim : C.title}>{b.t}</text>
            <text x={b.x + 15} y={b.y + (b.h > 56 ? 42 : 37)} font-size="8.5"
              letter-spacing="0.04em" fill={C.sub}>{b.s}</text>
            {b.s2 && (
              <text x={b.x + 15} y={b.y + 62} font-size="8.5" letter-spacing="0.04em" fill={C.zoneSub}>{b.s2}</text>
            )}
            {b.badge && (
              <g>
                <rect x={b.x + b.w - 10 - badgeW(b.badge)} y={b.y + 10} width={badgeW(b.badge)} height="16" rx="2"
                  fill="none" stroke={toneOf(b.tone)} opacity="0.45" />
                <text x={b.x + b.w - 10 - badgeW(b.badge) / 2} y={b.y + 21} text-anchor="middle"
                  font-size="8" letter-spacing="0.08em" fill={toneOf(b.tone)}>{b.badge}</text>
              </g>
            )}
          </g>
        ))}

        <!-- ── cloud gpu catalogue ──────────────────────────── -->
        <g>
          <rect x="690" y="582" width="236" height="96" rx="2" fill={C.boxCtrl} stroke={C.boxLine} />
          <g opacity="0.16" fill={C.jade}>
            <circle cx="867" cy="622" r="12" /><circle cx="888" cy="614" r="17" /><circle cx="907" cy="623" r="11" />
            <rect x="855" y="622" width="64" height="14" rx="7" />
          </g>
          <text x="706" y="607" font-size="10.5" font-weight="600" letter-spacing="0.09em" fill={C.title}>{n.boxes.catalog.t}</text>
          <text x="706" y="624" font-size="8.5" letter-spacing="0.04em" fill={C.sub}>{n.boxes.catalog.s}</text>
          <text x="706" y="644" font-size="8.5" letter-spacing="0.04em" fill={C.zoneSub}>{n.boxes.catalog.s2}</text>
        </g>

        <!-- ── gpu nodes ────────────────────────────────────── -->
        {gpu.map((g) => (
          <g>
            <rect x="880" y={g.y} width="300" height="68" rx="2"
              fill={g.auto ? "none" : C.box} stroke={g.auto ? C.amberDim : C.boxLine}
              stroke-dasharray={g.auto ? "5 4" : undefined} />
            {!g.auto && <rect x="880" y={g.y} width="3" height="68" fill={C.bar} />}
            <text x="896" y={g.y + 24} font-size="10.5" font-weight="600" letter-spacing="0.06em"
              fill={g.auto ? C.titleDim : C.title}>{g.name}</text>
            {g.auto ? (
              <g>
                <rect x={1170 - badgeW(n.badges.auto)} y={g.y + 10} width={badgeW(n.badges.auto)} height="16" rx="2"
                  fill="none" stroke={C.amber} opacity="0.5" />
                <text x={1170 - badgeW(n.badges.auto) / 2} y={g.y + 21} text-anchor="middle"
                  font-size="8" letter-spacing="0.08em" fill={C.amber}>{n.badges.auto}</text>
              </g>
            ) : (
              <text x="1164" y={g.y + 24} text-anchor="end" font-size="8.5" letter-spacing="0.06em" fill={C.sub}>{g.meta}</text>
            )}
            {Array.from({ length: SLOTS }).map((_, i) => (
              <rect x={896 + i * 70} y={g.y + 36} width="62" height="8" rx="1"
                fill={i < g.filled ? C.amber : C.slotOff} opacity={i < g.filled ? 0.9 : 1} />
            ))}
            {g.auto && <text x="896" y={g.y + 60} font-size="8.5" letter-spacing="0.04em" fill={C.sub}>{g.meta}</text>}
          </g>
        ))}
        <text x="880" y="424" font-size="8.5" letter-spacing="0.05em" fill={C.zoneSub}>{d.nodesNote}</text>

        <!-- ── overlay band notes ───────────────────────────── -->
        <text x="746" y="300" text-anchor="middle" font-size="8.5" letter-spacing="0.05em" fill={C.sub}>{n.notes.noIp}</text>
        <text x="746" y="316" text-anchor="middle" font-size="8.5" letter-spacing="0.05em" fill={C.sub}>{n.notes.noVpn}</text>
      </svg>
    </div>

    <div class="legend">
      <span class="key"><span class="ln ln--data"></span>{n.legend.data}</span>
      <span class="key"><span class="ln ln--mtls"></span>{n.legend.mtls}</span>
      <span class="key"><span class="ln ln--ctrl"></span>{n.legend.ctrl}</span>
      <span class="key"><span class="bx"></span>{n.legend.opt}</span>
      <span class="key hint">{n.hint}</span>
    </div>
  </div>

  <figcaption class="scale">
    <div class="shead">
      <Icon name="power" size={18} />
      <span class="mono slabel">{d.scale.label}</span>
    </div>
    <ul class="policy">
      {d.scale.rules.map((r) => <li class="pol">{r}</li>)}
    </ul>
  </figcaption>

  <div class="prov">
    <div class="prov-head">
      <Icon name="provisioning" size={16} />
      <span class="mono prov-label">{d.provisioner.label}</span>
    </div>
    <div class="prov-grid">
      <div class="sunk prov-card prov-card--opt">
        <div class="prov-top">
          <span class="cname">{d.provisioner.onPrem.title}</span>
          <span class="plate plate--sm prov-badge prov-badge--opt">{d.provisioner.onPrem.badge}</span>
        </div>
        <p class="cell-b">{d.provisioner.onPrem.body}</p>
      </div>
      <div class="sunk prov-card">
        <div class="prov-top">
          <span class="cname">{d.provisioner.paas.title}</span>
          <span class="plate plate--sm prov-badge prov-badge--on">{d.provisioner.paas.badge}</span>
        </div>
        <p class="cell-b">{d.provisioner.paas.body}</p>
      </div>
      <div class="sunk prov-card prov-card--opt prov-card--billing">
        <div class="prov-top">
          <span class="cname">{d.provisioner.billing.title}</span>
          <span class="plate plate--sm prov-badge prov-badge--soon">{d.provisioner.billing.badge}</span>
        </div>
        <p class="cell-b">{d.provisioner.billing.body}</p>
      </div>
    </div>
    <p class="mono prov-note">
      {lang === "it"
        ? "INP PaaS lato Ventic esiste sempre e può rifornire anche lo stack on-prem — INP on-prem è opzionale e vede solo le tue macchine. Billing in arrivo per resale subscription/token."
        : "Ventic INP PaaS always exists and can supply even on-prem stacks — on-prem INP is optional and sees only your machines. Billing coming soon for subscription/token resale."}
    </p>
  </div>
</figure>

<style>
  .fig { margin: 0 0 46px; }
  .annot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
  .locnote { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-ghost); }

  .pip { opacity: .85; }
  @media (prefers-reduced-motion: reduce) { .pip { display: none; } }

  .netwrap { background: var(--sunk); border: 1px solid var(--warm-border); border-radius: 3px 3px 0 0; }
  .netscroll { overflow-x: auto; padding: 18px 18px 8px; }
  .net { display: block; width: 100%; min-width: 1000px; height: auto; }

  .legend {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px;
    padding: 12px 18px 14px;
    border-top: 1px solid var(--line-dim);
  }
  .key {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--fg-faint);
  }
  .ln { width: 22px; height: 0; border-top: 1.5px solid var(--line); }
  .ln--data { border-top-color: #4b535b; }
  .ln--mtls { border-top-color: var(--accent); }
  .ln--ctrl { border-top: 1.5px dashed var(--jade); }
  .bx { width: 16px; height: 11px; border: 1px dashed #3d4349; border-radius: 2px; }
  .hint { display: none; margin-left: auto; color: var(--fg-ghost); }

  .scale {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 26px; align-items: start;
    padding: 22px 22px 24px;
    background: var(--warm-head);
    border: 1px solid var(--warm-border); border-top: 0;
    border-radius: 0 0 3px 3px;
  }
  .shead { display: flex; align-items: center; gap: 10px; }
  .slabel { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); }
  .policy { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .pol { position: relative; padding-left: 16px; font-size: 13px; line-height: 1.5; color: var(--fg-dim); }
  .pol::before { content: ""; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; background: var(--accent); }

  .prov { margin-top: 16px; padding: 18px 18px 16px; background: #0f1214; border: 1px solid var(--line-soft); border-radius: 3px; }
  .prov-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .prov-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--fg-strong); }
  .prov-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .prov-card { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 8px; }
  .prov-card--opt { background: transparent; border-style: dashed; border-color: #3d4349; box-shadow: none; }
  .prov-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .prov-badge { flex-shrink: 0; font-size: 9px; letter-spacing: .08em; }
  .prov-badge--opt { color: var(--fg-faint); }
  .prov-badge--on { color: var(--jade); border-color: rgba(53,207,164,.22); background: rgba(53,207,164,.08); }
  .prov-badge--soon { color: var(--accent); border-color: rgba(245,168,63,.22); background: rgba(245,168,63,.08); }
  .prov-note { margin-top: 12px; font-size: 10px; letter-spacing: .06em; color: var(--fg-ghost); line-height: 1.6; }

  @media (max-width: 1080px) {
    .scale { grid-template-columns: 1fr; gap: 16px; }
    .policy { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prov-grid { grid-template-columns: 1fr 1fr; }
    .prov-card--billing { grid-column: 1 / -1; }
  }
  @media (max-width: 1040px) { .hint { display: inline-flex; } }
  @media (max-width: 860px) {
    .netscroll { padding: 14px 14px 6px; }
    .legend { gap: 10px 16px; padding: 12px 14px; }
    .hint { margin-left: 0; }
    .policy { grid-template-columns: 1fr; gap: 12px; }
    .prov-grid { grid-template-columns: 1fr; }
    .prov-card--billing { grid-column: 1; }
  }
</style>
