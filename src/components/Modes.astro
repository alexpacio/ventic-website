---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].modes;
---
<section id={c.id} class="sec">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="body lead-r">{c.lead}</p>
    </div>

    <div class="pair">
      <!-- BYOH — licenza a postazioni -->
      <article class="panel card">
        <div class="panel-head">
          <span class="mono tag">{c.byoh.tag}</span>
          <span class="rivet"></span>
        </div>
        <div class="body-in">
          <h3 class="ctitle">{c.byoh.title}</h3>
          <p class="desc">{c.byoh.desc}</p>
          <ul class="ticks">
            {c.byoh.ticks.map((t) => <li class="tick">{t}</li>)}
          </ul>
          <p class="note">{c.byoh.note}</p>
        </div>
      </article>

      <!-- PaaS — tutto incluso -->
      <article class="panel panel--warm card">
        <div class="panel-head panel-head--warm">
          <span class="mono tag tag--warm">{c.paas.tag}</span>
          <span class="rivet"></span>
        </div>
        <div class="body-in">
          <h3 class="ctitle">{c.paas.title}</h3>
          <p class="desc">{c.paas.desc}</p>
          <ul class="ticks">
            {c.paas.ticks.map((t) => <li class="tick">{t}</li>)}
          </ul>
          <p class="note">{c.paas.note}</p>
        </div>
      </article>
    </div>

    <!-- Netter Intelligence — istanza già attiva -->
    <article class="panel card hosted" data-mode="hosted">
      <div class="panel-head">
        <span class="mono tag">{c.hosted.tag}</span>
        <span class="rivet"></span>
      </div>
      <div class="hosted-in">
        <div class="hosted-copy">
          <h3 class="ctitle">{c.hosted.title}</h3>
          <p class="desc">{c.hosted.desc}</p>
          <ul class="ticks">
            {c.hosted.ticks.map((t) => <li class="tick">{t}</li>)}
          </ul>
          <p class="note">{c.hosted.note}</p>
        </div>
        <div class="sunk hosted-box">
          <span class="mono plabel">{c.hosted.endpointLabel}</span>
          <span class="host">{c.hosted.host}</span>
          <span class="badge-lic mono"><span class="dot dot--live" style="width:6px;height:6px"></span>{lang === "it" ? "già attiva" : "already running"}</span>
          <a class="btn btn--a hosted-cta" href={c.hosted.url} rel="noopener">{c.hosted.cta}<Icon name="arrow" size={16} width={2} /></a>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .plate { margin-bottom: 16px; }
  .lead-r { max-width: 38ch; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .hosted { margin-top: 16px; }
  .hosted-in { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; align-items: stretch; padding: 24px 22px; }
  .hosted-copy { display: flex; flex-direction: column; gap: 16px; }
  .hosted-box { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 14px; padding: 24px; }
  .host { font-family: var(--sans); font-weight: 300; font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.02em; line-height: 1.1; color: var(--accent); overflow-wrap: anywhere; }
  .hosted-cta { margin-top: 6px; }
  .card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .tag { font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #a9a7a1; line-height: 1.3; }
  .tag--warm { color: var(--accent); }
  .body-in { display: flex; flex-direction: column; gap: 16px; padding: 24px 22px; flex-grow: 1; }
  .ctitle { font-family: var(--display); font-size: clamp(30px, 3vw, 40px); font-weight: 300; letter-spacing: -0.02em; line-height: 1;  color: var(--fg-strong); }
  .desc { font-size: 16px; line-height: 1.62; color: var(--fg-dim); }
  .pricebox { display: flex; flex-direction: column; gap: 10px; padding: 16px; }
  .pricebox--byoh { gap: 8px; border-style: dashed; }
  .pricebox--paas { gap: 10px; background: var(--warm-cell); border-color: #2e2a26; }
  .plabel { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--fg-faint); }
  .plabel--warm { color: var(--accent); opacity: .9; }
  .prow { display: flex; align-items: baseline; gap: 8px; }
  .pval { font-size: clamp(30px, 3vw, 38px); color: var(--accent); }
  .pval--warm { color: var(--accent); }
  .punit { font-size: 13px; color: var(--fg-mute); }
  .byoh-sub { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-faint); margin-top: -2px; }
  /* BYOH scale */
  .scale { margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 10px; }
  .scale-row { display: flex; align-items: center; gap: 10px; }
  .scale-row--muted { opacity: .95; }
  .seat-dots { display: inline-flex; gap: 4px; }
  .seat-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: block; box-shadow: 0 0 6px rgba(245,168,63,.35); }
  .seat-dots--muted i { background: #5a5e63; box-shadow: none; }
  .scale-label { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); flex: 1; }
  .scale-price { font-size: 13px; font-weight: 600; color: var(--fg-strong); font-variant-numeric: tabular-nums; }
  .scale-sep { display: flex; align-items: center; gap: 10px; }
  .scale-sep span:first-child, .scale-sep span:last-child { flex: 1; height: 1px; background: var(--line-dim); }
  .plus { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); background: rgba(245,168,63,.08); border: 1px solid rgba(245,168,63,.18); padding: 3px 8px; border-radius: 0; }
  .scale-foot { font-size: 11px; letter-spacing: .02em; color: var(--fg-ghost); line-height: 1.5; margin-top: 2px; }
  .badge-lic {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 10px; letter-spacing: .14em; text-transform: uppercase;
    color: var(--jade); background: rgba(53,207,164,.08); border: 1px solid rgba(53,207,164,.18);
    border-radius: 0; padding: 6px 10px; align-self: flex-start;
  }
  .paas-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 2px; padding-top: 12px; border-top: 1px solid #2e2a26; }
  .paas-hw { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); }
  .paas-off { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-ghost); }
  ul.ticks { list-style: none; margin: 0; padding: 0; }
  .note { margin-top: auto; padding-top: 6px; font-size: 13px; line-height: 1.55; color: var(--fg-faint); }
  @media (max-width: 860px) { .pair { grid-template-columns: 1fr; } .tag { font-size: 9px; } .hosted-in { grid-template-columns: 1fr; gap: 24px; } .hosted-cta { width: 100%; } }
</style>
