---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; num?: string; tint?: boolean; }
const { lang, num, tint = true } = Astro.props;
const c = content[lang].modes;
const pricing = lang === "it" ? "/pricing/" : "/en/pricing/";
const demoCta = lang === "it" ? "Richiedi la demo" : "Request the demo";
const fromPrice = lang === "it" ? "da €29 / host / mese" : "from €29 / host / month";
---
<section id={c.id} class:list={["sec", { "sec--tint": tint }]}>
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="shead-lead">{c.lead}</p>
    </div>

    <div class="pair">
      <article class="card card--product">
        <div class="card-top">
          <span class="mono tag tag--accent">{c.byoh.tag}</span>
          <a class="mono price-hint" href={pricing}>{fromPrice}</a>
        </div>
        <h3 class="ctitle">{c.byoh.title}</h3>
        <p class="desc">{c.byoh.desc}</p>
        <ul class="list">
          {c.byoh.ticks.map((t) => <li><span class="ck" aria-hidden="true">✓</span>{t}</li>)}
        </ul>
        <p class="note">{c.byoh.note}</p>
        <a class="btn btn--a" href="#contatto">{demoCta} <span class="arr" aria-hidden="true">→</span></a>
      </article>

      <article class="card card--service">
        <div class="card-top">
          <span class="mono tag tag--amber">{c.hosted.tag}</span>
          <span class="mono live"><span class="dot dot--live"></span>{c.hosted.host}</span>
        </div>
        <h3 class="ctitle">{c.hosted.title}</h3>
        <p class="desc">{c.hosted.desc}</p>
        <ul class="list list--amber">
          {c.hosted.ticks.map((t) => <li><span class="ck" aria-hidden="true">✓</span>{t}</li>)}
        </ul>
        <p class="note">{c.hosted.note}</p>
        <a class="btn btn--b" href={c.hosted.url} rel="noopener">{c.hosted.cta} <span class="arr" aria-hidden="true">↗</span></a>
      </article>
    </div>
  </div>
</section>

<style>
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2px; }
  .card { background: var(--ink); padding: 36px; display: flex; flex-direction: column; gap: 20px; border-top: 4px solid var(--accent); }
  .card--service { border-top-color: var(--amber); }
  .card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .tag { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .tag--accent { color: var(--accent); }
  .tag--amber { color: var(--amber-ink); }
  .price-hint { font-size: 12px; color: var(--fg-mid); }
  .price-hint:hover { color: var(--accent); }
  .live { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--fg-mid); }
  .ctitle { font-size: clamp(26px, 2.4vw, 32px); font-weight: 300; letter-spacing: -.02em; line-height: 1.12; }
  .desc { font-size: 15px; line-height: 1.6; color: var(--fg-mid); }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
  .list li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); font-size: 15px; color: var(--fg-dim); }
  .ck { color: var(--accent); }
  .list--amber .ck { color: #b87412; }
  .note { font-size: 13px; line-height: 1.55; color: var(--fg-faint); }
  .card .btn { margin-top: auto; }
  @media (max-width: 520px) { .card { padding: 24px 20px; } .pair { grid-template-columns: 1fr; } }
</style>
