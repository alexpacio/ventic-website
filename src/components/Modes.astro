---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].modes;
const cards = [c.byoh, c.paas];
---
<section id={c.id} class="sec">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="body lead-r">{c.lead}</p>
    </div>

    <div class="pair">
      {cards.map((m, i) => (
        <article class={`panel card ${i === 1 ? "panel--warm" : ""}`}>
          <div class={`panel-head ${i === 1 ? "panel-head--warm" : ""}`}>
            <span class={`mono tag ${i === 1 ? "tag--warm" : ""}`}>{m.tag}</span>
            <span class="rivet"></span>
          </div>
          <div class="body-in">
            <h3 class="ctitle">{m.title}</h3>
            <p class="desc">{m.desc}</p>
            <div class="sunk pricebox">
              <span class="mono plabel">{m.priceLabel}</span>
              <span class="prow">
                <span class="price pval">{m.price}</span>
                <span class="mono punit">{m.unit}</span>
              </span>
            </div>
            <ul class="ticks">
              {m.ticks.map((t) => <li class="tick">{t}</li>)}
            </ul>
            <p class="note">{m.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plate { margin-bottom: 16px; }
  .lead-r { max-width: 38ch; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .tag { font-size: 11px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: #a9a7a1; }
  .tag--warm { color: var(--accent); }
  .body-in { display: flex; flex-direction: column; gap: 16px; padding: 24px 22px; flex-grow: 1; }
  .ctitle { font-family: var(--display); font-size: clamp(30px, 3vw, 40px); font-weight: 700; line-height: 1; text-transform: uppercase; color: var(--fg-strong); }
  .desc { font-size: 16px; line-height: 1.62; color: var(--fg-dim); }
  .pricebox { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; }
  .plabel { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--fg-faint); }
  .prow { display: flex; align-items: baseline; gap: 8px; }
  .pval { font-size: clamp(30px, 3vw, 38px); color: var(--accent); }
  .punit { font-size: 14px; color: var(--fg-mute); }
  ul.ticks { list-style: none; margin: 0; padding: 0; }
  .note { margin-top: auto; padding-top: 6px; font-size: 14px; line-height: 1.5; color: var(--fg-faint); }
  @media (max-width: 860px) { .pair { grid-template-columns: 1fr; } }
</style>
