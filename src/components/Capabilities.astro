---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].caps;
const icons = ["restart", "users", "lock", "bars", "key", "power", "shield", "terminal", "cloud"];
---
<section id={c.id} class="sec">
  <div class="wrap">
    <div class="head">
      <div>
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <a class="btn btn--b" href="#contatto">{c.cta}</a>
    </div>
    <div class="cells">
      {c.items.map((it, i) => (
        <article class="panel cell">
          <Icon name={icons[i]} size={24} />
          <h3 class="cell-t">{it.title}</h3>
          <p class="cell-b">{it.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plate { margin-bottom: 16px; }
  .cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .cell { display: flex; flex-direction: column; gap: 12px; padding: 22px 20px; }
  @media (max-width: 1080px) { .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .cells { grid-template-columns: 1fr; } }
</style>
