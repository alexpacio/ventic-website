---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].adminPanel;
---
<section id={c.id} class="sec sec--tint">
  <div class="wrap">
    <div class="grid top">
      <div class="tcol">
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="body lcol">{c.lead}</p>
    </div>

    <div class="viewer" role="group" aria-label={c.plate}>
      {c.shots.map((s, i) => (
        <input class="pick" type="radio" name="ventic-shot" id={`shot-${s.id}`} checked={i === 0} />
      ))}

      <div class="tabs">
        {c.shots.map((s) => (
          <label class="tab" for={`shot-${s.id}`}>{s.tab}</label>
        ))}
      </div>

      <div class="frames">
        {c.shots.map((s, i) => (
          <figure class="frame">
            <div class="panel shot">
              <div class="panel-head chrome">
                <div class="grp">
                  <span class="rivet"></span>
                  <span class="mono host">{c.chrome}</span>
                </div>
                <div class="grp">
                  <span class="dot dot--live"></span>
                  <span class="rivet"></span>
                </div>
              </div>
              <img
                src={s.src}
                alt={s.alt}
                width={s.w}
                height={s.h}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
            <figcaption class="cap">
              <h3 class="cell-t">{s.title}</h3>
              <p class="cell-b">{s.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .top { align-items: end; margin-bottom: 44px; }
  .tcol, .lcol { grid-column: span 6; }
  .plate { margin-bottom: 22px; }

  /* radios drive the viewer; kept off-screen but focusable */
  .pick {
    position: absolute; width: 1px; height: 1px;
    margin: 0; padding: 0; border: 0;
    clip: rect(0 0 0 0); clip-path: inset(50%); overflow: hidden; white-space: nowrap;
  }

  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .tab {
    display: inline-flex; align-items: center; height: 44px; padding: 0 18px;
    border: 1px solid var(--line); border-radius: 2px;
    background: var(--panel-b);
    box-shadow: inset 0 1px 0 #ffffff0d;
    font-family: var(--mono); font-size: 12px; font-weight: 600;
    letter-spacing: .09em; text-transform: uppercase; color: var(--fg-mute);
    cursor: pointer; white-space: nowrap;
    transition: color .16s ease, border-color .16s ease;
  }
  .tab:hover { color: var(--fg-strong); border-color: #4a5158; }

  .frames { display: grid; }
  /* every frame occupies the same cell; only the checked one is painted */
  .frame {
    grid-area: 1 / 1; margin: 0;
    visibility: hidden; opacity: 0;
    transform: translateY(10px) scale(.994);
    transition:
      opacity .34s ease,
      transform .44s cubic-bezier(.2, .72, .28, 1),
      visibility 0s linear .44s;
  }

  .shot { padding: 0; overflow: hidden; }
  .chrome { padding: 12px 16px; }
  .grp { display: flex; align-items: center; gap: 9px; }
  .host { font-size: 11px; font-weight: 500; letter-spacing: .1em; color: var(--fg-faint); }

  .shot img { display: block; width: 100%; height: auto; border-top: 1px solid var(--line-soft); }

  .cap { display: flex; flex-direction: column; gap: 10px; max-width: 780px; margin-top: 26px; }

  .note {
    margin-top: 26px;
    font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-ghost);
  }

  .more { margin-top: 18px; }

  /* selected tab + matching frame, by position */
  .pick:nth-of-type(1):checked ~ .tabs .tab:nth-child(1),
  .pick:nth-of-type(2):checked ~ .tabs .tab:nth-child(2),
  .pick:nth-of-type(3):checked ~ .tabs .tab:nth-child(3),
  .pick:nth-of-type(4):checked ~ .tabs .tab:nth-child(4),
  .pick:nth-of-type(5):checked ~ .tabs .tab:nth-child(5) {
    color: #14161a;
    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
    border-color: #00000040;
    box-shadow: inset 0 1px 0 #ffffff59, 0 10px 24px -14px #000;
  }

  .pick:nth-of-type(1):checked ~ .frames .frame:nth-child(1),
  .pick:nth-of-type(2):checked ~ .frames .frame:nth-child(2),
  .pick:nth-of-type(3):checked ~ .frames .frame:nth-child(3),
  .pick:nth-of-type(4):checked ~ .frames .frame:nth-child(4),
  .pick:nth-of-type(5):checked ~ .frames .frame:nth-child(5) {
    visibility: visible; opacity: 1;
    transform: none;
    position: relative; z-index: 1;
    transition-delay: 0s, 0s, 0s;
  }

  /* a single sodium sweep across the panel as a screen settles in */
  .pick:nth-of-type(1):checked ~ .frames .frame:nth-child(1) .shot::after,
  .pick:nth-of-type(2):checked ~ .frames .frame:nth-child(2) .shot::after,
  .pick:nth-of-type(3):checked ~ .frames .frame:nth-child(3) .shot::after,
  .pick:nth-of-type(4):checked ~ .frames .frame:nth-child(4) .shot::after,
  .pick:nth-of-type(5):checked ~ .frames .frame:nth-child(5) .shot::after {
    animation: sweep .72s cubic-bezier(.3, .6, .2, 1);
  }

  .shot { position: relative; }
  .shot::after {
    content: ""; position: absolute; inset: 0;
    pointer-events: none; opacity: 0;
    background: linear-gradient(
      100deg,
      transparent 38%,
      #f5a83f14 48%,
      #f5a83f2e 52%,
      transparent 62%
    );
  }

  @keyframes sweep {
    0%   { opacity: 0; transform: translateX(-32%); }
    30%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(32%); }
  }

  /* keyboard focus lands on the hidden radio — show it on its label */
  .pick:nth-of-type(1):focus-visible ~ .tabs .tab:nth-child(1),
  .pick:nth-of-type(2):focus-visible ~ .tabs .tab:nth-child(2),
  .pick:nth-of-type(3):focus-visible ~ .tabs .tab:nth-child(3),
  .pick:nth-of-type(4):focus-visible ~ .tabs .tab:nth-child(4),
  .pick:nth-of-type(5):focus-visible ~ .tabs .tab:nth-child(5) {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }

  @media (max-width: 860px) {
    .tcol, .lcol { grid-column: span 6; }
    .tab { height: 42px; padding: 0 14px; font-size: 11px; letter-spacing: .06em; }
    .cap { margin-top: 20px; }
  }
</style>
