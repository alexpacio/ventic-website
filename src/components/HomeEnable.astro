---
import type { Lang } from "../i18n/content";
import { enable, teamEconomics, months } from "../i18n/economics";
import { why } from "../i18n/why";
interface Props { lang: Lang; num?: string; }
const { lang, num } = Astro.props;
const c = enable(lang);
const e = teamEconomics(20);
const hw = why(lang).hw;
---
<section class="sec sec--rule">
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br /><span class="h-accent">{c.title[1]}</span></h2>
      </div>
    </div>

    <ul class="grid">
      {c.items.map((x) => (
        <li>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d={x.icon} /></svg>
          <div><strong>{x.t}</strong><p>{x.b}</p></div>
        </li>
      ))}
    </ul>

    <h3 class="hw-label">{hw.label}</h3>
    <div class="hw">
      {hw.items.map((x) => (
        <figure>
          <img src={x.src} alt={x.alt} width="360" height="300" loading="lazy" />
          <figcaption><strong>{x.t}</strong><p>{x.b}</p></figcaption>
        </figure>
      ))}
    </div>

    <div class="srv">
      <div class="srv-a">
        <span class="plate plate--sm">{c.server.plate}</span>
        <p class="srv-t">{c.server.title}</p>
        <dl>{c.server.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <div class="srv-b on-dark">
        <span class="price">{c.server.price}</span>
        <p>{c.server.note(e.devsPerBox, months(lang, e.boxPayback))}</p>
        <a class="btn btn--a" href={c.server.href} rel="noopener" target="_blank">{c.server.cta} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .h-accent { color: var(--accent); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--fg-strong); }
  .grid li { display: flex; gap: 16px; padding: 22px 20px 22px 0; border-bottom: 1px solid var(--line-soft); color: var(--accent); }
  .grid strong { display: block; font-weight: 500; font-size: 16px; color: var(--fg-strong); margin-bottom: 4px; }
  .grid p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--fg-mid); }
  .grid svg { flex: none; }

  .hw-label { margin: 48px 0 0; padding-bottom: 12px; font-size: 13px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-mid); border-bottom: 1px solid var(--fg-strong); }
  .hw { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-bottom: 1px solid var(--line-soft); }
  .hw figure { margin: 0; padding: 24px 24px 24px 0; display: flex; gap: 20px; align-items: center; }
  .hw figure + figure { padding-left: 24px; border-left: 1px solid var(--line-soft); }
  .hw img { flex: none; width: 180px; height: auto; background: var(--deck); }
  .hw strong { display: block; font-weight: 500; font-size: 18px; color: var(--fg-strong); margin-bottom: 6px; }
  .hw p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--fg-mid); }
  .srv { margin-top: 40px; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); border: 1px solid var(--fg-strong); }
  .srv-a { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .srv-t { margin: 0; font-size: 24px; font-weight: 300; line-height: 1.25; color: var(--fg-strong); }
  .srv-a dl { margin: 0; }
  .srv-a dl div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--line-soft); font-size: 14px; }
  .srv-a dt { color: var(--fg-mid); }
  .srv-a dd { margin: 0; text-align: right; font-weight: 500; color: var(--fg-strong); }
  .srv-b { background: #161616; padding: 28px; display: flex; flex-direction: column; gap: 14px; justify-content: space-between; }
  .srv-b .price { font-size: 44px; color: #fff; }
  .srv-b p { margin: 0; font-size: 14px; line-height: 1.5; color: #c6c6c6; }
  .srv-b .btn { align-self: stretch; }

  @media (max-width: 1080px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .srv { grid-template-columns: 1fr; }
    .hw { grid-template-columns: 1fr; }
    .hw figure, .hw figure + figure { padding: 20px 0; border-left: 0; }
    .hw figure + figure { border-top: 1px solid var(--line-soft); }
    .hw img { width: 120px; }
    .srv-a, .srv-b { padding: 22px 16px; }
  }
</style>
