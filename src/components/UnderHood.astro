---
import { hood, miniArt } from "../i18n/onprem";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = hood(lang);
// gate values are illustrative, language-neutral identifiers
const gates = [
  { x: 136, label: "KEY", value: "sk-team-dev ✓" },
  { x: 232, label: "POLICY", value: "allow · €0.50" },
  { x: 328, label: "PII", value: "mario → ‹P1›" },
  { x: 424, label: "LEDGER", value: "€0.0042" },
];
---
<section id={c.id} class="sec">
  <div class="wrap">
    <div class="top">
      <div class="copy">
        <span class="plate">{c.plate}</span>
        <h2 class="h2 ttl">{c.title[0]}<br />{c.title[1]}</h2>
        <p class="lead">{c.lead}</p>
        <a class="btn btn--b" href="#schemi">{c.cta}</a>
      </div>

      <!-- blueprint art: a request crossing the control layers -->
      <svg class="art art--dark" viewBox="0 76 560 190" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="uh-g" x1="0" x2="1"><stop offset="0" stop-color="#f5a83f" /><stop offset="1" stop-color="#35cfa4" /></linearGradient>
          <pattern id="uh-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#ffffff0a" /></pattern>
        </defs>
        <rect width="560" height="300" fill="url(#uh-grid)" />
        <!-- straight track: client → 4 control gates → model; one packet loops through, each gate lights as it passes -->
        <path d="M40 150H520" stroke="#2a2e33" stroke-width="2" />
        <path class="flow" d="M40 150H520" stroke="url(#uh-g)" stroke-width="2" />
        <g font-family="var(--code)" font-size="9" letter-spacing="0.12em" fill="#8a8d92" text-anchor="middle">
          <rect x="30" y="140" width="20" height="20" fill="none" stroke="#f5a83f" /><text x="40" y="186">CLIENT</text>
          <rect x="510" y="140" width="20" height="20" fill="#35cfa4" fill-opacity=".15" stroke="#35cfa4" /><text x="520" y="186">MODEL</text>
        </g>
        {gates.map((g, i) => (
          <g class="gate" style={`--d:${(((g.x - 40) / 480) * 4.8 - 0.35).toFixed(2)}s`}>
            <rect class="gate-box" x={g.x - 34} y="116" width="68" height="68" />
            <text class="gate-n" x={g.x - 27} y="130">0{i + 1}</text>
            <rect class="gate-led" x={g.x - 4} y="146" width="8" height="8" />
            <text class="gate-l" x={g.x} y="210">{g.label}</text>
            <text class="gate-v" x={g.x} y="228">{g.value}</text>
          </g>
        ))}
        <rect class="pk" x="36" y="146" width="8" height="8" />
      </svg>
    </div>

    <div class="cells">
      {c.items.map((it, i) => (
        <article class="panel cell">
          <svg class="mini" viewBox="0 0 160 48" aria-hidden="true" set:html={miniArt[i]} />
          <span class="mono tag">{it.tag}</span>
          <h3 class="cell-t">{it.title}</h3>
          <p class="cell-b">{it.body}</p>
        </article>
      ))}
    </div>
    <p class="foot mono"><span class="dot dot--live"></span>{c.foot}</p>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: 40px; align-items: center; margin-bottom: 36px; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .ttl { margin-top: -4px; }
  .art { width: 100%; height: auto; background: var(--sunk); border: 1px solid var(--line-soft); border-radius: 0;  }
  .art--dark { background: var(--night); border-color: var(--night); }
  /* one 4.8s cycle: packet crosses the track, each gate's --d is when the packet reaches it */
  .flow { stroke-dasharray: 3 9; animation: uh-flow 1s linear infinite; }
  .pk { fill: #f5a83f; filter: drop-shadow(0 0 6px #f5a83f); animation: uh-pk 4.8s linear infinite; }
  .gate-box { fill: #16181b; stroke: #3d444b; animation: uh-box 4.8s ease-out var(--d) infinite; }
  .gate-led { fill: #5c5f63; animation: uh-led 4.8s ease-out var(--d) infinite; }
  .gate-n { font-family: var(--code); font-size: 8px; fill: #5c5f63; }
  .gate-l { font-family: var(--code); font-size: 10px; letter-spacing: .14em; fill: #c6c6c6; text-anchor: middle; }
  .gate-v { font-family: var(--code); font-size: 9px; fill: #6f6f6f; text-anchor: middle; animation: uh-val 4.8s ease-out var(--d) infinite; }
  @keyframes uh-flow { to { stroke-dashoffset: -12; } }
  @keyframes uh-pk { 0% { transform: translateX(0); fill: #f5a83f; opacity: 0; } 4% { opacity: 1; } 80% { fill: #f5a83f; } 92% { fill: #35cfa4; opacity: 1; } 100% { transform: translateX(480px); fill: #35cfa4; opacity: 0; } }
  @keyframes uh-box { 0% { stroke: #3d444b; fill: #16181b; } 6% { stroke: #f5a83f; fill: #251d12; } 30%, 100% { stroke: #3d444b; fill: #16181b; } }
  @keyframes uh-led { 0%, 4% { fill: #5c5f63; } 8%, 60% { fill: #35cfa4; } 100% { fill: #5c5f63; } }
  @keyframes uh-val { 0%, 4% { fill: #6f6f6f; } 8%, 50% { fill: #f4f4f4; } 100% { fill: #6f6f6f; } }
  .cells { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .cell { display: flex; flex-direction: column; gap: 10px; padding: 20px; }
  .mini { width: 100%; height: 48px; margin-bottom: 6px; padding-bottom: 12px; border-bottom: 1px solid var(--line-soft); }
  .tag { font-size: 10px; letter-spacing: .14em; color: var(--accent); }
  .foot { display: flex; align-items: center; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line-soft); font-size: 12px; line-height: 1.6; color: var(--fg-mute); }
  .foot .dot { flex-shrink: 0; }
  @media (max-width: 1160px) { .cells { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr; } .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cells { grid-template-columns: 1fr; } }
</style>
