---
import { hood, miniArt } from "../i18n/onprem";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = hood(lang);
---
<section id={c.id} class="sec">
  <div class="wrap">
    <div class="top">
      <div class="copy">
        <span class="plate">{c.plate}</span>
        <h2 class="h2 ttl">{c.title[0]}<br />{c.title[1]}</h2>
        <p class="lead">{c.lead}</p>
        <a class="btn btn--b" href="#schemi">{c.cta}</a>
      </div>

      <!-- blueprint art: a request crossing the control layers -->
      <svg class="art art--dark" viewBox="0 0 560 300" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="uh-g" x1="0" x2="1"><stop offset="0" stop-color="#f5a83f" stop-opacity="0" /><stop offset="0.5" stop-color="#f5a83f" /><stop offset="1" stop-color="#35cfa4" /></linearGradient>
          <pattern id="uh-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#ffffff0a" /></pattern>
        </defs>
        <rect width="560" height="300" fill="url(#uh-grid)" />
        {[0, 1, 2, 3].map((i) => (
          <g transform={`translate(${70 + i * 118} 0)`}>
            <path d="M0 70 60 40 120 70 60 100Z" fill="none" stroke="#32373d" transform="translate(-30 40)" />
            <path d="M-30 110v90l60 30 60-30v-90" fill="#16181b" stroke="#3d444b" transform="translate(0 0)" />
            <path d="M-30 110 30 140 90 110 30 80Z" fill="#1d2126" stroke={i === 1 ? "#f5a83f" : "#3d444b"} />
            <path d="M30 140v90" stroke="#262a2f" />
            <circle cx="30" cy="110" r="3" fill={i === 1 ? "#f5a83f" : "#5c5f63"} />
          </g>
        ))}
        <path d="M20 150C120 150 130 110 200 110S320 160 380 130 470 120 545 150" fill="none" stroke="url(#uh-g)" stroke-width="2.2" stroke-dasharray="1 0" />
        <g class="mono" font-size="9.5" letter-spacing="0.14em" fill="#8a8d92">
          <text x="36" y="268">KEY</text><text x="154" y="268">POLICY</text><text x="272" y="268">PII</text><text x="390" y="268">LEDGER</text>
        </g>
        <circle cx="20" cy="150" r="5" fill="#f5a83f" /><circle cx="545" cy="150" r="5" fill="#35cfa4" />
      </svg>
    </div>

    <div class="cells">
      {c.items.map((it, i) => (
        <article class="panel cell">
          <svg class="mini" viewBox="0 0 160 48" aria-hidden="true" set:html={miniArt[i]} />
          <span class="mono tag">{it.tag}</span>
          <h3 class="cell-t">{it.title}</h3>
          <p class="cell-b">{it.body}</p>
        </article>
      ))}
    </div>
    <p class="foot mono"><span class="dot dot--live"></span>{c.foot}</p>
  </div>
</section>

<style>
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: 40px; align-items: center; margin-bottom: 36px; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .ttl { margin-top: -4px; }
  .art { width: 100%; height: auto; background: var(--sunk); border: 1px solid var(--line-soft); border-radius: 0;  }
  .art--dark { background: var(--night); border-color: var(--night); }
  .cells { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .cell { display: flex; flex-direction: column; gap: 10px; padding: 20px; }
  .mini { width: 100%; height: 48px; margin-bottom: 6px; padding-bottom: 12px; border-bottom: 1px solid var(--line-soft); }
  .tag { font-size: 10px; letter-spacing: .14em; color: var(--accent); }
  .foot { display: flex; align-items: center; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line-soft); font-size: 12px; line-height: 1.6; color: var(--fg-mute); }
  .foot .dot { flex-shrink: 0; }
  @media (max-width: 1160px) { .cells { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr; } .cells { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cells { grid-template-columns: 1fr; } }
</style>
