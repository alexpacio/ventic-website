---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].problem;
---
<section id={c.id} class="sec prob">
  <span class="hazard" aria-hidden="true"></span>
  <div class="wrap">
    <div class="grid top">
      <div class="tcol">
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="body lcol">{c.lead}</p>
    </div>
    <div class="cards">
      {c.cards.map((card) => (
        <article class="panel card">
          <span class="idx">{card.tag.toUpperCase()}</span>
          <h3 class="card-title">{card.title}</h3>
          <p class="cell-b">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .prob { position: relative; background: var(--deck); }
  .hazard { position: absolute; inset: 0 0 auto 0; }
  .top { align-items: end; margin-bottom: 54px; }
  .tcol { grid-column: span 7; }
  .lcol { grid-column: span 5; }
  .plate { margin-bottom: 22px; }
  .card { display: flex; flex-direction: column; padding: 28px 26px 30px; }
  .card-title { margin: 18px 0 12px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1080px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .tcol, .lcol { grid-column: span 6; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
