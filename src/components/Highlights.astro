---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = content[lang].highlights;
---
<section class="hl-sec">
  <div class="wrap">
    <ul class="list hairgrid">
      {items.map((it) => (
        <li class="item">
          <Icon name={it.icon} size={24} width={1.6} />
          <h3 class="cell-t">{it.title}</h3>
          <p class="cell-b">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hl-sec { padding: 0; border-bottom: 1px solid var(--line-soft); }
  .hl-sec .wrap { padding-top: 0; padding-bottom: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 0; border-bottom: 0; }
    .item { padding: 40px 32px 44px; display: flex; flex-direction: column; gap: 14px; min-height: 240px; }
  .item :global(svg) { color: var(--accent); margin-bottom: 20px; }
  .item h3 { font-weight: 500; }

  @media (max-width: 1080px) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .list { grid-template-columns: minmax(0, 1fr); }
    .item { padding: 28px 20px 32px; min-height: 0; gap: 10px; }
  }
</style>
