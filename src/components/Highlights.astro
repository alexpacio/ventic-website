---
import Icon from "./Icon.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const items = content[lang].highlights;
---
<section class="hl-sec">
  <div class="wrap">
    <ul class="list">
      {items.map((it) => (
        <li class="item">
          <Icon name={it.icon} size={24} width={1.6} />
          <h3 class="cell-t">{it.title}</h3>
          <p class="cell-b">{it.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hl-sec { padding: 72px 0 88px; border-bottom: 1px solid var(--line-dim); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .item h3 { text-transform: none; }
  .item { padding-top: 24px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }

  @media (max-width: 1080px) {
    .hl-sec { padding: 56px 0 64px; }
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
  }
  @media (max-width: 560px) {
    .hl-sec { padding: 48px 0 56px; }
    .list { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .item { padding-top: 20px; gap: 10px; }
  }
</style>
