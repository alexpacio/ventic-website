---
import { content, type Lang } from "../i18n/content";
import ObfuscatedEmail from "./ObfuscatedEmail.astro";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].cta as typeof content["it"]["cta"] & { mailPrefix?: string };
const mailPrefix = (c as any).mailPrefix ?? "";
/* decorative pixel field: deterministic pattern, drawn once */
const cells = Array.from({ length: 64 }, (_, i) => {
  const x = i % 8, y = Math.floor(i / 8);
  return (x + y * 3) % 5 === 0 || (x > 4 && (x * y) % 3 === 0);
});
---
<section id="contatto" class="band">
  <div class="pixels" aria-hidden="true">
    {cells.map((on, i) => <span class:list={{ on }} style={`animation-delay:${((i % 8) + Math.floor(i / 8)) * 0.15}s`}></span>)}
  </div>
  <div class="wrap inner vt-reveal">
    <span class="plate">{c.plate}</span>
    <h2 class="h2-big">{c.title[0]}<br />{c.title[1]}</h2>
    <p class="lead measure">{c.body}</p>
    <div class="actions">
      <ObfuscatedEmail label={c.btn} lang={lang} class="btn btn--light" />
      <ObfuscatedEmail prefix={mailPrefix} lang={lang} class="btn btn--b" />
    </div>
  </div>
</section>

<style>
  .band { position: relative; overflow: hidden; background: var(--accent); color: #fff; padding: 112px 0; }
  .pixels { position: absolute; right: 0; top: 0; bottom: 0; width: 40%; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 3px; padding: 3px; opacity: .35; }
  .pixels span { border: 1px solid rgba(255,255,255,.35); }
  .pixels span.on { background: #fff; animation: vt-wave 5s ease-in-out infinite; }
  .inner { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .plate { color: rgba(255,255,255,.85); }
  .h2-big { color: #fff; max-width: 18ch; }
  .lead { color: #e6ebfd; max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 2px; margin-top: 8px; }
  .actions :global(.btn) { min-width: 220px; }
  .band { --wipe: #fff; }
  .band :global(.btn--b) { --btn-bg-h: #000; }
  @media (max-width: 860px) { .band { padding: 72px 0; } .pixels { width: 55%; opacity: .2; } }
  @media (max-width: 520px) { .actions { width: 100%; } .actions :global(.btn) { width: 100%; } }
</style>
