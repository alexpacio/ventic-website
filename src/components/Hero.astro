---
import PlatformShots from "./PlatformShots.astro";
import AlphaStamp from "./AlphaStamp.astro";
import ObfuscatedEmail from "./ObfuscatedEmail.astro";
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const h = content[lang].hero;
const how = lang === "it" ? "/#come-funziona" : "/en/#how-it-works";
---
<section class="hero">
  <div class="alpha-hero-stamp" aria-hidden="true"><AlphaStamp variant="stamp" size="md" lang={lang} /></div>
  <div class="wrap grid inner">
    <div class="copy">
      <span class="plate plate--accent">
        <span class="dot" style="width:6px;height:6px;box-shadow:none"></span>
        {h.plate}
      </span>
      <div class="hook measure">
        {h.hook.map((q) => <p>{q}</p>)}
      </div>
      <p class="punch">{h.punch}</p>
      <h1 class="h1">
        {h.title[0]}<br /><span class="hl">{h.title[1]}</span>
      </h1>
      <p class="lead measure">{h.lead}</p>
      <p class="sub measure">{h.sub}</p>
      <ul class="features measure">
        {h.features.map((f) => <li><span class="dot dot--live" style="width:6px;height:6px"></span>{f}</li>)}
      </ul>
      <div class="alpha measure">
        <AlphaStamp variant="inline" lang={lang} />
        <p><strong>{h.alphaTitle}</strong> {h.alphaPre} <ObfuscatedEmail lang={lang} class="mono link-inline" /> {h.alphaPost}</p>
      </div>
      <div class="actions">
        <a class="btn btn--a" href="#contatto">{h.cta1}</a>
        <a class="btn btn--b" href={how}>{h.cta2}</a>
      </div>
    </div>
    <div class="slidecol"><PlatformShots lang={lang} /></div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; padding: 48px 0 44px;
    background:
      radial-gradient(900px 520px at 78% 18%, rgba(245,168,63,0.10) 0%, transparent 62%),
      radial-gradient(800px 460px at 12% 88%, rgba(53,207,164,0.07) 0%, transparent 60%),
      radial-gradient(700px 400px at 50% -10%, #1c1f24 0%, transparent 58%),
      var(--ink);
    border-bottom: 1px solid var(--line-dim);
  }
  .inner { position: relative; align-items: start; }
  .copy { grid-column: span 6; }
  .slidecol { grid-column: span 6; min-width: 0; }

  .plate { margin-bottom: 16px; }
  .h1 { margin: 0; }
  .hl { color: var(--accent); }
  .measure { max-width: 48ch; }
  .hook { display: grid; gap: 10px; }
  .hook p { font-size: 15px; line-height: 1.6; color: var(--fg-mid); }
  .punch { margin: 14px 0 18px; font-family: var(--display); font-size: clamp(20px, 1.8vw, 24px); font-weight: 700; color: var(--accent); }
  .lead { margin-top: 18px; font-size: clamp(18px, 1.5vw, 20px); line-height: 1.6; }
  .sub { margin-top: 10px; font-size: 15px; line-height: 1.6; color: var(--fg-mute); max-width: 48ch; }
  .features { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  .features li { display: flex; align-items: baseline; gap: 10px; font-size: 15px; line-height: 1.5; color: var(--fg-dim); }
  .features .dot { flex: none; transform: translateY(-2px); }
  .alpha { display: flex; align-items: flex-start; gap: 12px; margin-top: 20px; padding: 12px 14px; background: rgba(229,62,62,0.06); border: 1px solid rgba(229,62,62,0.18); border-radius: 2px; }
  .alpha p { font-size: 14px; line-height: 1.55; color: var(--fg-dim); }
  .alpha strong { color: var(--fg-strong); }
  :global(.link-inline) { color: var(--accent) !important; text-underline-offset: 3px; }
  :global(.link-inline:hover) { text-decoration: underline; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
  .alpha-hero-stamp { position: absolute; top: 22px; right: 24px; z-index: 2; opacity: .92; filter: drop-shadow(0 2px 10px rgba(229,62,62,0.18)); }
  @media (max-width: 1080px) { .alpha-hero-stamp { top: 14px; right: 14px; transform: scale(0.85); transform-origin: top right; } }
  @media (max-width: 860px) { .alpha-hero-stamp { display: none; } }

  @media (max-width: 1080px) {
    .copy { grid-column: span 12; }
    .slidecol { grid-column: span 12; }
  }
  @media (max-width: 860px) {
    .hero { padding: 32px 0 36px; }
    .copy, .slidecol { grid-column: span 6; }
    .actions .btn { flex-grow: 1; }
  }
</style>
