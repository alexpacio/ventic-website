---
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";
import { content, alternatePath, type Lang } from "../i18n/content";
import { navGroups, homePath } from "../i18n/pages";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].nav;
const home = homePath(lang);
const contact = lang === "en" ? "/en/contatti/" : "/contatti/";
const here = Astro.url.pathname;
const other: Lang = lang === "it" ? "en" : "it";
const otherHref = alternatePath(here, other);
const groups = navGroups(lang);
const isActive = (g: (typeof groups)[number]) => g.href === here || !!g.items?.some((i) => i.href === here);
---
<a class="skip" href="#main">{c.skip}</a>
<header class="bar">
  <div class="wrap inner">
    <a class="brand" href={home} aria-label="Ventic">
      <Wordmark height={20} />
    </a>

    <nav class="links" aria-label="Ventic" data-nav>
      {groups.map((g, i) =>
        g.items ? (
          <div class="group" data-group>
            <button
              type="button"
              class="navlink trigger"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls={`pop-${i}`}
              data-active={isActive(g) ? "true" : undefined}
            >
              {g.label}
              <span class="chev"><Icon name="chevron" size={14} stroke="currentColor" width={1.8} /></span>
            </button>
            <div class="pop" id={`pop-${i}`}>
              <div class="wrap pop-in">
                {g.items.map((it, j) => (
                  <a class="item" href={it.href} style={`--i:${j}`} aria-current={here === it.href ? "page" : undefined}>
                    <span class="item-t">{it.label}</span>
                    {it.desc && <span class="item-d">{it.desc}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a class="navlink" href={g.href} aria-current={here === g.href ? "page" : undefined} data-active={isActive(g) ? "true" : undefined}>{g.label}</a>
        )
      )}
    </nav>

    <div class="right">
      <a class="navlink lang" href={otherHref} hreflang={other} aria-label={`${c.langLabel}: ${other.toUpperCase()}`}>
        <Icon name="globe" size={15} stroke="currentColor" width={1.4} />
        {other.toUpperCase()}
      </a>
      <a class="btn btn--a btn--sm cta" href={contact}>{c.cta}</a>
      <details class="menu">
        <summary aria-label="Menu"><Icon name="menu" size={22} stroke="var(--fg-mute)" width={1.6} /></summary>
        <div class="drawer">
          {groups.map((g, i) =>
            g.items ? (
              <div class="dgroup" style={`--i:${i}`}>
                <span class="dlabel">{g.label}</span>
                {g.items.map((it) => (
                  <a class="drawerlink" href={it.href} aria-current={here === it.href ? "page" : undefined}>{it.label}</a>
                ))}
              </div>
            ) : (
              <div class="dgroup" style={`--i:${i}`}>
                <a class="drawerlink drawerlink--top" href={g.href} aria-current={here === g.href ? "page" : undefined}>{g.label}</a>
              </div>
            )
          )}
          <div class="dgroup dgroup--foot" style={`--i:${groups.length}`}>
            <a class="drawerlink" href={otherHref} hreflang={other}>{c.langLabel}: {other.toUpperCase()}</a>
            <a class="drawerlink drawerlink--cta" href={contact}>{c.cta}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Dropdowns: open on hover (CSS), click/Enter/Space or ArrowDown (JS); Escape and outside click close.
  const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
  const setOpen = (g: HTMLElement, open: boolean) => {
    g.toggleAttribute("data-open", open);
    // closing while the pointer rests on the group must beat the :hover rule until the pointer leaves
    g.toggleAttribute("data-dismissed", !open && g.matches(":hover"));
    g.querySelector("button")?.setAttribute("aria-expanded", String(open));
  };
  const closeAll = (except?: HTMLElement) => groups.forEach((g) => g !== except && setOpen(g, false));

  groups.forEach((g) => {
    const btn = g.querySelector<HTMLButtonElement>("button")!;
    const links = () => [...g.querySelectorAll<HTMLAnchorElement>(".pop a")];
    btn.addEventListener("click", () => {
      const open = !g.hasAttribute("data-open");
      closeAll(g);
      setOpen(g, open);
    });
    g.addEventListener("mouseenter", () => closeAll(g));
    g.addEventListener("mouseleave", () => {
      g.removeAttribute("data-dismissed");
      if (!g.contains(document.activeElement)) setOpen(g, false);
      g.removeAttribute("data-dismissed");
    });
    g.addEventListener("keydown", (e) => {
      const items = links();
      const i = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === "Escape") { setOpen(g, false); btn.focus(); }
      else if (e.key === "ArrowDown") { e.preventDefault(); setOpen(g, true); items[(i + 1) % items.length]?.focus(); }
      else if (e.key === "ArrowUp" && i >= 0) { e.preventDefault(); (i === 0 ? btn : items[i - 1]).focus(); }
    });
    g.addEventListener("focusout", (e) => {
      if (!g.contains((e as FocusEvent).relatedTarget as Node | null)) setOpen(g, false);
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest("[data-group]")) closeAll();
  });

  // Mobile drawer closes when a link is chosen or the page is clicked elsewhere.
  const menu = document.querySelector<HTMLDetailsElement>("details.menu");
  menu?.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) menu.open = false; });
  document.addEventListener("click", (e) => { if (menu?.open && !menu.contains(e.target as Node)) menu.open = false; });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu?.open) menu.open = false; });

  // Bar slides away while scrolling down, returns on any scroll up.
  const bar = document.querySelector<HTMLElement>("header.bar")!;
  let lastY = scrollY;
  addEventListener("scroll", () => {
    const y = scrollY;
    if (Math.abs(y - lastY) < 6) return;
    bar.toggleAttribute("data-hidden", y > lastY && y > 120);
    lastY = y;
  }, { passive: true });
</script>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 60;
    background: var(--accent); color: #fff; padding: 10px 16px;
    font-family: var(--sans); font-size: 14px; font-weight: 500;
  }
  .skip:focus { left: 0; }

  .bar {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--line-soft);
    background: #fff; /* opaque: a frosted bar smeared blue CTAs into a blob behind the menu */
    overflow-x: clip; /* the drawer slides in from off-screen right */
    transition: translate .3s ease;
  }
  .bar[data-hidden]:not(:focus-within):not(:has(.menu[open], .group[data-open])) { translate: 0 -100%; }
  /* page dims behind an open dropdown */
  .bar::after {
    content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 100vh; z-index: 1;
    background: rgba(22,22,22,.35); opacity: 0; pointer-events: none; transition: opacity .45s ease;
  }
  .bar:has(.group[data-open], .group:not([data-dismissed]):hover)::after { opacity: 1; transition-duration: .3s; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 64px; }

  .brand { display: flex; align-items: center; gap: 10px; color: var(--fg-strong); flex-shrink: 0; }
  .brand:hover { color: var(--fg-strong); }

  .links { display: flex; align-items: center; align-self: stretch; gap: 6px; flex: 1; margin-left: 28px; }
  /* siblings step back while one entry is hovered or open */
  .links .navlink { transition: color .2s ease, opacity .15s ease; }
  .links:has(.navlink:hover, .group:hover, .group[data-open]) .navlink { opacity: .55; }
  .links .navlink:hover, .links .group:hover > .trigger, .links .group[data-open] > .trigger { opacity: 1; }
  .right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

  .navlink {
    position: relative;
    display: inline-flex; align-items: center; gap: 7px; height: 44px; padding: 0 12px;
    font-family: var(--sans); font-size: 14px; font-weight: 400;
    letter-spacing: 0; color: var(--fg-dim);
    white-space: nowrap; background: none; border: 0; cursor: pointer;
  }
  .navlink:hover, .group[data-open] > .trigger, .group:not([data-dismissed]):hover > .trigger { color: var(--fg-strong); }
  .navlink[data-active="true"] { color: var(--fg-strong); }
  .navlink[data-active="true"]::after {
    content: ""; position: absolute; left: 12px; right: 12px; bottom: -10px; height: 2px; background: var(--accent);
  }
  .lang { padding: 0; }

  /* dropdown: full-width panel unrolls from the bar; the group spans the bar's height so the pointer never leaves it */
  .group { display: flex; align-items: center; align-self: stretch; }
  .chev { display: inline-flex; transition: transform .45s var(--ease-nav); }
  .group[data-open] .chev, .group:not([data-dismissed]):hover .chev { transform: rotate(180deg); }
  .pop {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 2;
    background: var(--ink); border-bottom: 1px solid var(--line-soft);
    visibility: hidden; clip-path: inset(0 0 100% 0);
    transition: clip-path .45s var(--ease-nav), visibility 0s linear .45s;
  }
  .group:not([data-dismissed]):hover > .pop, .group[data-open] > .pop {
    visibility: visible; clip-path: inset(0); transition: clip-path .45s var(--ease-nav);
  }
  .pop-in { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2px; padding-top: 20px; padding-bottom: 28px; }
  .group:not([data-dismissed]):hover .item, .group[data-open] .item { animation: vt-rise .5s var(--ease) both; animation-delay: calc(var(--i) * 45ms + .08s); }
  .item {
    display: flex; flex-direction: column; gap: 3px; padding: 12px 14px;
    border-left: 2px solid transparent; color: var(--fg-dim);
  }
  .item:hover, .item:focus-visible { background: rgba(22,22,22,.04); border-left-color: var(--accent); }
  .item[aria-current="page"] { border-left-color: var(--accent); background: rgba(22,22,22,.03); }
  .item-t {
    font-family: var(--sans); font-size: 15px; font-weight: 500;
    letter-spacing: 0; color: var(--fg-strong);
  }
  .item-d { font-size: 13px; line-height: 1.4; color: var(--fg-mute); }

  /* mobile drawer */
  .menu { display: none; }
  .menu > summary { list-style: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; cursor: pointer; }
  .menu > summary::-webkit-details-marker { display: none; }
  /* full-height sheet under the bar, slides in from the right; groups rise in after it */
  .drawer {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 2;
    display: flex; flex-direction: column; height: calc(100dvh - 60px);
    overflow-y: auto; padding: 6px 0 32px; background: var(--ink); border-top: 1px solid var(--line-soft);
    transition: translate .45s var(--ease-nav);
  }
  @starting-style { .menu[open] .drawer { translate: 100% 0; } }
  .menu[open] .dgroup { animation: vt-rise .5s var(--ease) both; animation-delay: calc(var(--i, 0) * 60ms + .15s); }
  .dgroup { display: flex; flex-direction: column; padding: 8px 0; border-bottom: 1px solid var(--line-soft); }
  .dgroup:last-child { border-bottom: 0; }
  .dlabel {
    padding: 6px 20px 4px; font-family: var(--mono); font-size: 11px; font-weight: 400;
    letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute);
  }
  .drawerlink {
    padding: 11px 20px 11px 28px; border-left: 2px solid transparent;
    font-family: var(--sans); font-size: 15px; font-weight: 400;
    letter-spacing: 0; color: var(--fg-dim);
  }
  .drawerlink--top { padding-left: 20px; color: var(--fg-strong); }
  .drawerlink:hover { color: var(--fg-strong); background: rgba(22,22,22,.04); }
  .drawerlink[aria-current="page"] { color: var(--accent); border-left-color: var(--accent); }
  .drawerlink--cta { color: var(--accent); padding-left: 20px; }
  .dgroup--foot .drawerlink:first-child { padding-left: 20px; }

  @media (max-width: 1100px) {
    :global(html:has(.menu[open])) { overflow: hidden; }
    .inner { height: 60px; }
    .links, .lang { display: none; }
    .menu { display: block; }
    .cta { display: inline-flex; }
  }
  @media (max-width: 520px) {
    .cta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .chev, .bar, .pop, .drawer { transition: none; } }
</style>
