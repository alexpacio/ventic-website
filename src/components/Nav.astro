---
import Wordmark from "./Wordmark.astro";
import AlphaStamp from "./AlphaStamp.astro";
import Icon from "./Icon.astro";
import { content, alternatePath, type Lang } from "../i18n/content";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].nav;
const home = lang === "it" ? "/" : "/en/";
const other: Lang = lang === "it" ? "en" : "it";
const otherHref = alternatePath(Astro.url.pathname, other);
---
<a class="skip" href="#main">{c.skip}</a>
<header class="bar">
  <div class="wrap inner">
    <a class="brand" href={home} aria-label="Ventic">
      <Wordmark height={20} />
      <span class="nav-alpha"><AlphaStamp variant="badge" size="sm" lang={lang} /></span>
    </a>

    <nav class="links" aria-label="Ventic">
      {c.links.map((l) => <a class="navlink" href={l.href}>{l.label}</a>)}
    </nav>

    <div class="right">
      <a class="navlink lang" href={otherHref} hreflang={other} aria-label={`${c.langLabel}: ${other.toUpperCase()}`}>
        <Icon name="globe" size={15} stroke="currentColor" width={1.4} />
        {other.toUpperCase()}
      </a>
      <a class="btn btn--a btn--sm cta" href="#contatto">{c.cta}</a>
      <details class="menu">
        <summary aria-label="Menu"><Icon name="menu" size={22} stroke="var(--fg-mute)" width={1.6} /></summary>
        <div class="drawer panel">
          {c.links.map((l) => <a class="drawerlink" href={l.href}>{l.label}</a>)}
          <a class="drawerlink" href={otherHref} hreflang={other}>{other.toUpperCase()}</a>
          <a class="drawerlink drawerlink--cta" href="#contatto">{c.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute; left: -9999px; top: 0; z-index: 60;
    background: var(--accent); color: #14161a; padding: 10px 16px;
    font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .08em;
  }
  .skip:focus { left: 0; }

  .bar {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--line-dim);
    background: #0e0f11e6;
    backdrop-filter: blur(10px);
  }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 64px; }

  .brand { display: flex; align-items: center; gap: 10px; color: var(--fg-strong); flex-shrink: 0; }
  .brand:hover { color: var(--fg-strong); }
  .nav-alpha { display: inline-flex; margin-left: 2px; transform: translateY(1px); }

  .links { display: flex; align-items: center; gap: 26px; flex-wrap: nowrap; }
  .right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }

  .navlink {
    display: inline-flex; align-items: center; gap: 7px; height: 44px;
    font-family: var(--mono); font-size: 12px; font-weight: 500;
    letter-spacing: .09em; text-transform: uppercase; color: var(--fg-mute);
    white-space: nowrap;
  }
  .navlink:hover { color: var(--fg-strong); }

  .menu { display: none; position: relative; }
  .menu > summary { list-style: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; cursor: pointer; }
  .menu > summary::-webkit-details-marker { display: none; }
  .drawer {
    position: absolute; right: 0; top: 50px; z-index: 40;
    display: flex; flex-direction: column; min-width: 240px; padding: 8px 0;
  }
  .drawerlink {
    padding: 13px 20px;
    font-family: var(--mono); font-size: 12px; font-weight: 500;
    letter-spacing: .1em; text-transform: uppercase; color: var(--fg-dim);
  }
  .drawerlink:hover { color: var(--fg-strong); background: #ffffff08; }
  .drawerlink--cta { color: var(--accent); border-top: 1px solid var(--line-soft); margin-top: 6px; padding-top: 16px; }

  @media (max-width: 1160px) {
    .links { gap: 18px; }
  }
  @media (max-width: 980px) {
    .links { gap: 14px; }
    .links .navlink { font-size: 11px; letter-spacing: .07em; }
  }
  @media (max-width: 900px) {
    .inner { height: 60px; }
    .links, .lang { display: none; }
    .menu { display: block; }
    .cta { display: inline-flex; }
  }
  @media (max-width: 520px) {
    .cta { display: none; }
  }
</style>
