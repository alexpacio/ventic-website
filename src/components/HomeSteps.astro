---
import type { Lang } from "../i18n/content";
import { home } from "../i18n/home";
interface Props { lang: Lang; num?: string; }
const { lang, num } = Astro.props;
const c = home(lang).steps;
const href = home(lang).hero.how;
const tones = ["var(--accent)", "#161616", "var(--jade)"];
---
<section id={c.id} class="sec sec--rule">
  <div class="wrap vt-reveal">
    <div class="intro">
      <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
      <h2 class="h2">{c.title[0]} <span class="hl">{c.title[1]}</span></h2>
      <p class="lead">{c.lead}</p>
      <a class="arrowlink" href={href}>{c.link} <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <ol class="steps" data-stagger>
      {c.items.map((s, i) => (
        <li class="step">
          <div class="step-head">
            <span class="mono num" style={`background:${tones[i]}`}>0{i + 1}</span>
            <span class="rule" aria-hidden="true"></span>
          </div>
          <h3 class="card-title">{s.title}</h3>
          <p class="cell-b">{s.body}</p>
          <pre class="code">{s.code}</pre>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .intro { max-width: 760px; margin-bottom: 56px; display: flex; flex-direction: column; gap: 20px; }
  .intro .plate { margin-bottom: -4px; }
  .arrowlink { align-self: flex-start; border-bottom: 2px solid var(--accent); color: var(--fg-strong); }
  .arrowlink .arr { color: var(--accent); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--fg-strong); }
  .step { padding: 28px 28px 8px 0; display: flex; flex-direction: column; gap: 16px; }
  .step-head { display: flex; align-items: center; gap: 12px; }
  .num { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; color: #fff; }
  .rule { flex: 1; height: 1px; background: var(--line); }
  .code { margin-top: auto; }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr; } .step { padding-right: 0; } }
</style>
