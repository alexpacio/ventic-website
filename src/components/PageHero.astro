---
import { pages, type PageKey } from "../i18n/pages";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const c = pages(lang)[page].hero;
---
<section class="phero">
  <div class="wrap inner">
    <div>
      <span class="plate">{c.plate}</span>
      <h1 class="h2-big">{c.title[0]}<br />{c.title[1]}</h1>
    </div>
    <p class="body measure">{c.lead}</p>
  </div>
</section>

<style>
  .phero { padding: 96px 0 56px; border-bottom: 1px solid var(--line-soft); }
  .inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .plate { margin-bottom: 24px; }
  .measure { max-width: 40ch; }
  @media (max-width: 900px) {
    .phero { padding: 56px 0 40px; }
    .inner { flex-direction: column; align-items: flex-start; gap: 20px; }
  }
</style>
