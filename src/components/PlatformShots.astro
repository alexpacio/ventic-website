---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].heroShots;
const shots = content[lang].adminPanel.shots;
const label = lang === "it" ? "Schermate del portale" : "Portal screens";
---
<div class="ps" data-shots style="--ps-dur:5.5s">
  <div class="tabs" role="tablist" aria-label={label}>
    {shots.map((s, i) => (
      <button type="button" role="tab" class="tab" id={`ps-tab-${s.id}`} aria-controls={`ps-shot-${s.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-i={i}>
        <span class="tab-n mono">0{i + 1}</span>
        <span class="tab-c">
          <span class="tab-t">{s.tab}</span>
          <span class="tab-b">{s.title}</span>
        </span>
        <span class="bar" aria-hidden="true"><span></span></span>
      </button>
    ))}
  </div>

  <figure class="win">
    <div class="chrome" aria-hidden="true">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="url mono"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="5" y="11" width="14" height="10" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>{c.host}</span>
    </div>
    <div class="stage">
      {shots.map((s, i) => (
        <img
          class="shot"
          id={`ps-shot-${s.id}`}
          role="tabpanel"
          aria-labelledby={`ps-tab-${s.id}`}
          data-on={i === 0 ? "" : undefined}
          src={s.src}
          alt={s.alt}
          width={s.w}
          height={s.h}
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      ))}
    </div>
    <figcaption class="cap">
      {shots.map((s, i) => <p data-on={i === 0 ? "" : undefined}>{s.body}</p>)}
    </figcaption>
  </figure>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-shots]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const imgs = Array.from(root.querySelectorAll<HTMLElement>(".shot"));
    const caps = Array.from(root.querySelectorAll<HTMLElement>(".cap p"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = 0;

    const go = (i: number, focus = false) => {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === cur)); t.tabIndex = k === cur ? 0 : -1; });
      [imgs, caps].forEach((set) => set.forEach((el, k) => el.toggleAttribute("data-on", k === cur)));
      if (focus) tabs[cur].focus();
    };

    // the active tab's progress bar is the timer: when it fills, advance
    root.addEventListener("animationend", (e) => { if ((e.target as HTMLElement).closest(".bar")) go(cur + 1); });
    tabs.forEach((t, k) => t.addEventListener("click", () => { root.classList.add("manual"); go(k); }));
    root.querySelector(".tabs")!.addEventListener("keydown", (e) => {
      const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[(e as KeyboardEvent).key];
      if (d) { e.preventDefault(); root.classList.add("manual"); go(cur + d, true); }
    });

    if (reduce) root.classList.add("manual");
    new IntersectionObserver(([en]) => root.classList.toggle("off", !en.isIntersecting), { threshold: 0.25 }).observe(root);
  });
</script>

<style>
  .ps { display: grid; grid-template-columns: minmax(240px, 300px) minmax(0, 1fr); gap: 40px; align-items: start; }

  /* tabs: vertical list on desktop, the active one shows its progress */
  .tabs { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .tab { position: relative; display: flex; gap: 16px; align-items: flex-start; text-align: left; padding: 18px 4px 20px; background: none; border: 0; border-bottom: 1px solid var(--line); cursor: pointer; color: var(--fg-mid); font: inherit; transition: color .25s ease; }
  .tab:hover { color: var(--fg-strong); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .tab-n { font-size: 11px; padding-top: 4px; color: var(--fg-faint); transition: color .25s ease; }
  .tab-c { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .tab-t { font-size: 17px; font-weight: 400; }
  .tab-b { font-size: 13.5px; line-height: 1.45; color: var(--fg-mid); max-height: 0; opacity: 0; overflow: hidden; transition: max-height .4s var(--ease), opacity .3s ease; }
  .tab[aria-selected="true"] { color: var(--fg-strong); }
  .tab[aria-selected="true"] .tab-n { color: var(--accent); }
  .tab[aria-selected="true"] .tab-b { max-height: 60px; opacity: 1; }
  .bar { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--accent); }
  .tab[aria-selected="true"] .bar span { animation: ps-fill var(--ps-dur) linear both; }
  .manual .tab[aria-selected="true"] .bar span { animation: none; width: 100%; }
  .off .bar span, .ps:hover .bar span { animation-play-state: paused !important; }
  @keyframes ps-fill { to { width: 100%; } }

  /* browser window */
  .win { position: relative; margin: 0; background: #161616; border: 1px solid #161616; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 24px 60px -20px rgba(22,22,22,.35), 0 40px 120px -40px rgba(35,71,232,.35); }
  .chrome { display: flex; align-items: center; gap: 16px; height: 38px; padding: 0 14px; color: #a8a8a8; }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 9px; height: 9px; background: #393939; }
  .lights i:first-child { background: #f5a83f; }
  .url { flex: 0 1 320px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 6px; height: 24px; padding: 0 12px; background: #262626; font-size: 11.5px; color: #c6c6c6; white-space: nowrap; overflow: hidden; }
  .url svg { color: #6fdc8c; flex: none; }

  /* sized to the shortest screen (1440×680): full width always shows, taller ones crop at the bottom */
  .stage { position: relative; aspect-ratio: 1440 / 680; overflow: hidden; background: #1c1c1c; }
  .shot { position: absolute; inset: 0 0 auto; width: 100%; height: auto; max-width: none; opacity: 0; transform: scale(1.02) translateY(6px); transition: opacity .6s ease, transform 1.2s var(--ease); }
  .shot[data-on] { opacity: 1; transform: none; }

  .cap { position: relative; min-height: 64px; background: var(--ink); border-top: 1px solid #161616; }
  .cap p { position: absolute; inset: 0; margin: 0; padding: 16px 20px; font-size: 14px; line-height: 1.55; color: var(--fg-mid); opacity: 0; transition: opacity .4s ease; }
  .cap p[data-on] { position: relative; opacity: 1; }

  /* narrow: tabs become a horizontal scroller above the window */
  @media (max-width: 960px) {
    .ps { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .tabs { flex-direction: row; overflow-x: auto; border-top: 0; border-bottom: 1px solid var(--line); scrollbar-width: none; }
    .tab { flex: none; padding: 12px 14px; border-bottom: 0; }
    .tab-n, .tab-b { display: none; }
    .tab-t { font-size: 14px; }
  }
  @media (max-width: 560px) {
    .win { margin: 0 calc(-1 * var(--gut, 16px)); }
    .chrome { height: 32px; }
    .url { font-size: 10.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot, .cap p, .tab-b { transition: none; }
  }
</style>
