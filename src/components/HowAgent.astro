---
import type { Lang } from "../i18n/content";
import { howto } from "../i18n/howto";
interface Props { lang: Lang; num?: string; }
const { lang, num } = Astro.props;
const c = howto(lang).agent;
const gpus = [94, 91, 62, 70, 28, 12, 85, 40];
---
<section id="agent" class="sec sec--dark">
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
        <h2 class="h2">{c.title}</h2>
      </div>
      <p class="shead-lead">{c.lead}</p>
    </div>

    <div class="diagram">
      <div class="col">
        <span class="mono lbl">{c.net}</span>
        <div class="agent">Ventic Agent<span class="vt-ping beacon" aria-hidden="true"></span></div>
        <span class="mono lbl lbl--dim">{c.detected}</span>
        <div class="chips">{c.runtimes.map((r) => <span class="mono chip">{r}</span>)}</div>
        <div class="gpus" aria-hidden="true">{gpus.map((p) => <span style={`--p:${p}%`}></span>)}</div>
      </div>
      <div class="channel" aria-hidden="true">
        <div class="wall"></div>
        <div class="mono wall-lbl">{c.firewall}</div>
        <div class="lane lane--out">
          <span class="vt-dash"></span><span class="vt-run"></span><span class="vt-run" style="animation-delay:1.1s"></span>
          <span class="mono lane-lbl">{c.out}</span>
        </div>
        <div class="lane lane--in">
          <span class="vt-dash vt-dash--back"></span><span class="vt-run vt-run--back" style="animation-delay:.5s"></span><span class="vt-run vt-run--back" style="animation-delay:1.6s"></span>
          <span class="mono lane-lbl lane-lbl--r">{c.back}</span>
        </div>
      </div>
      <div class="col col--platform">
        <span class="mono lbl lbl--accent">{c.platform}</span>
        <div class="box">{c.boxes[0]}</div>
        <div class="box box--gw">{c.boxes[1]}<span class="mono">/v1 · SSE</span></div>
        <div class="box">{c.boxes[2]}</div>
      </div>
    </div>

    <ol class="steps">
      {c.steps.map(([k, v]) => <li><span class="mono sk">{k}</span><span class="sv">{v}</span></li>)}
    </ol>
  </div>
</section>

<style>
  .diagram { display: flex; flex-wrap: wrap; align-items: stretch; }
  .col { flex: 1 1 300px; border: 1px solid var(--line-soft); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .col--platform { border-color: var(--accent); background: #10162e; gap: 12px; }
  .lbl { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); }
  .lbl--dim { text-transform: none; letter-spacing: 0; color: var(--fg-faint); }
  .lbl--accent { color: var(--accent-mid); }
  .agent { background: var(--amber); color: #161616; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; font-weight: 500; }
  .beacon { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { border: 1px solid var(--line); padding: 6px 10px; font-size: 12px; }
  .gpus { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3px; margin-top: auto; }
  .gpus span { height: 28px; background: linear-gradient(0deg, var(--accent) var(--p), #262626 var(--p)); }
  .box { background: #161616; border: 1px solid var(--line-soft); padding: 14px 16px; }
  .box--gw { background: var(--accent); border-color: var(--accent); color: #fff; display: flex; justify-content: space-between; gap: 12px; }
  .box--gw span { font-size: 11px; align-self: center; }

  .channel { flex: 1 1 260px; min-width: 220px; position: relative; display: flex; flex-direction: column; justify-content: center; gap: 44px; padding: 56px 0 40px; }
  .wall { position: absolute; left: 50%; top: 0; bottom: 0; width: 6px; margin-left: -3px; background: repeating-linear-gradient(180deg, var(--red) 0 8px, transparent 8px 14px); opacity: .9; }
  .wall-lbl { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); background: var(--night); padding: 4px 8px; font-size: 11px; color: #ff8a73; white-space: nowrap; }
  .lane { position: relative; height: 12px; }
  .lane .vt-dash { position: absolute; left: 0; right: 0; top: 5px; }
  .lane--out { color: var(--accent-mid); }
  .lane--out .vt-run { background: var(--accent); }
  .lane--in { color: var(--amber); }
  .lane--in .vt-run { background: var(--amber); }
  .lane-lbl { position: absolute; left: 8px; top: 18px; font-size: 11px; }
  .lane-lbl--r { left: auto; right: 8px; }

  .steps { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line-soft); border: 1px solid var(--line-soft); }
  .steps li { background: var(--night); padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .sk { font-size: 11px; color: var(--accent-mid); }
  .sv { font-size: 15px; color: var(--fg-dim); }
  @media (max-width: 1080px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
