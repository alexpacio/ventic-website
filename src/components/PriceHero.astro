---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].pricingPage;
---
<section class="phero">
  <div class="wrap inner">
    <div class="copy">
      <span class="plate"><span class="dot"></span>{c.plate}</span>
      <h1 class="h1"><span class="vt-line">{c.title[0]}</span><br /><span class="vt-line vt-line--2 hl">{c.title[1]}</span></h1>
    </div>
    <p class="lead">{c.lead}</p>
  </div>
</section>

<style>
  .phero { padding: 88px 0 72px; border-bottom: 1px solid var(--line-soft); }
  .inner { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 32px 64px; }
  .copy { flex: 1 1 560px; display: flex; flex-direction: column; gap: 20px; }
  .lead { flex: 1 1 380px; }
  @media (max-width: 860px) { .phero { padding: 48px 0 40px; } }
</style>
