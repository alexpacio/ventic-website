---
import type { Lang } from "../i18n/content";
import { howto } from "../i18n/howto";
interface Props { lang: Lang; num?: string; }
const { lang, num } = Astro.props;
const h = howto(lang);
const c = h.sw;
const helm = h.helm;
const sets = [
  { key: "routine", rows: c.routine_rows },
  { key: "hard", rows: c.hard_rows },
];
---
<section id="switchyard" class="sec sec--rule">
  <div class="wrap sw vt-reveal" data-sw>
    <div class="intro">
      <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
      <h2 class="h2">{c.title}</h2>
      <p class="lead">{c.lead}</p>
      <div class="seg" role="group" aria-label={c.group}>
        <button type="button" data-set="routine" aria-pressed="true">{c.routine}</button>
        <button type="button" data-set="hard" aria-pressed="false">{c.hard}</button>
      </div>
    </div>
    <div class="table">
      <div class="mono thead"><span>{c.cols[0]}</span><span>{c.cols[1]}</span><span class="r">{c.cols[2]}</span></div>
      {sets.map((s) => (
        <div class="rows" data-rows={s.key} hidden={s.key !== "routine"}>
          {s.rows.map(([name, where, score, cost, chosen]) => (
            <div class:list={["row", { chosen }]}>
              <div class="who"><span class="name">{name}{chosen && <span class="mono pick">{c.chosen}</span>}</span><span class="mono where">{where}</span></div>
              <div class="bar"><span style={`width:${score}%`}></span></div>
              <span class="mono cost">{cost}</span>
            </div>
          ))}
        </div>
      ))}
      <p class="note">{c.note}</p>
    </div>
  </div>
</section>

<section class="sec helm">
  <div class="wrap helm-in vt-reveal">
    <div class="helm-copy">
      <span class="plate">{helm.plate}</span>
      <h2 class="h3">{helm.title}</h2>
    </div>
    <div class="layers">
      {helm.layers.map(([k, v, color]) => (
        <div class="layer" style={`border-top-color:${color}`}><span class="mono">{k}</span><span class="layer-d">{v}</span></div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-sw]").forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>("[data-set]");
    btns.forEach((b) => b.addEventListener("click", () => {
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      root.querySelectorAll<HTMLElement>("[data-rows]").forEach((r) => { r.hidden = r.dataset.rows !== b.dataset.set; });
    }));
  });
</script>

<style>
  .sw { display: flex; flex-wrap: wrap; gap: 48px 64px; }
  .intro { flex: 1 1 380px; display: flex; flex-direction: column; gap: 20px; }
  .table { flex: 2 1 560px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .thead, .row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(48px, 1fr); gap: 16px; }
  .thead { padding: 0 20px 10px; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-mid); }
  .r, .cost { text-align: right; }
  .rows { display: flex; flex-direction: column; gap: 2px; }
  .rows[hidden] { display: none; }
  .rows:not([hidden]) .row { animation: vt-rise .45s var(--ease) both; }
  .rows:not([hidden]) .row:nth-child(2) { animation-delay: .05s; }
  .rows:not([hidden]) .row:nth-child(3) { animation-delay: .1s; }
  .rows:not([hidden]) .row:nth-child(4) { animation-delay: .15s; }
  .row { padding: 16px 20px; background: var(--deck); border-left: 4px solid transparent; align-items: center; }
  .row.chosen { background: var(--accent-soft); border-left-color: var(--accent); }
  .who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-weight: 500; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; color: var(--fg-strong); }
  .pick { background: var(--accent); color: #fff; font-size: 10px; padding: 2px 6px; }
  .where { font-size: 11px; color: var(--fg-mid); }
  .bar { height: 8px; background: var(--line-soft); }
  .bar span { display: block; height: 8px; background: var(--accent-mid); animation: vt-grow 1.2s var(--ease) both; }
  .chosen .bar span { background: var(--accent); }
  .cost { font-size: 13px; }
  .note { margin-top: 10px; font-size: 12px; color: var(--fg-faint); }

  .helm { background: var(--deck); padding: 72px 0; }
  .helm-in { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center; }
  .helm-copy { flex: 1 1 360px; display: flex; flex-direction: column; gap: 12px; }
  .layers { flex: 2 1 560px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px; }
  .layer { background: var(--ink); border-top: 4px solid; padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .layer .mono { font-size: 13px; color: var(--fg-strong); }
  .layer-d { font-size: 14px; color: var(--fg-mid); }
  @media (max-width: 860px) { .layers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .thead, .row { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) 40px; gap: 10px; } .row { padding: 14px 12px; } }
</style>
