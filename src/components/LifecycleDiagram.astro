---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].lifecycle;
---
<figure class="life">
  <div class="head">
    <span class="plate">{c.plate}</span>
    <h3 class="ltitle">{c.title}</h3>
  </div>

  <div class="grid">
    {c.rules.map((r) => (
      <div class="panel rule">
        <span class="mono k">{r.label}</span>
        <p class="cell-b">{r.body}</p>
      </div>
    ))}
  </div>

  <!-- inline SVG timeline -->
  <div class="svgwrap" aria-hidden="true">
    <svg viewBox="0 0 960 140" width="100%" height="140" role="img">
      <rect x="0.5" y="0.5" width="959" height="139" rx="3" fill="#101215" stroke="#262a2f"/>
      <!-- timeline base -->
      <line x1="40" y1="86" x2="920" y2="86" stroke="#32373d" stroke-width="1.2"/>
      <!-- nodes -->
      <g font-family="IBM Plex Mono, monospace" text-anchor="middle">
        <!-- idle -->
        <circle cx="150" cy="86" r="7" fill="#2b3036" stroke="#32373d"/><circle cx="150" cy="86" r="3" fill="#6f7276"/>
        <text x="150" y="122" font-size="9" letter-spacing="0.08em" fill="#6f7276">IDLE 15m</text>
        <text x="150" y="34" font-size="10" font-weight="600" fill="#8a8d92">●</text>
        <!-- shutdown -->
        <circle cx="380" cy="86" r="10" fill="#16181b" stroke="#32373d"/><circle cx="380" cy="86" r="4" fill="#5c5f63"/>
        <text x="380" y="122" font-size="9" letter-spacing="0.08em" fill="#5c5f63">SHUTDOWN</text>
        <text x="380" y="28" font-size="9" letter-spacing="0.1em" fill="#5c5f63">OFF</text>
        <!-- wake -->
        <circle cx="610" cy="86" r="10" fill="#f5a83f" stroke="#f5a83f"/><circle cx="610" cy="86" r="4" fill="#14161a"/>
        <text x="610" y="122" font-size="9" letter-spacing="0.08em" fill="#f5a83f">WAKE ON REQUEST</text>
        <text x="610" y="28" font-size="9" letter-spacing="0.1em" fill="#f5a83f">ON — 1ª chiamata</text>
        <!-- reclaim -->
        <rect x="770" y="62" width="120" height="48" rx="2" fill="#1d2126" stroke="#32373d"/>
        <text x="830" y="82" font-size="9" font-weight="600" fill="#f2f0eb">SPOT RECLAIM</text><text x="830" y="96" font-size="8" fill="#8a8d92">→ altro provider</text>
        <circle cx="730" cy="86" r="6" fill="#35cfa4" stroke="#35cfa4"/>
      </g>
      <!-- arrows -->
      <g stroke="#32373d" stroke-width="1.2" fill="none" marker-end="url(#ah2)">
        <path d="M162 86 H368"/><path d="M392 86 H598"/><path d="M622 86 H718"/><path d="M742 86 H768"/>
      </g>
      <defs><marker id="ah2" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0 L8 4 L0 8 z" fill="#32373d"/></marker></defs>
      <!-- scale annotations top -->
      <g font-family="IBM Plex Mono, monospace" font-size="8" fill="#8a8d92" text-anchor="middle">
        <text x="265" y="68"> &lt;25% ×10m → −replica </text>
        <text x="495" y="68"> &gt;80% → +replica </text>
      </g>
    </svg>
  </div>

  <p class="mono foot">{c.foot}</p>
</figure>

<style>
  .life { margin: 32px 0 0; }
  .head { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .ltitle { font-family: var(--display); font-size: clamp(18px, 1.8vw, 22px); font-weight: 700; line-height: 1.1; text-transform: uppercase; color: var(--fg-strong); }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .rule { padding: 16px 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .k { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .svgwrap { margin-top: 16px; border-radius: 3px; overflow: hidden; overflow-x: auto; }
  .foot { margin-top: 12px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--fg-ghost); }

  @media (max-width: 1080px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .svgwrap { display: none; } }
</style>
