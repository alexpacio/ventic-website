---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = content[lang].panel;
---
<div>
  <div class="panel box">
    <div class="panel-head head">
      <div class="grp">
        <span class="rivet"></span>
        <span class="mono label">{p.title}</span>
      </div>
      <div class="grp">
        <span class="dot dot--live"></span>
        <span class="mono live">{p.status}</span>
        <span class="rivet"></span>
      </div>
    </div>

    <div class="node"><span class="mono">{p.node}</span></div>

    <div class="gauges">
      {p.gauges.map((g) => (
        <div class="gauge">
          <span class="mono gname">{g.label}</span>
          <span class="sunk track">
            <span class={`fill ${g.warm ? "fill--warm" : ""}`} style={`width:${g.pct}%`}></span>
          </span>
          <span class="mono gval num">{g.value}</span>
        </div>
      ))}
    </div>

    <div class="seam"></div>

    <div class="stats">
      {p.stats.map((s) => (
        <div class="stat">
          <span class="mono skey">{s.label}</span>
          <span class="mono sval num">{s.value}</span>
          <span class="mono sunit">{s.unit}</span>
        </div>
      ))}
    </div>

    <div class="seam"></div>

    <div class="chips">
      {p.chips.map((ch) => <span class="plate plate--sm">{ch}</span>)}
      <span class="plate plate--sm live">{p.chipLive}</span>
    </div>
  </div>
  <div class="mono sample">{p.sample}</div>
</div>

<style>
  .box { padding: 0; overflow: hidden; }
  .head { padding: 14px 16px; }
  .grp { display: flex; align-items: center; gap: 8px; }
  .label { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: #a9a7a1; }
  .live { font-size: 11px; font-weight: 600; letter-spacing: .16em; color: var(--jade); }

  .node { padding: 18px 18px 4px; }
  .node .mono { font-size: 11px; letter-spacing: .1em; color: var(--fg-faint); }

  .gauges { display: flex; flex-direction: column; gap: 14px; padding: 16px 18px 20px; }
  .gauge { display: flex; align-items: center; gap: 12px; }
  .gname { width: 58px; flex-shrink: 0; font-size: 11px; letter-spacing: .08em; color: var(--fg-mute); }
  .track { flex-grow: 1; height: 12px; padding: 2px; border-radius: 1px; }
  .fill { display: block; height: 100%; border-radius: 1px; background: repeating-linear-gradient(90deg, #6b7176 0 5px, transparent 5px 7px); }
  .fill--warm { background: repeating-linear-gradient(90deg, var(--accent) 0 5px, transparent 5px 7px); }
  .gval { width: 44px; flex-shrink: 0; text-align: right; font-size: 12px; font-weight: 500; color: #d4d2cc; }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line-soft); }
  .stat { display: flex; flex-direction: column; padding: 20px 18px; background: var(--panel-b); }
  .skey { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fg-faint); }
  .sval { margin-top: 8px; font-size: clamp(20px, 2vw, 26px); font-weight: 500; color: var(--fg-strong); }
  .sunit { margin-top: 2px; font-size: 11px; color: var(--fg-faint); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px 18px 18px; background: var(--cell); }
  .chips .live { color: var(--jade); }

  .sample {
    margin-top: 10px; text-align: right;
    font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fg-ghost);
  }
</style>
