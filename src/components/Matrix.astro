---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const m = content[lang].pricingPage.matrix;
const legend = lang === "it" ? [["yes", "Sì"], ["dash", "Parziale"], ["no", "No"]] : [["yes", "Yes"], ["dash", "Partly"], ["no", "No"]];
const last = m.cols.length - 1;
---
<section class="sec sec--rule">
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{lang === "it" ? "Confronto" : "Comparison"}</span>
        <h2 class="h2">{m.title}</h2>
      </div>
      <div class="legend">
        <span class="mono meta">{m.meta}</span>
        <span class="keys">{legend.map(([k, l]) => <span><i class={`mk mk--${k}`}></i>{l}</span>)}</span>
      </div>
    </div>
    <div class="tablewrap">
      <table class="tbl">
        <thead>
          <tr>{m.cols.map((col, i) => <th scope="col" class:list={["mono", { own: i === last }]}>{col}</th>)}</tr>
        </thead>
        <tbody>
          {m.rows.map((row) => (
            <tr>
              <th scope="row" class="rowlab">{row.label}</th>
              {row.cells.map((cell, i) => (
                <td class:list={{ own: i === row.cells.length - 1 }}>
                  <span class="inner"><i class={`mk mk--${cell.mark}`} aria-hidden="true"></i><span>{cell.text}</span></span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .legend { flex: 0 1 auto !important; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .meta { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mid); }
  .keys { display: flex; gap: 20px; font-size: 13px; color: var(--fg-mid); }
  .keys span { display: inline-flex; align-items: center; gap: 6px; }
  .mk { display: inline-block; flex: none; width: 12px; height: 12px; margin-top: 4px; }
  .keys .mk { margin-top: 0; }
  .mk--yes { background: var(--jade); }
  .mk--dash { background: var(--line); }
  .mk--no { background: var(--red); }
  .tablewrap { overflow-x: auto; border-top: 2px solid var(--fg-strong); }
  .tbl { width: 100%; min-width: 860px; border-collapse: collapse; text-align: left; font-size: 15px; }
  thead th { padding: 16px; font-size: 11px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-mid); vertical-align: bottom; }
  thead th:first-child { padding-left: 0; width: 28%; }
  thead th.own { background: var(--accent); color: #fff; }
  tbody tr { border-top: 1px solid var(--line-soft); transition: background-color .2s ease; }
  tbody tr:hover { background: var(--deck); }
  .rowlab { padding: 16px 16px 16px 0; font-weight: 500; color: var(--fg-strong); vertical-align: top; }
  td { padding: 16px; vertical-align: top; color: var(--fg-dim); }
  td.own { background: #f1f4fe; color: var(--fg-strong); font-weight: 500; }
  .inner { display: flex; align-items: flex-start; gap: 10px; line-height: 1.45; }
</style>
