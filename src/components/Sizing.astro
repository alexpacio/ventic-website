---
import { content, type Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = content[lang].pricingPage.sizing;
---
<section class="sec sec--dark">
  <div class="wrap inner vt-reveal">
    <div class="left">
      <span class="plate">{s.plate}</span>
      <h2 class="h2">{s.title[0]}<br /><span class="hl">{s.title[1]}</span></h2>
      <p class="lead">{s.body}</p>
    </div>
    <dl class="cells">
      {s.items.map((it, i) => (
        <div class="cell">
          <span class="mono n">0{i + 1}</span>
          <dt class="cell-t">{it.label}</dt>
          <dd class="cell-b">{it.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .inner { display: flex; flex-wrap: wrap; gap: 48px 64px; }
  .left { flex: 1 1 380px; display: flex; flex-direction: column; gap: 20px; }
  .cells { flex: 2 1 560px; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line-soft); border: 1px solid var(--line-soft); }
  .cell { background: var(--night); padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .n { font-size: 12px; color: var(--accent-mid); }
  dd { margin: 0; }
  @media (max-width: 640px) { .cells { grid-template-columns: 1fr; } }
</style>
