---
import type { Lang } from "../i18n/content";
import { home } from "../i18n/home";
interface Props { lang: Lang; num?: string; }
const { lang, num } = Astro.props;
const c = home(lang).arch;
const toneColor: Record<string, string> = { accent: "var(--accent)", mid: "var(--accent-mid)", amber: "var(--amber)" };
---
<section id={c.id} class="sec sec--dark">
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{num && <span class="plate-num">{num} —</span>}{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="shead-lead">{c.lead}</p>
    </div>

    <div class="diagram" data-stagger role="img" aria-label={`${c.clients.label} → ${c.platform.label} ← ${c.nodes.label}`}>
      <div class="col">
        <span class="mono lbl">{c.clients.label}</span>
        {c.clients.items.map((s) => <div class="box">{s}</div>)}
      </div>
      <div class="link link--in" aria-hidden="true">
        <span class="mono link-lbl">{c.inLabel}</span>
        <span class="track"><span class="vt-dash"></span><span class="vt-run"></span></span>
      </div>
      <div class="col col--platform">
        <span class="mono lbl lbl--accent">{c.platform.label}</span>
        <div class="gateway">{c.platform.gateway}<span class="mono">{c.platform.gatewayMeta}</span></div>
        <div class="svc-grid">
          {c.platform.services.map(([n, d]) => <div class="box box--svc"><div>{n}</div><div class="svc-d">{d}</div></div>)}
        </div>
      </div>
      <div class="link link--out" aria-hidden="true">
        <span class="mono link-lbl">{c.outLabel}</span>
        <span class="track"><span class="vt-dash vt-dash--back"></span><span class="vt-run vt-run--back" style="animation-delay:1.1s"></span></span>
      </div>
      <div class="col">
        <span class="mono lbl">{c.nodes.label}</span>
        {c.nodes.items.map((n) => (
          <div class="box node">
            <div class="mono node-head"><span>{n.name}</span><span class="node-meta">{n.meta}</span></div>
            <div class="bar"><span style={`width:${n.pct}%;background:${toneColor[n.tone]}`}></span></div>
          </div>
        ))}
      </div>
    </div>
    <p class="mono foot">{c.foot}</p>
  </div>
</section>

<style>
  .diagram { display: flex; flex-wrap: wrap; align-items: stretch; }
  .col { flex: 1 1 240px; border: 1px solid var(--line-soft); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .col--platform { flex: 1.3 1 300px; border-color: var(--accent); background: #10162e; }
  .lbl { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); }
  .lbl--accent { color: var(--accent-mid); }
  .box { background: #161616; border: 1px solid var(--line-soft); padding: 14px 16px; font-size: 15px; color: var(--fg); }
  .gateway { background: var(--accent); color: #fff; padding: 14px 16px; font-size: 15px; display: flex; justify-content: space-between; gap: 12px; }
  .gateway span { font-size: 11px; opacity: .85; align-self: center; }
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .box--svc { padding: 12px 14px; font-size: 14px; }
  .svc-d { font-size: 12px; color: var(--fg-mid); }
  .link { flex: 0 1 112px; min-width: 64px; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 16px 8px; }
  .link--in { color: var(--accent-mid); }
  .link--in .vt-run { background: var(--amber); }
  .link--out { color: var(--amber); }
  .link--out .vt-run { background: var(--accent); }
  .link-lbl { font-size: 10px; text-align: center; }
  .track { position: relative; height: 12px; display: block; }
  .track .vt-dash { position: absolute; left: 0; right: 0; top: 5px; }
  .node { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; }
  .node-head { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; }
  .node-meta { color: var(--fg-mid); }
  .bar { height: 6px; background: #262626; }
  .bar span { display: block; height: 6px; }
  .foot { margin-top: 28px; font-size: 12px; color: var(--fg-mid); }
  @media (max-width: 1080px) {
    .link { flex-basis: 100%; min-height: 48px; padding: 8px 0; }
    .link .track { width: 2px; height: 32px; margin: 0 auto; }
    .link .vt-dash, .link .vt-run { display: none; }
    .link .track { background: currentColor; }
  }
</style>
