---
import { listino } from "../i18n/listino";
import { pick } from "../i18n/onprem";
import type { Lang } from "../i18n/content";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = listino(lang);
const t = pick(lang);
const v = c.rows[0].variants[0];
const demoHref = lang === "it" ? "/demo/" : "/en/demo/";
const plans = [
  { key: "demo", tag: t("Demo", "Demo"), price: "€0", unit: t("30 giorni", "30 days"), body: t("Installi lo stack completo sul tuo server e lo provi con i tuoi carichi reali. Poi passi alla licenza senza reinstallare.", "Install the full stack on your server and try it on your real workloads. Then move to the licence without reinstalling."), cta: t("Installa la demo", "Deploy the demo"), href: demoHref, ext: false },
  { key: "host", tag: t("Per host", "Per host"), price: v.host?.replace(/[,.]00$/, "") ?? "", unit: c.month, body: t("Una licenza per ogni host su cui gira Ventic. Ideale per partire con uno o due server.", "One licence per host running Ventic. Ideal to start with one or two servers."), cta: t("Acquista su Licman", "Buy on Licman"), href: c.href, ext: true },
  { key: "company", tag: t("Per azienda", "Per company"), price: v.company.replace(/[,.]00$/, ""), unit: c.month, body: t("Tutti gli host dell'azienda sotto un'unica licenza. Conviene quando la flotta cresce.", "All of the company's hosts under one licence. Better value as the fleet grows."), badge: t("Host illimitati", "Unlimited hosts"), cta: t("Acquista su Licman", "Buy on Licman"), href: c.href, ext: true },
];
---
<section id={c.id} class="sec sec--tint">
  <div class="wrap vt-reveal">
    <div class="shead">
      <div>
        <span class="plate">{c.plate}</span>
        <h2 class="h2">{c.title[0]}<br />{c.title[1]}</h2>
      </div>
      <p class="shead-lead">{c.lead}</p>
    </div>
    <div class="plans">
      {plans.map((p) => (
        <article class={`plan plan--${p.key}`}>
          <div class="ptop">
            <span class="mono tag">{p.tag}</span>
            {p.badge && <span class="mono badge">{p.badge}</span>}
          </div>
          <div class="prow"><span class="price pval">{p.price}</span><span class="punit">{p.unit}</span></div>
          <p class="pbody">{p.body}</p>
          <a class={`btn ${p.key === "host" ? "btn--a" : p.key === "company" ? "btn--light" : "btn--ghost"}`} href={p.href} target={p.ext ? "_blank" : undefined} rel={p.ext ? "noopener" : undefined}>{p.cta} <span class="arr" aria-hidden="true">{p.ext ? "↗" : "→"}</span></a>
        </article>
      ))}
    </div>
    <p class="mono foot">{c.foot}</p>
  </div>
</section>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; }
  .plan { background: var(--ink); padding: 36px; display: flex; flex-direction: column; gap: 20px; border-top: 4px solid #161616; }
  .plan--host { border-top-color: var(--accent); }
  .plan--company { background: #161616; border-top-color: var(--amber); }
  .ptop { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .tag { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-mute); }
  .plan--host .tag { color: var(--accent); }
  .plan--company .tag { color: var(--amber); }
  .badge { font-size: 11px; background: var(--amber); color: #161616; padding: 4px 8px; }
  .prow { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
  .pval { font-size: clamp(52px, 5vw, 64px); }
  .punit { font-size: 14px; color: var(--fg-faint); }
  .pbody { font-size: 15px; color: var(--fg-mid); }
  .plan--company .pval { color: #fff; }
  .plan--company .punit { color: #a8a8a8; }
  .plan--company .pbody { color: #c6c6c6; }
  .plan .btn { margin-top: auto; }
  .foot { margin-top: 18px; font-size: 12px; line-height: 1.7; color: var(--fg-mid); }
  @media (max-width: 960px) { .plans { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .plan { padding: 28px 20px; } }
</style>
