---
import type { Scheme } from "../i18n/onprem";
interface Props { scheme: Scheme; }
const { scheme: s } = Astro.props;

const C = {
  wire: "#3d444b", amber: "#f5a83f", jade: "#35cfa4", box: "#181b1f", line: "#32373d",
  title: "#f2f0eb", sub: "#a4a29b", ghost: "#6f7276", dim: "#97958f",
};
const stroke = { n: C.line, a: C.amber, j: C.jade, d: "#4a5056" } as const;
const wire = { w: C.wire, a: C.amber, j: C.jade } as const;

function wrap(text: string, max: number): string[] {
  const out: string[] = [];
  let cur = "";
  for (const w of text.split(" ")) {
    if ((cur + " " + w).trim().length > max) { out.push(cur); cur = w; } else cur = (cur + " " + w).trim();
  }
  if (cur) out.push(cur);
  return out;
}
const uid = `sc-${s.id}`;
---
<figure class="scheme panel">
  <div class="s-head">
    <span class="plate">{s.plate}</span>
    <h3 class="stitle">{s.title}</h3>
    <p class="slead">{s.lead}</p>
  </div>

  <div class="sscroll">
    <svg viewBox={`0 0 ${s.w} ${s.h}`} role="img" aria-label={s.title} style={`min-width:${Math.min(s.w, 920)}px`}>
      <defs>
        {(["w", "a", "j"] as const).map((k) => (
          <marker id={`${uid}-${k}`} markerWidth="8" markerHeight="8" refX="6.6" refY="4" orient="auto">
            <path d="M0 0 L8 4 L0 8 z" fill={wire[k]} />
          </marker>
        ))}
        <pattern id={`${uid}-hatch`} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="8" height="8" fill="#16181b" /><rect width="3" height="8" fill="#2a2520" />
        </pattern>
      </defs>

      {(s.bands ?? []).map((b) => (
        <g>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="3" fill={b.hatch ? `url(#${uid}-hatch)` : "#101216"} stroke={b.hatch ? "#45403a" : "#262a2f"} stroke-dasharray={b.dash ? "5 5" : undefined} />
          {b.text && <text x={b.x + 14} y={b.y + 20} font-size="10" letter-spacing="0.12em" fill={C.ghost} class="mono">{b.text}</text>}
        </g>
      ))}

      {s.edges.map((e) => {
        const tone = e.tone ?? "w";
        return (
          <polyline
            points={e.pts.map((p) => p.join(",")).join(" ")}
            fill="none" stroke={wire[tone]} stroke-width="1.6" stroke-linejoin="round"
            stroke-dasharray={e.dash ? "6 5" : undefined}
            marker-end={`url(#${uid}-${tone})`}
          />
        );
      })}

      {s.nodes.map((n) => {
        const tone = n.tone ?? "n";
        const bar = tone === "n" ? C.wire : tone === "d" ? C.wire : stroke[tone];
        const lines = n.s ? wrap(n.s, Math.floor((n.w - 30) / 6.9)) : [];
        return (
          <g>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="3" fill={tone === "j" ? "#14201c" : tone === "a" ? "#1d1a16" : C.box} stroke={stroke[tone]} stroke-dasharray={tone === "d" ? "5 4" : undefined} />
            <rect x={n.x} y={n.y} width="3" height={n.h} fill={bar} />
            <text x={n.x + 16} y={n.y + 26} font-size="14.5" font-weight="600" fill={C.title}>
              {n.n && <tspan class="mono" fill={C.amber} font-size="11" dx="0">{n.n}  </tspan>}{n.t}
            </text>
            {lines.map((l, i) => <text x={n.x + 16} y={n.y + 47 + i * 16} font-size="12" fill={C.sub}>{l}</text>)}
          </g>
        );
      })}

      {(s.labels ?? []).map((l) => (
        <text x={l.x} y={l.y} font-size="11" text-anchor={l.anchor ?? "middle"} fill={l.tone === "a" ? C.amber : l.tone === "j" ? C.jade : C.dim} class="mono" letter-spacing="0.04em">{l.text}</text>
      ))}
    </svg>
  </div>

  {s.steps && (
    <ol class="steps">
      {s.steps.map((st) => <li><b class="mono">{st.k}</b><span>{st.t}</span></li>)}
    </ol>
  )}
  {s.chips && (
    <ul class="chips">{s.chips.map((c) => <li class="mono">{c}</li>)}</ul>
  )}
</figure>

<style>
  .scheme { margin: 0; padding: 28px 28px 24px; display: flex; flex-direction: column; gap: 20px; }
  .s-head { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .stitle { font-size: clamp(20px, 2vw, 26px); line-height: 1.15; text-transform: none; }
  .slead { max-width: 74ch; font-size: 15px; line-height: 1.6; color: var(--fg-mid); }
  .sscroll { overflow-x: auto; background: var(--sunk); border: 1px solid var(--line-soft); border-radius: 0;  padding: 8px; }
  svg { display: block; width: 100%; height: auto; font-family: var(--sans); }
  .mono { font-family: var(--mono); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .steps li { display: flex; gap: 10px; padding: 14px; border: 1px solid var(--line-soft); border-radius: 0; font-size: 14px; line-height: 1.5; color: var(--fg-dim); }
  .steps b { color: var(--accent); font-size: 12px; padding-top: 2px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { font-size: 11px; letter-spacing: .03em; color: var(--fg-dim); padding: 7px 11px; border: 1px solid var(--line-soft); border-radius: 0; background: var(--sunk); }
  @media (max-width: 860px) {
    .scheme { padding: 20px 16px 18px; }
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
