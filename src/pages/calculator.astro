---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import Footer from "../components/Footer.tsx";
import CostCalculator from "../components/CostCalculator.tsx";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";
const lang = getLangFromUrl(Astro.url);
---

<Layout title="Cost Calculator — Ventic | Quanto costa al mese per utente" description="Calcola il costo mensile per utente per Qwen3.8-27B, Qwen3.8-Flash-Next, DeepSeek V4 Flash NVFP4 e Pro. Due fasce: 8h×20gg (160h) o h24 7/7 (730h). Filtri EU/IT, datacenter, NVFP4." lang={lang}>
  <Navbar client:load lang={lang} currentPath={Astro.url.pathname} />
  <main class="mx-auto max-w-[1280px] px-6 lg:px-8 py-8">
    <div class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#0f62fe]">PaaS · Cost Calculator · NVFP4 sempre quando possibile</div>
    <h1 class="mt-2 text-[30px] lg:text-[38px] font-light tracking-[-0.02em] leading-[1.1]">Cost calculator<br/><span class="font-semibold">quanto costa al mese per utente</span></h1>
    <p class="mt-3 max-w-[72ch] text-[14px] leading-[1.7] text-[#525252]">
      Inserisci modello, contesto per utente, numero di utenti concorrenti e fascia oraria. Il calcolatore stima VRAM (pesi NVFP4 + KV + overhead), verifica RAM/CPU/disk/reliability/inet del host, considera costo rete <span class="font-mono text-[12px] bg-[#f4f4f4] border border-[#e0e0e0] px-1">$/TB</span> e ti dice <strong>costo totale /mese, per utente /mese e per utente /ora</strong>. Evidenzia la miglior soluzione entro il budget.
      Due fasce: <span class="bg-[#f4f4f4] border border-[#e0e0e0] px-1.5 py-0.5 font-mono text-[12px]">8h × 20gg = 160h/mese</span> (ufficio) e <span class="bg-[#161616] text-white px-1.5 py-0.5 font-mono text-[12px]">h24 7/7 = 730h/mese</span> (always-on). Ventic = 50% Vast.ai + rete.
    </p>
    <div class="mt-2 font-mono text-[11px] text-[#6f6f6f]">
      Dati: <a href="/reports/inventario-llm-privati-2026.md" class="underline text-[#0f62fe]">Report</a> · <a href="/reports/quotes-latest.json" class="underline text-[#0f62fe]">quotes-latest.json</a> · <code>scripts/vast-llm-inventory.py</code> · <a href="/inventario" class="underline text-[#0f62fe]">Inventario</a>
    </div>

    <div class="mt-8">
      <CostCalculator client:load lang={lang} />
    </div>

  
  </main>
  <Footer client:load lang={lang} />
</Layout>
