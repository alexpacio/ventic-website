---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import HomeWhat from "../components/HomeWhat.astro";
import HomePlatform from "../components/HomePlatform.astro";
import HomeSteps from "../components/HomeSteps.astro";
import Modes from "../components/Modes.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { content } from "../i18n/content";
import { serviceJsonLd } from "../lib/seo";

const lang = "it" as const;
const seo = content[lang].seo.home;
const jsonLd = serviceJsonLd(lang);
---
<Layout title={seo.title} description={seo.desc} lang={lang} jsonLd={jsonLd}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <HomeWhat lang={lang} num="01" />
    <HomePlatform lang={lang} num="02" />
    <HomeSteps lang={lang} num="03" />
    <Modes lang={lang} num="04" lean />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
