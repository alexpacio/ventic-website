---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import Hero from "../components/Hero.tsx";
import Modes from "../components/Modes.tsx";
import Why from "../components/Why.tsx";
import How from "../components/How.tsx";
import ModelsSection from "../components/Models.tsx";
import Features from "../components/Features.tsx";
import Pricing from "../components/Pricing.tsx";
import Footer from "../components/Footer.tsx";
import { ui } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";

const lang = getLangFromUrl(Astro.url);
const t = (key: string) => (ui[lang] as Record<string, string>)[key] ?? (ui["it"] as Record<string, string>)[key] ?? key;
---

<Layout title={t("seo.home.title")} description={t("seo.home.desc")} lang={lang}>
  <Navbar client:load lang={lang} currentPath={Astro.url.pathname} />
  <main>
    <Hero client:load lang={lang} />
    <Modes lang={lang} />
    <Why lang={lang} />
    <How lang={lang} />
    <ModelsSection lang={lang} />
    <Features lang={lang} />
    <Pricing lang={lang} />
  </main>
  <Footer client:load lang={lang} />
</Layout>
