---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Facts from "../components/Facts.astro";
import Pains from "../components/Pains.astro";
import Highlights from "../components/Highlights.astro";
import PromoVideo from "../components/PromoVideo.astro";
import Explore from "../components/Explore.astro";
import PricingStrip from "../components/PricingStrip.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { content } from "../i18n/content";
import { serviceJsonLd } from "../lib/seo";

const lang = "it" as const;
const seo = content[lang].seo.home;
const jsonLd = serviceJsonLd(lang);
---
<Layout title={seo.title} description={seo.desc} lang={lang} jsonLd={jsonLd}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Facts lang={lang} />
    <Pains lang={lang} />
    <Highlights lang={lang} />
    <PromoVideo lang={lang} />
    <Explore lang={lang} />
    <PricingStrip lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
