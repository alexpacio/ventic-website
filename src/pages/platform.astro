---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/PageHero.astro";
import Stack from "../components/Stack.astro";
import Capabilities from "../components/Capabilities.astro";
import HomeSecure from "../components/HomeSecure.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { pages } from "../i18n/pages";

const lang = "it" as const;
const seo = pages(lang).platform.seo;
---
<Layout title={seo.title} description={seo.desc} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <PageHero lang={lang} page="platform" />
    <Stack lang={lang} />
    <Capabilities lang={lang} />
    <HomeSecure lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
