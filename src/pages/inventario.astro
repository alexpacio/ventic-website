---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import Footer from "../components/Footer.tsx";
import { ui } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";

const lang = getLangFromUrl(Astro.url);
const t = (k:string)=> (ui[lang] as any)[k] ?? (ui["it"] as any)[k] ?? k;
---

<Layout title="Inventario LLM Privati — Ventic" description="Quotazioni Vast.ai per Qwen3.8-27B, Qwen3.8-Flash-Next, DeepSeek V4 Flash/Pro con varianti 200K e 1M, concorrenza 1/4/16. NVFP4/MXFP8 preferiti." lang={lang}>
  <Navbar client:load lang={lang} currentPath={Astro.url.pathname} />
  <main class="mx-auto max-w-[1280px] px-6 lg:px-8 py-10">
    <div class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#0f62fe]">Private AI · PaaS · Update 28/08/2026</div>
    <h1 class="mt-3 text-[32px] lg:text-[42px] font-light tracking-[-0.02em]">Inventario LLM privati<br/><span class="font-semibold">quotato su Vast.ai</span></h1>
    <p class="mt-4 max-w-[70ch] text-[15px] leading-[1.7] text-[#525252]">
      Ogni riga è una configurazione <strong>verificata su vLLM o SGLang</strong> con context window ≥200K. 
      Preferenza a <strong>NVFP4</strong> su Blackwell (B200, RTX PRO 6000) e <strong>MXFP4/FP8</strong> dove stabile. 
      Prezzi <strong>spot / on-demand Vast.ai</strong> (28/08/2026) — Prezzo PaaS all-inclusive. 
      <a href="/reports/inventario-llm-privati-2026.md" class="underline text-[#0f62fe]">Report completo (Markdown)</a> · 
      <a href="/reports/quotes-latest.json" class="underline text-[#0f62fe]">JSON quotazioni</a> · 
      <code class="bg-[#f4f4f4] px-1">scripts/vast-llm-inventory.py</code> · <a href="/calculator" class="bg-[#0f62fe] text-white px-2 py-1 font-mono text-[12px]">→ Cost Calculator</a>
    </p>

    <div class="mt-8 grid lg:grid-cols-2 gap-6">
      <!-- Qwen 27B -->
      <section class="border border-[#e0e0e0] bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-[18px] font-semibold">Qwen3.8-27B <span class="font-mono text-[11px] text-[#6f6f6f]">27B dense · 262K →1M</span></h2>
          <span class="bg-[#0f62fe] text-white px-2 py-1 font-mono text-[11px] uppercase">NVFP4 preferito</span>
        </div>
        <p class="mt-2 text-[13px] text-[#525252]">HF <code>Qwen/Qwen3.8-27B</code> · Pesi NVFP4 14G / Q8 27G / FP8 27G · KV 0.115 MiB/tok. Su Blackwell NVFP4 (½ RTX PRO 6000 @262K 111 tok/s), su Ada/Ampere (RTX 4090/L40S/A100) <b>Q8</b> (INT8) — 1 byte/param, compatibile SM86/SM89 senza FP8.</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-[12px] font-mono border-collapse">
            <thead><tr class="bg-[#f4f4f4] text-[#525252]"><th class="p-2 text-left border border-[#e0e0e0]">Scenario</th><th class="p-2 border border-[#e0e0e0]">VRAM</th><th class="p-2 border border-[#e0e0e0]">Vast.ai</th><th class="p-2 border border-[#e0e0e0]">Spot</th><th class="p-2 border border-[#e0e0e0]">Ventic</th></tr></thead>
            <tbody>
              <tr><td class="p-2 border border-[#e0e0e0]">1×200K NVFP4</td><td class="p-2 border text-center">35G</td><td class="p-2 border">1× RTX PRO 6000 96GB</td><td class="p-2 border text-right">$1.20/h</td><td class="p-2 border text-right font-bold">$0.60</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">1×1M NVFP4</td><td class="p-2 border text-center">96G</td><td class="p-2 border">1× B200 192GB</td><td class="p-2 border text-right">$2.12</td><td class="p-2 border text-right font-bold">$1.06</td></tr>
              <tr><td class="p-2 border">4×200K (800K tot)</td><td class="p-2 border text-center">81G</td><td class="p-2 border">1× RTX PRO 6000 96GB</td><td class="p-2 border text-right">$1.20</td><td class="p-2 border text-right font-bold">$0.60</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">16×200K</td><td class="p-2 border text-center">265G</td><td class="p-2 border">2× B200 384GB</td><td class="p-2 border text-right">$4.24</td><td class="p-2 border text-right font-bold">$2.12</td></tr>
            </tbody>
          </table>
        </div>
        <pre class="mt-3 bg-[#161616] text-[#f4f4f4] p-3 text-[11px] overflow-x-auto">vllm serve QUASAR-QAT/Qwen3.8-27B-QUASAR-NVFP4 --quantization modelopt_fp4 --max-model-len 262144
# SGLang DFlash2 (hanxiao): python -m sglang.launch_server --model-path RadixArk/...-BF16-LMHead --tp-size 1 --quantization modelopt_fp4 --context-length 262144 --speculative-algo DFlash2</pre>
      </section>

      <!-- Qwen Flash Next -->
      <section class="border border-[#e0e0e0] bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-[18px] font-semibold">Qwen3.8-Flash-Next <span class="font-mono text-[11px] text-[#6f6f6f]">125B/6B MoE · 256K→1M</span></h2>
          <span class="bg-[#8a3ffc] text-white px-2 py-1 font-mono text-[11px] uppercase">NVFP4 Blackwell</span>
        </div>
        <p class="mt-2 text-[13px] text-[#525252]"><code>Qwen/Qwen3.8-Flash-Next</code> (proxy 80B/3B qwen3_next) · Pesi NVFP4 65G / FP8 125G · KV 0.12 MiB/tok. Recipe ufficiale vLLM TP4 / SGLang TP4 NEXTN.</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-[12px] font-mono border-collapse">
            <thead><tr class="bg-[#f4f4f4] text-[#525252]"><th class="p-2 text-left border">Scenario</th><th class="p-2 border">VRAM</th><th class="p-2 border">Vast.ai</th><th class="p-2 border">Spot</th><th class="p-2 border">Ventic</th></tr></thead>
            <tbody>
              <tr><td class="p-2 border">1×200K NVFP4</td><td class="p-2 border text-center">92G</td><td class="p-2 border">1× RTX PRO 6000 96GB</td><td class="p-2 border text-right">$1.20</td><td class="p-2 border text-right font-bold">$0.60</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">1×1M NVFP4</td><td class="p-2 border text-center">158G</td><td class="p-2 border">1× B200 192GB</td><td class="p-2 border text-right">$2.12</td><td class="p-2 border text-right font-bold">$1.06</td></tr>
              <tr><td class="p-2 border">4×200K</td><td class="p-2 border text-center">141G</td><td class="p-2 border">1× B200 192GB</td><td class="p-2 border text-right">$2.12</td><td class="p-2 border text-right font-bold">$1.06</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">16×200K</td><td class="p-2 border text-center">338G</td><td class="p-2 border">2× B200 384GB</td><td class="p-2 border text-right">$4.24</td><td class="p-2 border text-right font-bold">$2.12</td></tr>
            </tbody>
          </table>
        </div>
        <pre class="mt-3 bg-[#161616] text-[#f4f4f4] p-3 text-[11px] overflow-x-auto">vllm serve Qwen/Qwen3-Next-80B-A3B-Instruct-FP8 --tensor-parallel-size 4 --max-model-len 262144
python -m sglang.launch_server --model-path Qwen/...-FP8 --tp-size 4 --context-length 262144 --speculative-algo NEXTN --speculative-num-steps 3</pre>
      </section>

      <!-- DeepSeek Flash -->
      <section class="border border-[#e0e0e0] bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-[18px] font-semibold">DeepSeek-V4-Flash — NVFP4 <span class="font-mono text-[11px] text-[#6f6f6f]">284B/13B · 1M · nvidia/NVFP4 156.7G</span></h2>
          <span class="bg-[#007d79] text-white px-2 py-1 font-mono text-[11px] uppercase">NVFP4 (usa sempre)</span>
        </div>
        <p class="mt-2 text-[13px] text-[#525252]"><code>nvidia/DeepSeek-V4-Flash-NVFP4</code> · Pesi NVFP4 156.7G / FP8 284G · KV 0.06 MiB/tok FP8 (ModelOpt v0.44, 46 shards). Sweet spot agentic — sempre NVFP4 su Blackwell.</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-[12px] font-mono border-collapse">
            <thead><tr class="bg-[#f4f4f4]"><th class="p-2 text-left border">Scenario</th><th class="p-2 border">VRAM</th><th class="p-2 border">Vast.ai</th><th class="p-2 border">Spot</th><th class="p-2 border">Ventic</th></tr></thead>
            <tbody>
              <tr><td class="p-2 border">1×200K NVFP4</td><td class="p-2 border text-center">184G</td><td class="p-2 border">1× B200 192GB</td><td class="p-2 border text-right">$2.12</td><td class="p-2 border text-right font-bold">$1.06</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">1×1M NVFP4</td><td class="p-2 border text-center">232G</td><td class="p-2 border">2× B200 384GB*</td><td class="p-2 border text-right">$4.24</td><td class="p-2 border text-right font-bold">$2.12</td></tr>
              <tr><td class="p-2 border">4×200K</td><td class="p-2 border text-center">220G</td><td class="p-2 border">2× B200 384GB</td><td class="p-2 border text-right">$4.24</td><td class="p-2 border text-right font-bold">$2.12</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">16×200K</td><td class="p-2 border text-center">366G</td><td class="p-2 border">2× B200 384GB</td><td class="p-2 border text-right">$4.24</td><td class="p-2 border text-right font-bold">$2.12</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-[11px] text-[#6f6f6f]">* 2× RTX PRO 6000 192GB TP2 (SM120) alternativa. Su Hopper fallback FP8 → 4× H100 320GB ($4.88). NVFP4 156.7G su GB300/B200 (vLLM 0.22.1). <span class="bg-[#fff8e1] border border-[#ffe082] px-1.5 py-0.5">★ <b>AMD MI300X</b> 192GB — 1× $2.99/h (13c/224GB/13TB) · 2× $5.98/h (26c/448GB) — stack validato <a href="https://github.com/ryanzhou/deepseek-v4-flash-mi300x" class="underline text-[#0f62fe]">ryanzhou/mi300x</a> (FNUZ FP8, 384K, 156.67G pesi, 11.69K tok/s prefill)</span></p>
        <div class="mt-3 border border-[#ffe082] bg-[#fff8e1] p-3">
          <div class="font-mono text-[11px] tracking-[0.08em] uppercase text-[#ff6f00]">★ Offerta sponsorizzata — AMD MI300X</div>
          <div class="mt-1.5 grid grid-cols-3 gap-2 font-mono text-[11px] text-[#525252]">
            <span class="bg-white border border-[#ffe082] px-2 py-1"><b>192GB HBM3</b> · 5.3 TB/s · gfx942 · FNUZ FP8</span>
            <span class="bg-white border border-[#ffe082] px-2 py-1">1× VM $2.99/h · 13c Xeon 8470 · 224GB RAM · 13TB</span>
            <span class="bg-white border border-[#ffe082] px-2 py-1">2× VM $5.98/h · 26c · 448GB RAM · 13TB · min 1h/1min</span>
          </div>
        </div>
        <pre class="mt-3 bg-[#161616] text-[#f4f4f4] p-3 text-[11px] overflow-x-auto">vllm serve nvidia/DeepSeek-V4-Flash-NVFP4 --tensor-parallel-size 4 --trust-remote-code --kv-cache-dtype fp8
# SGLang: python3 -m sglang.launch_server --model nvidia/DeepSeek-V4-Flash-NVFP4 --tensor-parallel-size 8 --trust-remote-code</pre>
      </section>

      <!-- DeepSeek Pro -->
      <section class="border border-[#e0e0e0] bg-white p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-[18px] font-semibold">DeepSeek-V4-Pro-0813 <span class="font-mono text-[11px] text-[#6f6f6f]">1.6T/49B · 1M</span></h2>
          <span class="bg-[#ff832b] text-black px-2 py-1 font-mono text-[11px] uppercase">Fleet only</span>
        </div>
        <p class="mt-2 text-[13px] text-[#525252]"><code>deepseek-ai/DeepSeek-V4-Pro</code> · Pesi NVFP4 862G / FP8 1600G · KV 0.08 MiB/tok. 5–10× Flash, solo per heavy code.</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-[12px] font-mono border-collapse">
            <thead><tr class="bg-[#f4f4f4]"><th class="p-2 text-left border">Scenario</th><th class="p-2 border">VRAM</th><th class="p-2 border">Vast.ai fleet</th><th class="p-2 border">Spot</th><th class="p-2 border">Ventic</th></tr></thead>
            <tbody>
              <tr><td class="p-2 border">1×200K NVFP4</td><td class="p-2 border text-center">949G</td><td class="p-2 border">5× B200 960GB (2 nodi)</td><td class="p-2 border text-right">$10.60</td><td class="p-2 border text-right font-bold">$5.30</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">1×1M NVFP4</td><td class="p-2 border text-center">993G</td><td class="p-2 border">6× B200 1152GB (2 nodi)</td><td class="p-2 border text-right">$12.72</td><td class="p-2 border text-right font-bold">$6.36</td></tr>
              <tr><td class="p-2 border">1×1M FP8</td><td class="p-2 border text-center">1688G</td><td class="p-2 border">9× B200 1728GB (3 nodi)</td><td class="p-2 border text-right">$19.08</td><td class="p-2 border text-right font-bold">$9.54</td></tr>
              <tr class="bg-[#f9f9f9]"><td class="p-2 border">16×200K</td><td class="p-2 border text-center">1115G</td><td class="p-2 border">6× B200 1152GB</td><td class="p-2 border text-right">$12.72</td><td class="p-2 border text-right font-bold">$6.36</td></tr>
            </tbody>
          </table>
        </div>
        <pre class="mt-3 bg-[#161616] text-[#f4f4f4] p-3 text-[11px] overflow-x-auto">vllm serve deepseek-ai/DeepSeek-V4-Pro --trust-remote-code --tensor-parallel-size 8 --pipeline-parallel-size 2 --enable-expert-parallel --kv-cache-dtype fp8 --max-model-len 1048576
# → richiede 2-3 host Vast 4×H200/B200 connessi via RoCE</pre>
      </section>
    </div>

    <section class="mt-8 border border-[#e0e0e0] bg-[#f4f4f4] p-6">
      <h3 class="font-mono text-[12px] uppercase tracking-wide text-[#0f62fe]">Quantizzazioni consigliate</h3>
      <div class="mt-3 grid md:grid-cols-4 gap-4 text-[13px]">
        <div><strong>Blackwell (B200/RTX PRO 6000)</strong><br/>NVFP4 nativo → 2× densità pesi, +67% KV con nvfp4 cache. Comando <code>--quantization modelopt_fp4</code>. SGLang solo se lm_head BF16.</div>
        <div><strong>Hopper (H100/H200)</strong><br/>FP8 block128 fine-grained. NVFP4 emulato — sconsigliato. <code>--kv-cache-dtype fp8 --block-size 256</code></div>
        <div><strong>AMD MI300X/MI355X</strong><br/>MXFP4/MXFP8 (rocBLAS). Recipe <code>ryanzhou/deepseek-v4-flash-mi300x</code> — attendere MI355X per 1M stabile.</div>
        <div><strong>Regola Ventic</strong><br/>Per tutti i modelli: auto = NVFP4 su Blackwell, FP8 su Hopper. MXFP4 solo per Flash su Blackwell/AMD.</div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 font-mono text-[11px]">
        <code class="bg-white border border-[#e0e0e0] px-2 py-1">scripts/vast-llm-inventory.py --model all --context 200000,1000000 --concurrency 1,4,16 --quant auto</code>
        <code class="bg-white border border-[#e0e0e0] px-2 py-1">vastai search offers 'gpu_name=B200_SXM num_gpus=1 gpu_ram>=180' -o 'dph+'</code>
      </div>
    </section>

    <p class="mt-6 text-[12px] text-[#6f6f6f]">Prezzi Vast.ai mediana 28/08/2026 (API live: 64 offerte campionate). H100 spot $1.22/h, H200 $1.90, B200 $2.12 — fonte gpu-price-tracker / Spheron. Per 1M agentic, verifica sempre <code>max_model_len</code> + <code>mem_fraction_static=0.80</code> e testa con prompt di 200K+ token prima del deploy.</p>
  </main>
  <Footer client:load lang={lang} />
</Layout>
