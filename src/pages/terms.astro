---
/* Alias: /terms/ -> /termini/ (canonical IT) */
const target = "/termini/";
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <title>Redirect — Termini</title>
    <meta http-equiv="refresh" content="0; url=/termini/" />
    <link rel="canonical" href="https://ventic.it/termini/" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>window.location.replace("/termini/");</script>
  </head>
  <body>
    <p>Reindirizzamento a <a href="/termini/">ventic.it/termini/</a>…</p>
  </body>
</html>
