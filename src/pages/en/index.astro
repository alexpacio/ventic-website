---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Problem from "../../components/Problem.astro";
import Modes from "../../components/Modes.astro";
import How from "../../components/How.astro";
import Capabilities from "../../components/Capabilities.astro";
import Models from "../../components/Models.astro";
import PricingStrip from "../../components/PricingStrip.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { content } from "../../i18n/content";

const lang = "en" as const;
const seo = content[lang].seo.home;
---
<Layout title={seo.title} description={seo.desc} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Problem lang={lang} />
    <Modes lang={lang} />
    <How lang={lang} />
    <Capabilities lang={lang} />
    <Models lang={lang} />
    <PricingStrip lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
