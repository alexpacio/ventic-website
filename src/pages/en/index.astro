---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Facts from "../../components/Facts.astro";
import Explore from "../../components/Explore.astro";
import HomeSteps from "../../components/HomeSteps.astro";
import HomeArch from "../../components/HomeArch.astro";
import HomeCaps from "../../components/HomeCaps.astro";
import Modes from "../../components/Modes.astro";
import PricingStrip from "../../components/PricingStrip.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { content } from "../../i18n/content";
import { serviceJsonLd } from "../../lib/seo";

const lang = "en" as const;
const seo = content[lang].seo.home;
const jsonLd = serviceJsonLd(lang);
---
<Layout title={seo.title} description={seo.desc} lang={lang} jsonLd={jsonLd}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Facts lang={lang} />
    <HomeSteps lang={lang} num="01" />
    <HomeArch lang={lang} num="02" />
    <HomeCaps lang={lang} num="03" />
    <Modes lang={lang} num="04" />
    <Explore lang={lang} num="05" />
    <PricingStrip lang={lang} num="06" />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
