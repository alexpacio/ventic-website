---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.tsx";
import Footer from "../../components/Footer.tsx";
import CostCalculator from "../../components/CostCalculator.tsx";
import { getLangFromUrl } from "../../i18n/utils";
import "../../styles/global.css";
const lang = getLangFromUrl(Astro.url);
---

<Layout title="Cost Calculator — Ventic | Monthly cost per user" description="Calculate monthly cost per user for Qwen3.8-27B, Qwen3.8-Flash-Next, DeepSeek V4 Flash NVFP4 and Pro. Two tiers: 8h×20d (160h) or 24/7 (730h)." lang={lang}>
  <Navbar client:load lang={lang} currentPath={Astro.url.pathname} />
  <main class="mx-auto max-w-[1280px] px-6 lg:px-8 py-8">
    <div class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#0f62fe]">PaaS · Cost Calculator · NVFP4 when possible</div>
    <h1 class="mt-2 text-[30px] lg:text-[38px] font-light tracking-[-0.02em] leading-[1.1]">Cost calculator<br/><span class="font-semibold">monthly cost per user</span></h1>
    <p class="mt-3 max-w-[72ch] text-[14px] leading-[1.7] text-[#525252]">
      Pick model, context per user, concurrent users and time tier. Estimates VRAM (NVFP4 + KV), checks host RAM/CPU/disk/reliability/inet, adds network $/TB and shows <strong>total /month, per user /month and per user /hour</strong>. Highlights best option within budget.
      Two tiers: <span class="bg-[#f4f4f4] border px-1.5 py-0.5 font-mono text-[12px]">8h × 20d = 160h/month</span> (office) and <span class="bg-[#161616] text-white px-1.5 py-0.5 font-mono text-[12px]">24/7 = 730h/month</span> (always-on). All-inclusive PaaS price + network.
    </p>
    <div class="mt-8">
      <CostCalculator client:load lang={lang} />
    </div>
  </main>
  <Footer client:load lang={lang} />
</Layout>
