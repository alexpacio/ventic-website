---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import PageHero from "../../components/PageHero.astro";
import HowLifecycle from "../../components/HowLifecycle.astro";
import HowReconcile from "../../components/HowReconcile.astro";
import HowAgent from "../../components/HowAgent.astro";
import HowSwitchyard from "../../components/HowSwitchyard.astro";
import UnderHood from "../../components/UnderHood.astro";
import Schemes from "../../components/Schemes.astro";
import Cta from "../../components/Cta.astro";
import Footer from "../../components/Footer.astro";
import { pages } from "../../i18n/pages";

const lang = "en" as const;
const seo = pages(lang).how.seo;
---
<Layout title={seo.title} description={seo.desc} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <PageHero lang={lang} page="how" />
    <HowLifecycle lang={lang} num="01" />
    <HowReconcile lang={lang} num="02" />
    <HowAgent lang={lang} num="03" />
    <HowSwitchyard lang={lang} num="04" />
    <UnderHood lang={lang} />
    <Schemes lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
