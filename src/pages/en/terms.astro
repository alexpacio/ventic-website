---
/* Alias: /en/terms/ -> /en/termini/ (canonical EN) */
const target = "/en/termini/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirect — Terms</title>
    <meta http-equiv="refresh" content="0; url=/en/termini/" />
    <link rel="canonical" href="https://ventic.it/en/termini/" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>window.location.replace("/en/termini/");</script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/termini/">ventic.it/en/termini/</a>…</p>
  </body>
</html>
