---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.tsx";
import Footer from "../components/Footer.tsx";
import { ui } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";

const DISCORD_URL = "https://discord.gg/WCRdy2San";
const CONTACT_EMAIL = "info@ventic.it";

const lang = getLangFromUrl(Astro.url);
const t = (key: string, params?: Record<string, string | number>) => {
  const dict = ui[lang] as Record<string, string>;
  const fallback = ui["it"] as Record<string, string>;
  let value = dict[key] ?? fallback[key] ?? key;
  if (params) {
    for (const [k, v] of Object.entries(params)) {
      value = value.replaceAll(`{${k}}`, String(v));
    }
  }
  return value;
};

const homeHref = lang === "it" ? "/" : "/en/";

type VMBase = {
  id: string;
  name: string;
  tier: "Entry" | "Balanced" | "Pro" | "Flagship" | "Cluster";
  gpu: string;
  vram: string;
  count: number;
  cpu: string;
  ram: string;
  storage: string;
  network: string;
  region: string;
  regionFlag: string;
  running: string;
  ventic: string;
  availabilityKey: "available" | "last" | "request" | "preorder";
  availabilityTone: "green" | "amber" | "gray";
  bestFor_it: string;
  bestFor_en: string;
  highlight_it?: string;
  highlight_en?: string;
};

const inventoryBase: VMBase[] = [
  {
    id: "VENTIC-4090-01",
    name: "RTX 4090 · 24GB",
    tier: "Entry",
    gpu: "1× NVIDIA RTX 4090",
    vram: "24GB GDDR6X",
    count: 1,
    cpu: "16 vCPU · AMD EPYC",
    ram: "64GB DDR5",
    storage: "1TB NVMe Gen4",
    network: "1 Gbps · 100TB",
