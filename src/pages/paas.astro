    regionFlag: "🇮🇹",
    running: "€0.68/h",
    ventic: "€0.34/h",
    availabilityKey: "available",
    availabilityTone: "green",
    bestFor_it: "Qwen3 8–32B, Llama 3.1 8B — dev, high-throughput inference",
    bestFor_en: "Qwen3 8–32B, Llama 3.1 8B — dev, high-throughput inference",
  },
  {
    id: "VENTIC-4090x2-01",
    name: "2× RTX 4090 · 48GB",
    tier: "Balanced",
    gpu: "2× RTX 4090",
    vram: "48GB total",
    count: 2,
    cpu: "32 vCPU · AMD EPYC",
    ram: "128GB DDR5",
    storage: "2TB NVMe Gen4",
    network: "10 Gbps · 100TB",
    region: "Milan, IT · EU",
    regionFlag: "🇮🇹",
    running: "€1.28/h",
    ventic: "€0.64/h",
    availabilityKey: "available",
    availabilityTone: "green",
    bestFor_it: "Qwen3 32B, Mistral Large — dual-GPU tensor parallel",
    bestFor_en: "Qwen3 32B, Mistral Large — dual-GPU tensor parallel",
    highlight_it: "Popolare per startup",
    highlight_en: "Popular for startups",
  },
  {
    id: "VENTIC-L40S-01",
    name: "L40S · 48GB",
    tier: "Pro",
    gpu: "1× NVIDIA L40S",
    vram: "48GB GDDR6",
    count: 1,
    cpu: "24 vCPU · Intel Xeon",
    ram: "128GB DDR5",
    storage: "1TB NVMe",
    network: "10 Gbps",
    region: "Frankfurt, DE · EU",
    regionFlag: "🇩🇪",
    running: "€1.05/h",
    ventic: "€0.53/h",
    availabilityKey: "available",
    availabilityTone: "green",
    bestFor_it: "Certified inference, vLLM optimized — 70B Q4, long context",
    bestFor_en: "Certified inference, vLLM optimized — 70B Q4, long context",
  },
  {
    id: "VENTIC-L40Sx2-01",
    name: "2× L40S · 96GB NVLink",
    tier: "Pro",
    gpu: "2× L40S NVLink",
    vram: "96GB total",
    count: 2,
    cpu: "48 vCPU · Intel Xeon",
    ram: "256GB DDR5",
    storage: "2× 1.92TB NVMe",
    network: "25 Gbps",
    region: "Frankfurt, DE · EU",
    regionFlag: "🇩🇪",
    running: "€2.08/h",
    ventic: "€1.04/h",
    availabilityKey: "request",
    availabilityTone: "gray",
    bestFor_it: "70B full precision, RAG pipelines, multi-model",
    bestFor_en: "70B full precision, RAG pipelines, multi-model",
  },
  {
    id: "VENTIC-A100-40",
    name: "A100 40GB SXM4",
    tier: "Pro",
    gpu: "1× A100 SXM4",
    vram: "40GB HBM2",
    count: 1,
    cpu: "24 vCPU · AMD EPYC",
    ram: "192GB DDR4",
    storage: "1.6TB NVMe",
    network: "25 Gbps",
    region: "Paris, FR · EU",
    regionFlag: "🇫🇷",
    running: "€1.49/h",
    ventic: "€0.75/h",
    availabilityKey: "available",
    availabilityTone: "green",
    bestFor_it: "Enterprise legacy, CUDA 12.4, training + inference",
    bestFor_en: "Enterprise legacy, CUDA 12.4, training + inference",
  },
  {
    id: "VENTIC-A100-80",
    name: "A100 80GB SXM4",
    tier: "Pro",
    gpu: "1× A100 SXM4",
    vram: "80GB HBM2e",
    count: 1,
    cpu: "32 vCPU · EPYC",
    ram: "256GB",
    storage: "2TB NVMe",
    network: "50 Gbps",
    region: "US-East · US",
    regionFlag: "🇺🇸",
    running: "€2.05/h",
    ventic: "€1.03/h",
    availabilityKey: "available",
    availabilityTone: "green",
    bestFor_it: "Long context 128k, large batch, prefill-heavy",
    bestFor_en: "Long context 128k, large batch, prefill-heavy",
  },
  {
    id: "VENTIC-H100-80",
    name: "H100 80GB SXM5",
    tier: "Flagship",
    gpu: "1× H100 SXM5",
    vram: "80GB HBM3",
    count: 1,
    cpu: "32 vCPU · Intel Xeon",
    ram: "256GB DDR5",
    storage: "1.92TB NVMe",
    network: "50 Gbps · InfiniBand",
    region: "Milan, IT · EU",
    regionFlag: "🇮🇹",
    running: "€3.15/h",
    ventic: "€1.58/h",
    availabilityKey: "last",
    availabilityTone: "amber",
    bestFor_it: "Flagship — Qwen3 72B, 1,847 tok/s, hardware-tuned vLLM",
    bestFor_en: "Flagship — Qwen3 72B, 1,847 tok/s, hardware-tuned vLLM",
    highlight_it: "1 rimasto",
    highlight_en: "1 left",
  },
  {
    id: "VENTIC-H100x2-01",
    name: "2× H100 · 160GB NVLink",
    tier: "Cluster",
    gpu: "2× H100 NVLink",
    vram: "160GB HBM3",
    count: 2,
    cpu: "64 vCPU · Xeon",
    ram: "512GB DDR5",
    storage: "3.84TB NVMe",
    network: "100 Gbps",
    region: "Milan, IT · EU",
    regionFlag: "🇮🇹",
    running: "€6.10/h",
    ventic: "€3.05/h",
    availabilityKey: "preorder",
    availabilityTone: "gray",
    bestFor_it: "Cluster — 2× H100 per Qwen3 235B, multi-GPU, production",
    bestFor_en: "Cluster — 2× H100 per Qwen3 235B, multi-GPU, production",
    highlight_it: "72h lead",
    highlight_en: "72h lead",
  },
];

const inventory = inventoryBase.map((vm) => ({
  ...vm,
  availability: t(`availability.${vm.availabilityKey}`),
  bestFor: lang === "it" ? vm.bestFor_it : vm.bestFor_en,
  highlight: lang === "it" ? vm.highlight_it : vm.highlight_en,
}));

function getAvailabilityKey(key: VMBase["availabilityKey"]) {
  return t(`availability.${key}`);
}

function mailtoFor(vm: (typeof inventory)[number]) {
  const isIt = lang === "it";
  const subject = `PaaS reservation — ${vm.id} — ${vm.name}`;
  const body = isIt ? `Ciao team Ventic,

Vorrei riservare questa VM PaaS:

• Macchina: ${vm.id} — ${vm.name} — ${vm.gpu} (${vm.vram})
• Regione: ${vm.region}
• Costo indicativo: running ${vm.running} → PaaS ${vm.ventic} + IVA (50% running cost)
• Disponibilità vista: ${vm.availability}

Dati per fattura / bonifico:
• Azienda:
• P.IVA / Codice fiscale:
• Email fatturazione:
• Orario preferito per deploy (orario lavorativo IT):

Confermate disponibilità e inviatemi IBAN per bonifico anticipato immediato (SEPA Instant).
Deploy in 1 ora in orario lavorativo italiano come indicato.

Grazie!` : `Hi Ventic team,

I’d like to reserve this PaaS VM:

• Machine: ${vm.id} — ${vm.name} — ${vm.gpu} (${vm.vram})
• Region: ${vm.region}
• Indicative cost: running ${vm.running} → PaaS ${vm.ventic} + VAT (50% running cost)
• Availability seen: ${vm.availability}

Billing / wire details:
• Company:
• VAT ID / Tax code:
• Billing email:
• Preferred deploy time (IT business hours):

Please confirm availability and send IBAN for immediate upfront wire (SEPA Instant).
Deploy in 1 hour during Italian business hours as indicated.

Thanks!`;
  return `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

const generalMailto = (() => {
  const isIt = lang === "it";
  const subject = isIt ? "PaaS inquiry — inventario" : "PaaS inquiry — inventory";
  const body = isIt ? `Ciao team Ventic,

Sono interessato al vostro inventario PaaS. Mi consigliate la macchina migliore per:

• Modello: 
• Traffico atteso (tok/s / req/s): 
• Regione preferita (EU/US): 
• Budget orario: 

Confermate tempi di deploy (1h orario IT) e coordinate per bonifico immediato.

Grazie!` : `Hi Ventic team,

I’m interested in your PaaS inventory. Can you recommend the best machine for:

• Model: 
• Expected traffic (tok/s / req/s): 
• Preferred region (EU/US): 
• Hourly budget: 

Please confirm deploy times (1h IT hours) and wire details.

Thanks!`;
  return `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
})();
---

<Layout title={t("paas.meta.title")} description={t("paas.meta.desc")} lang={lang}>
  <Navbar client:load lang={lang} currentPath={Astro.url.pathname} />
  <main>
    <!-- Hero -->
    <section class="border-b border-[#e0e0e0] bg-white">
      <div class="mx-auto max-w-[1584px] px-6 lg:px-8">
        <div class="py-8 lg:py-10">
          <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-wide uppercase">
            <a href={homeHref} class="text-[#6f6f6f] hover:text-[#161616] underline underline-offset-4">{t("paas.breadcrumb.home")}</a>
            <span class="text-[#c6c6c6]">/</span>
            <span class="text-[#525252]">{t("paas.breadcrumb.paas")}</span>
            <span class="bg-[#0f62fe] text-white px-2 py-1 text-[10px] tracking-[0.08em]">{t("paas.badge.live")}</span>
            <span class="bg-[#f4f4f4] border border-[#e0e0e0] px-2 py-1 text-[#525252]">{t("paas.badge.updated")}</span>
          </div>

          <div class="mt-6 grid lg:grid-cols-[1.25fr_0.75fr] gap-8 items-start">
            <div>
              <div class="flex items-center gap-3">
                <span class="h-px w-8 bg-[#0f62fe]"></span>
                <span class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#525252]">{t("paas.hero.eyebrow")}</span>
              </div>
              <h1 class="mt-4 text-[30px] sm:text-[40px] lg:text-[48px] font-light leading-[0.95] tracking-[-0.03em] text-[#161616]">
                {t("paas.hero.title1")}<br />
                <span class="font-semibold">{t("paas.hero.title2")}</span> {t("paas.hero.title3")}
              </h1>
              <p class="mt-4 max-w-[68ch] text-[16px] lg:text-[18px] leading-[1.5] text-[#525252] font-light" set:html={t("paas.hero.desc")} />

              <div class="mt-6 flex flex-wrap gap-3">
                <a href={generalMailto} class="inline-flex items-center gap-2 bg-[#0f62fe] text-white px-6 py-3 text-[14px] font-medium hover:bg-[#0353e9] transition-colors">
                  {t("paas.hero.cta.reserve")} {CONTACT_EMAIL}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.2"/></svg>
                </a>
                <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-[#8d8d8d] px-6 py-3 text-[14px] font-medium hover:bg-[#f4f4f4] transition-colors bg-white">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.6 7.2a17 17 0 0 0-4.2-1.3 12.6 12.6 0 0 0-.6 1.2 15.6 15.6 0 0 0-4.6 0 9 9 0 0 0-.6-1.2A17 17 0 0 0 6.4 7.2S5.1 9.1 4.7 11c0 0 2.4 1.8 4.8 1.8 0 0 .4-.5.7-.9-1.5-.4-2.1-1.1-2.1-1.1l.4-.3s.3.2.8.5c1.5.7 3.8.7 5.3 0 .5-.3.8-.5.8-.5l.4.3s-.6.7-2.1 1.1c.3.4.7.9.7.9 2.4 0 4.8-1.8 4.8-1.8-.4-1.9-1.7-3.8-1.7-3.8Z" fill="#5865F2"/><path d="M9.2 14.4c-.7 0-1.2-.6-1.2-1.4 0-.8.5-1.4 1.2-1.4.7 0 1.3.6 1.2 1.4 0 .8-.5 1.4-1.2 1.4Zm5.6 0c-.7 0-1.2-.6-1.2-1.4 0-.8.5-1.4 1.2-1.4.7 0 1.2.6 1.2 1.4 0 .8-.5 1.4-1.2 1.4Z" fill="#5865F2"/></svg>
                  {t("paas.hero.cta.discord")}
                </a>
              </div>

              <div class="mt-6 grid grid-cols-3 gap-3 max-w-[560px] font-mono text-[11px]">
                <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-3 py-3">
                  <div class="text-[#6f6f6f] uppercase tracking-wide">{t("paas.hero.cards.deployment.label")}</div>
                  <div class="mt-1 text-[13px] font-medium text-[#161616] leading-tight">{t("paas.hero.cards.deployment.value")}</div>
                  <div class="text-[#525252] leading-tight">{t("paas.hero.cards.deployment.desc")}</div>
                </div>
                <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-3 py-3">
                  <div class="text-[#6f6f6f] uppercase tracking-wide">{t("paas.hero.cards.payment.label")}</div>
                  <div class="mt-1 text-[13px] font-medium text-[#161616] leading-tight">{t("paas.hero.cards.payment.value")}</div>
                  <div class="text-[#525252] leading-tight">{t("paas.hero.cards.payment.desc")}</div>
                </div>
                <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-3 py-3">
                  <div class="text-[#6f6f6f] uppercase tracking-wide">{t("paas.hero.cards.invoice.label")}</div>
                  <div class="mt-1 text-[13px] font-medium text-[#161616] leading-tight">{t("paas.hero.cards.invoice.value")}</div>
                  <div class="text-[#525252] leading-tight">{t("paas.hero.cards.invoice.desc")}</div>
                </div>
              </div>
            </div>

            <!-- Side card: come funziona + orari -->
            <div class="border border-[#e0e0e0] bg-[#161616] text-white overflow-hidden">
              <div class="px-6 py-4 border-b border-[#393939] bg-[#262626] flex items-center justify-between">
                <span class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#a8a8a8]">{t("paas.side.howTitle")}</span>
                <span class="font-mono text-[11px] text-[#6f6f6f]">{t("paas.side.howSubtitle")}</span>
              </div>
              <div class="p-6 space-y-5">
                <ol class="space-y-4">
                  <li class="flex gap-3">
                    <span class="shrink-0 h-7 w-7 rounded-full bg-[#0f62fe] grid place-items-center text-[12px] font-medium">1</span>
                    <div>
                      <div class="text-[14px] font-medium leading-tight">{t("paas.side.step1.title")}</div>
                      <div class="text-[13px] leading-[1.5] text-[#a8a8a8]" set:html={t("paas.side.step1.desc").replace("{email}", CONTACT_EMAIL)} />
                    </div>
                  </li>
                  <li class="flex gap-3">
                    <span class="shrink-0 h-7 w-7 rounded-full bg-[#393939] border border-[#525252] grid place-items-center text-[12px] font-medium">2</span>
                    <div>
                      <div class="text-[14px] font-medium leading-tight">{t("paas.side.step2.title")}</div>
                      <div class="text-[13px] leading-[1.5] text-[#a8a8a8]">{t("paas.side.step2.desc")}</div>
                    </div>
                  </li>
                  <li class="flex gap-3">
                    <span class="shrink-0 h-7 w-7 rounded-full bg-[#393939] border border-[#525252] grid place-items-center text-[12px] font-medium">3</span>
                    <div>
                      <div class="text-[14px] font-medium leading-tight">{t("paas.side.step3.title")}</div>
                      <div class="text-[13px] leading-[1.5] text-[#a8a8a8]">{t("paas.side.step3.desc")}</div>
                    </div>
                  </li>
                  <li class="flex gap-3">
                    <span class="shrink-0 h-7 w-7 rounded-full bg-[#42be65] text-[#0b3d1a] grid place-items-center text-[12px] font-bold">4</span>
                    <div>
                      <div class="text-[14px] font-medium leading-tight">{t("paas.side.step4.title")}</div>
                      <div class="text-[13px] leading-[1.5] text-[#a8a8a8]" set:html={t("paas.side.step4.desc")} />
                    </div>
                  </li>
                </ol>

                <div class="border border-[#393939] bg-[#262626] p-3 font-mono text-[11px] leading-[1.6] text-[#c6c6c6]">
                  <div class="text-[#8d8d8d] uppercase tracking-wide text-[10px]">{t("paas.side.help.title")}</div>
                  <div class="mt-1">{t("paas.side.help.desc")}</div>
                  <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 bg-[#5865F2] text-white px-3 py-2 text-[12px] font-medium hover:bg-[#4752c4] transition-colors w-full justify-center">
                    {t("paas.side.help.cta")}
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.2"/></svg>
                  </a>
                </div>

                <div class="font-mono text-[11px] leading-[1.6] text-[#6f6f6f]">
                  {t("paas.side.note")}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Inventory -->
    <section class="border-b border-[#e0e0e0] bg-[#f4f4f4]">
      <div class="mx-auto max-w-[1584px] px-6 lg:px-8 py-10 lg:py-12">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-[22px] lg:text-[28px] font-light tracking-[-0.02em]">{t("paas.inventory.title")} <span class="font-semibold">{t("paas.inventory.configs", { count: inventory.length })}</span></h2>
            <p class="mt-2 font-mono text-[12px] leading-[1.6] text-[#525252] max-w-[75ch]">{t("paas.inventory.desc")}</p>
          </div>
          <div class="flex items-center gap-2 font-mono text-[11px]">
            <span class="hidden sm:inline-flex items-center gap-1.5 border border-[#e0e0e0] bg-white px-2.5 py-1.5 text-[#525252]"><span class="h-2 w-2 rounded-full bg-[#42be65]"></span> {t("paas.inventory.legend.available")}</span>
            <span class="hidden sm:inline-flex items-center gap-1.5 border border-[#e0e0e0] bg-white px-2.5 py-1.5 text-[#525252]"><span class="h-2 w-2 rounded-full bg-[#ff832b]"></span> {t("paas.inventory.legend.last")}</span>
            <span class="inline-flex items-center gap-1.5 border border-[#e0e0e0] bg-white px-2.5 py-1.5 text-[#525252]"><span class="h-2 w-2 rounded-full bg-[#8d8d8d]"></span> {t("paas.inventory.legend.request")}</span>
          </div>
        </div>

        <div class="mt-8 grid md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4 lg:gap-5">
          {inventory.map((vm) => (
            <div class="group flex flex-col border border-[#e0e0e0] bg-white hover:border-[#0f62fe] hover:shadow-[0_8px_30px_rgba(15,98,254,0.08)] transition-all overflow-hidden">
              <!-- card head -->
              <div class="px-4 py-3 border-b border-[#e0e0e0] bg-[#f4f4f4] flex items-center justify-between gap-2">
                <div class="min-w-0">
                  <div class="font-mono text-[10px] tracking-[0.08em] uppercase text-[#6f6f6f] flex items-center gap-1.5">
                    <span class="truncate">{vm.id}</span>
                    <span class="h-1 w-1 rounded-full bg-[#c6c6c6] shrink-0"></span>
                    <span class="shrink-0">{vm.tier}</span>
                  </div>
                  <div class="text-[15px] font-semibold tracking-[-0.015em] leading-tight truncate">{vm.name}</div>
                </div>
                <span class={
                  vm.availabilityTone === "green" ? "shrink-0 inline-flex items-center gap-1.5 border bg-[#defbe6] border-[#a7f0ba] text-[#0e6027] px-2 py-1 font-mono text-[10px] tracking-wide uppercase font-medium" :
                  vm.availabilityTone === "amber" ? "shrink-0 inline-flex items-center gap-1.5 border bg-[#fff8e1] border-[#f1c21b] text-[#8a6d00] px-2 py-1 font-mono text-[10px] tracking-wide uppercase font-medium" :
                  "shrink-0 inline-flex items-center gap-1.5 border bg-white border-[#e0e0e0] text-[#525252] px-2 py-1 font-mono text-[10px] tracking-wide uppercase"
                }>
                  <span class={
                    vm.availabilityTone === "green" ? "h-1.5 w-1.5 rounded-full bg-[#42be65]" :
                    vm.availabilityTone === "amber" ? "h-1.5 w-1.5 rounded-full bg-[#f1c21b] animate-pulse" :
                    "h-1.5 w-1.5 rounded-full bg-[#8d8d8d]"
                  }></span>
                  {vm.availability}
                </span>
              </div>

              {vm.highlight && (
                <div class="px-4 py-1.5 bg-[#0f62fe] text-white font-mono text-[11px] tracking-wide flex items-center gap-1.5">
                  <span>★</span> {vm.highlight}
                </div>
              )}

              <div class="p-4 flex-1 flex flex-col">
                <div>
                  <div class="text-[13px] font-medium">{vm.gpu}</div>
                  <div class="font-mono text-[11px] text-[#6f6f6f]">{vm.vram} · {vm.count}× GPU</div>
                </div>

                <div class="mt-3 grid grid-cols-2 gap-2 font-mono text-[11px] leading-[1.5]">
                  <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-2.5 py-2">
                    <div class="text-[#6f6f6f] uppercase text-[10px] tracking-wide">{t("paas.inventory.card.cpu")}</div>
                    <div class="font-medium text-[#161616] leading-tight">{vm.cpu}</div>
                  </div>
                  <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-2.5 py-2">
                    <div class="text-[#6f6f6f] uppercase text-[10px] tracking-wide">{t("paas.inventory.card.ram")}</div>
                    <div class="font-medium text-[#161616] leading-tight">{vm.ram}</div>
                  </div>
                  <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-2.5 py-2">
                    <div class="text-[#6f6f6f] uppercase text-[10px] tracking-wide">{t("paas.inventory.card.storage")}</div>
                    <div class="font-medium text-[#161616] leading-tight">{vm.storage}</div>
                  </div>
                  <div class="border border-[#e0e0e0] bg-[#f4f4f4] px-2.5 py-2">
                    <div class="text-[#6f6f6f] uppercase text-[10px] tracking-wide">{t("paas.inventory.card.network")}</div>
                    <div class="font-medium text-[#161616] leading-tight">{vm.network}</div>
                  </div>
                </div>

                <div class="mt-3 flex items-center gap-2 font-mono text-[11px]">
                  <span class="border border-[#e0e0e0] bg-white px-2 py-1 text-[#525252] inline-flex items-center gap-1.5"><span>{vm.regionFlag}</span> {vm.region}</span>
                  <span class="text-[#6f6f6f] hidden sm:inline">{t("paas.inventory.card.gdpr")}</span>
                </div>

                <div class="mt-3 border border-[#e0e0e0] p-3 bg-[#f9f9f9]">
                  <div class="flex items-baseline justify-between gap-2">
                    <div>
                      <div class="font-mono text-[10px] tracking-wide uppercase text-[#6f6f6f]">{t("paas.inventory.card.running")}</div>
                      <div class="text-[13px] font-medium text-[#525252] line-through decoration-[#8d8d8d]">{vm.running} {lang === "it" ? "+ IVA" : "+ VAT"}</div>
                    </div>
                    <div class="text-right">
                      <div class="font-mono text-[10px] tracking-wide uppercase text-[#0f62fe]">{t("paas.inventory.card.paasPrice")}</div>
                      <div class="text-[20px] font-light tracking-[-0.02em] leading-none text-[#0f62fe]">{vm.ventic} <span class="text-[11px] font-normal text-[#525252]">{t("paas.inventory.card.perHour")}</span></div>
                    </div>
                  </div>
                  <div class="mt-1 font-mono text-[10px] leading-[1.5] text-[#6f6f6f]">{t("paas.inventory.card.feeDesc")}</div>
                </div>

                <div class="mt-3">
                  <div class="font-mono text-[10px] tracking-wide uppercase text-[#6f6f6f]">{t("paas.inventory.card.bestfor")}</div>
                  <div class="mt-1 text-[12px] leading-[1.5] text-[#525252]">{vm.bestFor}</div>
                </div>

                <div class="mt-4 space-y-2">
                  <a href={mailtoFor(vm)} class="w-full inline-flex justify-center items-center gap-2 bg-[#0f62fe] text-white py-2.5 text-[13px] font-medium hover:bg-[#0353e9] transition-colors">
                    {t("paas.inventory.card.reserve")}
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.2"/></svg>
                  </a>
                  <div class="grid grid-cols-2 gap-2">
                    <a href={generalMailto} class="inline-flex justify-center items-center gap-1.5 border border-[#8d8d8d] bg-white py-2 text-[12px] font-medium hover:bg-[#f4f4f4] transition-colors">
                      {t("paas.inventory.card.info")}
                    </a>
                    <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-1.5 border border-[#e0e0e0] bg-[#f4f4f4] py-2 text-[12px] font-medium hover:bg-white transition-colors">
                      {t("paas.inventory.card.discord")}
                    </a>
                  </div>
                  <div class="font-mono text-[10px] leading-[1.4] text-[#8d8d8d] text-center">{t("paas.inventory.card.iban")}</div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 border border-[#e0e0e0] bg-white p-4 flex flex-wrap gap-3 justify-between items-center">
          <div class="font-mono text-[12px] leading-[1.5] text-[#525252]">{t("paas.inventory.notfound")}</div>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="shrink-0 inline-flex items-center gap-2 bg-[#161616] text-white px-4 py-2 font-mono text-[12px] tracking-wide uppercase hover:bg-[#262626] transition-colors">
            {t("paas.inventory.join")}
          </a>
        </div>
      </div>
    </section>

    <!-- Terms / FAQ -->
    <section class="border-b border-[#e0e0e0] bg-white">
      <div class="mx-auto max-w-[1584px] px-6 lg:px-8 py-10 lg:py-12">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-8 lg:gap-10">
          <div>
            <div class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#0f62fe]">{t("paas.terms.eyebrow")}</div>
            <h2 class="mt-2 text-[24px] lg:text-[30px] font-light leading-[1.05] tracking-[-0.02em]" set:html={t("paas.terms.title")} />
            <p class="mt-3 text-[14px] leading-[1.6] text-[#525252]">{t("paas.terms.desc")}</p>

            <div class="mt-6 space-y-3 font-mono text-[12px] leading-[1.6]">
              <div class="border-l-2 border-[#0f62fe] bg-[#f4f4f4] pl-4 py-3">
                <div class="font-medium text-[#161616] uppercase tracking-wide text-[11px]">{t("paas.terms.payment.title")}</div>
                <div class="mt-1 text-[#525252]" set:html={t("paas.terms.payment.desc")} />
              </div>
              <div class="border-l-2 border-[#42be65] bg-[#f4f4f4] pl-4 py-3">
                <div class="font-medium text-[#161616] uppercase tracking-wide text-[11px]">{t("paas.terms.deploy.title")}</div>
                <div class="mt-1 text-[#525252]" set:html={t("paas.terms.deploy.desc")} />
              </div>
              <div class="border-l-2 border-[#8d8d8d] bg-[#f4f4f4] pl-4 py-3">
                <div class="font-medium text-[#161616] uppercase tracking-wide text-[11px]">{t("paas.terms.includes.title")}</div>
                <div class="mt-1 text-[#525252]">{t("paas.terms.includes.desc")}</div>
              </div>
            </div>
          </div>

          <div class="border border-[#e0e0e0] bg-[#f4f4f4] p-6 lg:p-7">
            <div class="font-mono text-[12px] tracking-[0.08em] uppercase text-[#525252]">{t("paas.faq.title")}</div>
            <dl class="mt-4 space-y-5">
              <div>
                <dt class="text-[14px] font-semibold">{t("paas.faq.q1")}</dt>
                <dd class="mt-1 text-[13px] leading-[1.6] text-[#525252]">{t("paas.faq.a1")}</dd>
              </div>
              <div>
                <dt class="text-[14px] font-semibold">{t("paas.faq.q2")}</dt>
                <dd class="mt-1 text-[13px] leading-[1.6] text-[#525252]">{t("paas.faq.a2")}</dd>
              </div>
              <div>
                <dt class="text-[14px] font-semibold">{t("paas.faq.q3")}</dt>
                <dd class="mt-1 text-[13px] leading-[1.6] text-[#525252]">{t("paas.faq.a3")}</dd>
              </div>
              <div>
                <dt class="text-[14px] font-semibold">{t("paas.faq.q4")}</dt>
                <dd class="mt-1 text-[13px] leading-[1.6] text-[#525252]" set:html={t("paas.faq.a4").replace("{email}", `<a href="mailto:${CONTACT_EMAIL}" class="text-[#0f62fe] underline underline-offset-4">${CONTACT_EMAIL}</a>`)} />
              </div>
              <div>
                <dt class="text-[14px] font-semibold">{t("paas.faq.q5")}</dt>
                <dd class="mt-1 text-[13px] leading-[1.6] text-[#525252]">{t("paas.faq.a5")}</dd>
              </div>
            </dl>

            <div class="mt-6 border border-[#e0e0e0] bg-white p-4 flex flex-col sm:flex-row gap-3">
              <a href={generalMailto} class="flex-1 inline-flex justify-center items-center gap-2 bg-[#0f62fe] text-white py-3 text-[14px] font-medium hover:bg-[#0353e9] transition-colors">
                {t("paas.faq.cta.email", { email: CONTACT_EMAIL })}
              </a>
              <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex justify-center items-center gap-2 border border-[#8d8d8d] bg-white py-3 text-[14px] font-medium hover:bg-[#f4f4f4] transition-colors">
                {t("paas.faq.cta.discord")}
              </a>
            </div>
            <p class="mt-3 font-mono text-[11px] leading-[1.5] text-[#6f6f6f] text-center">{t("paas.faq.updated")}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:load lang={lang} />
</Layout>
