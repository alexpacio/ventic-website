---
import Layout from "../layouts/Layout.astro";
const title = "Pagina non trovata — Ventic";
const description = "La pagina che cerchi non esiste. Torna alla home di Ventic — piattaforma AI multi-tenant on premise.";
---
<Layout title={title} description={description} noindex={true} noLocaleRedirect={true}>
  <main id="main" class="nf lattice">
    <div class="wrap nf-in">
      <span class="plate"><span class="dot"></span>Errore 404 · Not found</span>
      <h1 class="h1">Pagina non trovata.</h1>
      <p class="lead">{description}</p>
      <div class="nf-actions">
        <a href="/" class="btn btn--a">Torna alla home <span class="arr" aria-hidden="true">→</span></a>
        <a href="/pricing/" class="btn btn--ghost">Vedi i prezzi <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf { min-height: 70vh; display: flex; align-items: center; padding: 96px 0; }
  .nf-in { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .lead { max-width: 52ch; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 2px; }
</style>
