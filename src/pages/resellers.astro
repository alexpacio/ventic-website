---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/PageHero.astro";
import Resellers from "../components/Resellers.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { pages } from "../i18n/pages";

const lang = "it" as const;
const seo = pages(lang).resellers.seo;
---
<Layout title={seo.title} description={seo.desc} lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <PageHero lang={lang} page="resellers" />
    <Resellers lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
